@import MainLayout from "./MainLayout.tsazor"
@* AuthorizeRouteView mirrors the workshop's App.razor: @authorize pages
   render only for signed-in users, everything else is public. *@
<Router>
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@MainLayout">
            <NotAuthorized>
                <div class="main not-authorized">
                    <h2>Hold on there, buddy</h2>
                    <p>You need to log in to see this page. </p>
                    <a href="login">Go to login</a>
                </div>
            </NotAuthorized>
        </AuthorizeRouteView>
    </Found>
</Router>
