@inject AuthProvider Auth

<div class="user-info">
    <AuthorizeView>
        <Authorized>
            <img src="img/user.svg" />
            <div>
                <a href="myorders" class="username">@(context.user.name || "My orders")</a>
                <button class="btn btn-link sign-out" @onclick="signOut">Sign out</button>
            </div>
        </Authorized>
        <NotAuthorized>
            <a class="sign-in" href="register">Register</a>
            <a class="sign-in" href="login">Log in</a>
        </NotAuthorized>
    </AuthorizeView>
</div>

@code {
    private signOut(): void {
        void this.Auth.logout();
    }
}
