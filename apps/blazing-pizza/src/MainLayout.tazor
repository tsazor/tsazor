@inherits LayoutComponentBase

<div class="top-bar">
    <a class="logo" href="/">
        <img src="img/logo.svg" />
    </a>

    <NavLink Href="/" Match="@NavLinkMatch.All" CssClass="nav-tab">
        <img src="img/pizza-slice.svg" />
        <div>Get Pizza</div>
    </NavLink>

    <AuthorizeView ChildContent="@myOrdersTab" />

    <LoginDisplay />
</div>

<div class="content">
    @Body
</div>

@code {
    private myOrdersTab: RenderFragment = (b: RenderTreeBuilder) => {
        b.openComponent(0, NavLink);
        b.addAttribute(1, "Href", "/myorders");
        b.addAttribute(2, "CssClass", "nav-tab");
        b.addContent(3, (inner) => {
            inner.openElement(0, "img");
            inner.addAttribute(1, "src", "img/bike.svg");
            inner.closeElement();
            inner.openElement(2, "div");
            inner.addContent(3, "My Orders");
            inner.closeElement();
        });
        b.closeComponent();
    };
}