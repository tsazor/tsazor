@inherits LayoutComponentBase

<div class="top-bar">
    <a class="logo" href="/">
        <img src="img/logo.svg" />
    </a>

    <NavLink Href="/" Match="@NavLinkMatch.All" class="nav-tab">
        <img src="img/pizza-slice.svg" />
        <div>Get Pizza</div>
    </NavLink>

    <AuthorizeView>
        <NavLink Href="/myorders" class="nav-tab">
            <img src="img/bike.svg" />
            <div>My Orders</div>
        </NavLink>
    </AuthorizeView>

    <LoginDisplay />
</div>

<div class="content">
    @Body
</div>
