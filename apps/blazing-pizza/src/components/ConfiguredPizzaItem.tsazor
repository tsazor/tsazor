<div class="cart-item">
    <a @onclick="removeItem" class="delete-item">x</a>
    <div class="title">@(this.pizza.size)" @this.pizza.special.name</div>
    <ul>
        @foreach (var pt in this.pizza.toppings) {
            <li>+ @pt.topping.name</li>
        }
    </ul>
    <div class="item-price">
        @pizzaFormattedTotalPrice(this.pizza)
    </div>
</div>

@code {
    @Parameter() pizza!: Pizza;
    @Parameter() onRemoved?: EventCallback;

    private removeItem(): void {
        void this.onRemoved?.invokeAsync(null);
    }
}