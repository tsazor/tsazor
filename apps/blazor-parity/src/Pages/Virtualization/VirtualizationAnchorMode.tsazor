@page "/virtualization/anchor-mode"
@import type { DynamicItem } from "./models"

<h1>Virtualization Anchor Mode</h1>

<div style="margin-bottom: 10px;">
    <label>Anchor Mode:
        <select id="anchor-mode-select" @onchange="onAnchorModeChanged">
            <option value="0" selected="@(anchorMode === VirtualizeAnchorMode.None)">None</option>
            <option value="1" selected="@(anchorMode === VirtualizeAnchorMode.Start)">Start</option>
            <option value="2" selected="@(anchorMode === VirtualizeAnchorMode.End)">End</option>
        </select>
    </label>
</div>

<div id="scroll-container" style="height: 300px; overflow-y: auto; border: 1px solid black;">
    @if (listLoaded)
    {
        @if (useItemsProvider)
        {
            <Virtualize @ref="virtualizeRef" ItemsProvider="@getItems" ItemSize="@itemSize" OverscanCount="@overscanCount" MaxItemCount="@maxItemCount" AnchorMode="@anchorMode" @attributes="comparerSplat" InitialItemIndex="@loadedInitialItemIndex" Context="item">
                <ItemContent>
                    <div class="item"
                         data-index="@item.index"
                         data-anchor-mode="@anchorMode"
                         style="border: 1px solid gray; padding: 5px; min-height: @(item.height)px;">
                        <div>Item @item.index</div>
                    </div>
                </ItemContent>
                <Placeholder>
                    <div class="loading-placeholder"
                         style="border: 1px dashed orange; padding: 5px; min-height: 50px; background: #fff8e6;">
                        <span>Loading...</span>
                    </div>
                </Placeholder>
            </Virtualize>
        }
        else
        {
            <Virtualize @ref="virtualizeRef" Items="@items" ItemSize="@itemSize" OverscanCount="@overscanCount" MaxItemCount="@maxItemCount" AnchorMode="@anchorMode" InitialItemIndex="@loadedInitialItemIndex" Context="item">
                <div class="item"
                     data-index="@item.index"
                     data-anchor-mode="@anchorMode"
                     style="border: 1px solid gray; padding: 5px; min-height: @(item.height)px;">
                    <div>Item @item.index</div>
                </div>
            </Virtualize>
        }
    }
    else
    {
        <p id="list-not-loaded" style="padding: 10px; color: #666;">List not loaded. Set an Initial Index below and click "Load list".</p>
    }
</div>

<div style="margin-top: 6px;">
    <label>Initial Index:
        <input id="manual-initial-index" type="number" @bind="manualInitialIndex" style="width: 80px;" />
    </label>
    <button id="reload-with-initial-index" @onclick="reloadWithInitialIndex">Load list with Initial Index</button>
    <button id="unload-list" @onclick="unloadList">Unload list</button>
    <span id="manual-initial-index-bound" data-value="@manualInitialIndex" style="margin-left: 8px; color:#888;">bound:@manualInitialIndex</span>
</div>

<div style="margin-top: 6px;">
    <input id="scroll-target-index" type="number" @bind="scrollTargetIndex" style="width: 80px;" />
    <span id="scroll-target-index-bound" data-value="@scrollTargetIndex" style="margin-left: 8px; color:#888;">bound:@scrollTargetIndex</span>
    <button id="scroll-to-item" @onclick="scrollToTarget">Scroll To Item</button>
    <button id="scroll-to-item-rapid" @onclick="scrollRapid">Scroll Rapid (final=250)</button>
    <button id="scroll-to-item-cancellable" @onclick="scrollCancellable">Scroll Cancellable</button>
    <button id="cancel-scroll" @onclick="cancelScroll">Cancel Scroll</button>
</div>

<p id="scroll-status" style="margin: 0; font-size: 12px;">@scrollStatus</p>

<div style="margin-top: 10px;">
    <button id="prepend-items" @onclick="prependItems">Prepend 10 Items</button>
    <button id="prepend-many-items" @onclick="prependManyItems">Prepend 100 Items</button>
    <button id="append-items" @onclick="appendItems">Append 10 Items</button>
    <button id="append-one-item" @onclick="appendOneItem">Append 1 Item</button>
    <button id="append-many-items" @onclick="appendManyItems">Append 100 Items</button>
    <button id="delete-above" @onclick="deleteAbove">Delete 10 Above</button>
    <button id="delete-below" @onclick="deleteBelow">Delete 10 Below</button>
    <button id="expand-item" @onclick="expandVisibleItem">Expand Item 3 to 400px</button>
    <button id="set-small-count" @onclick="setSmallCount">Set 5 Items</button>
    <button id="set-console-scenario" @onclick="setConsoleScenario">Console scenario (40 items, overscan 100)</button>
    <button id="set-low-max-item-count" @onclick="setLowMaxItemCount">MaxItemCount 20, overscan 3</button>
    <button id="set-double-size" @onclick="setDoubleSize">Item size 100</button>
    <button id="set-average-height-trap" @onclick="setAverageHeightTrap">Tall rows before index 100</button>
    <button id="toggle-provider" @onclick="toggleProvider">
        Source: @(useItemsProvider ? "ItemsProvider" : "Items")
    </button>
    <button id="toggle-comparer" @onclick="toggleComparer">
        Comparer: @(omitItemComparer ? "Default (none)" : "Custom")
    </button>
    <button id="toggle-height" @onclick="toggleVariableHeight">
        Heights: @(useVariableHeight ? "Variable (10-200px)" : "Fixed (50px)")
    </button>
    <button id="toggle-delay" @onclick="toggleDelay">
        Provider Delay: @(useProviderDelay ? "500ms" : "None")
    </button>
    <button id="toggle-provider-gate" @onclick="toggleProviderGate">
        Gate: @(useProviderGate ? "On" : "Off")
    </button>
    <button id="release-provider-gate" @onclick="releaseProviderGate">Release gate</button>
</div>

<p id="status">@statusMessage</p>
<p id="current-mode">@anchorMode</p>
<p id="provider-call-index" data-value="@providerCallIndex">@providerCallIndex</p>
<p id="provider-events" data-value="@(providerEvents.join('|'))">@(providerEvents.join('|'))</p>

@code {
    private items: DynamicItem[] = [];
    private statusMessage = "Ready";
    private anchorMode = VirtualizeAnchorMode.Start;
    private useVariableHeight = false;
    private useAverageHeightTrap = false;
    private useItemsProvider = false;
    private omitItemComparer = false;
    private itemSize = 50;
    private overscanCount = 15;
    private maxItemCount = 100;
    private useProviderDelay = false;
    private useProviderGate = false;
    private providerGate: Deferred = deferred();
    private providerCallIndex = 0;
    private providerEvents: string[] = [];
    private virtualizeRef?: Virtualize<DynamicItem>;
    private manualInitialIndex = 0;
    /** The InitialItemIndex the list was (re)loaded with (Blazor's private `initialItemIndex`). */
    private loadedInitialItemIndex = 0;
    private listLoaded = true;
    private scrollTargetIndex = 200;
    private scrollStatus = "Idle";
    private userScrollController?: AbortController;
    private static readonly itemComparer = (a: DynamicItem, b: DynamicItem): boolean => a.index === b.index;

    @Parameter() initialItemIndex = 0;

    private static readonly emptyComparerSplat: Readonly<Record<string, unknown>> = {};

    /**
     * The Virtualize's ItemComparer, or none: with an empty splat the parameter is not passed at all, so the
     * Virtualize keeps its default comparer (passing `undefined` would replace the default).
     */
    private get comparerSplat(): Readonly<Record<string, unknown>> {
        return this.omitItemComparer
            ? VirtualizationAnchorMode.emptyComparerSplat
            : { ItemComparer: VirtualizationAnchorMode.itemComparer };
    }

    // Pending mutations applied inside the provider (simulates DB-backed data).
    private pendingPrepend: DynamicItem[] | null = null;
    private pendingAppend: DynamicItem[] | null = null;
    private pendingDeleteFromTop = 0;
    private pendingDeleteFromBottom = 0;

    protected override onInitialized(): void {
        this.loadedInitialItemIndex = this.initialItemIndex;
        this.items = range(0, 1000).map((i) => ({ index: i, height: this.getHeight(i) }));
    }

    private getHeight(index: number): number {
        if (this.useAverageHeightTrap) {
            return index < 100 ? 200 : 10;
        }

        return this.useVariableHeight ? 10 + (Math.abs(index * 7 + 13) % 191) : this.itemSize;
    }

    private toggleVariableHeight(): void {
        this.useAverageHeightTrap = false;
        this.useVariableHeight = !this.useVariableHeight;
        for (const item of this.items) {
            item.height = this.getHeight(item.index);
        }
        this.statusMessage = this.useVariableHeight ? "Switched to variable heights" : "Switched to fixed heights";
    }

    private onAnchorModeChanged(e: Event): void {
        const value = Number.parseInt((e.target as HTMLSelectElement).value, 10);
        if (Number.isInteger(value)) {
            this.anchorMode = value as VirtualizeAnchorMode;
            this.statusMessage = `AnchorMode changed to ${VirtualizeAnchorMode[this.anchorMode]}`;
        }
    }

    private nextPrependIndex = -1;
    private nextAppendIndex = 1000;

    /** `count` new items before the current first one, in list order (the lowest index first). */
    private newHeadItems(count: number): DynamicItem[] {
        return range(0, count)
            .map((i) => ({ index: this.nextPrependIndex - i, height: this.getHeight(this.nextPrependIndex - i) }))
            .reverse();
    }

    private async prependItems(): Promise<void> {
        const newItems = this.newHeadItems(10);
        this.nextPrependIndex -= 10;
        if (this.useItemsProvider && this.virtualizeRef !== undefined) {
            this.pendingPrepend = newItems;
            await this.virtualizeRef.refreshDataAsync();
        } else {
            this.items.splice(0, 0, ...newItems);
        }
        this.statusMessage = `Prepended 10 items (indices ${newItems[0]!.index}..${newItems[newItems.length - 1]!.index})`;
    }

    private async prependManyItems(): Promise<void> {
        const newItems = this.newHeadItems(100);
        this.nextPrependIndex -= 100;
        if (this.useItemsProvider && this.virtualizeRef !== undefined) {
            this.pendingPrepend = newItems;
            await this.virtualizeRef.refreshDataAsync();
        } else {
            this.items.splice(0, 0, ...newItems);
        }
        this.statusMessage = `Prepended 100 items (indices ${newItems[0]!.index}..${newItems[newItems.length - 1]!.index})`;
    }

    private async appendItems(): Promise<void> {
        const startIndex = this.nextAppendIndex;
        const newItems = range(startIndex, 10).map((i) => ({ index: i, height: this.getHeight(i) }));
        this.nextAppendIndex += 10;
        if (this.useItemsProvider && this.virtualizeRef !== undefined) {
            this.pendingAppend = newItems;
            await this.virtualizeRef.refreshDataAsync();
        } else {
            this.items.push(...newItems);
        }
        this.statusMessage = `Appended 10 items (indices ${startIndex}..${startIndex + 9})`;
    }

    private async appendOneItem(): Promise<void> {
        const index = this.nextAppendIndex;
        const newItem = { index, height: this.getHeight(index) };
        this.nextAppendIndex += 1;
        if (this.useItemsProvider && this.virtualizeRef !== undefined) {
            this.pendingAppend = [newItem];
            await this.virtualizeRef.refreshDataAsync();
        } else {
            this.items.push(newItem);
        }
        this.statusMessage = `Appended 1 item (index ${index})`;
    }

    private async appendManyItems(): Promise<void> {
        const startIndex = this.nextAppendIndex;
        const newItems = range(startIndex, 100).map((i) => ({ index: i, height: this.getHeight(i) }));
        this.nextAppendIndex += 100;
        if (this.useItemsProvider && this.virtualizeRef !== undefined) {
            this.pendingAppend = newItems;
            await this.virtualizeRef.refreshDataAsync();
        } else {
            this.items.push(...newItems);
        }
        this.statusMessage = `Appended 100 items (indices ${startIndex}..${startIndex + 99})`;
    }

    private async setSmallCount(): Promise<void> {
        this.items = range(0, 5).map((i) => ({ index: i, height: this.getHeight(i) }));
        this.nextPrependIndex = -1;
        this.nextAppendIndex = 5;
        this.statusMessage = "Set to 5 items";
        if (this.useItemsProvider && this.virtualizeRef !== undefined) { await this.virtualizeRef.refreshDataAsync(); }
    }

    // Reproduces the Aspire dashboard "Console logs": a large OverscanCount and a dataset that is
    // taller than the viewport but still has fewer total items than the Virtualize visible capacity
    private async setConsoleScenario(): Promise<void> {
        this.overscanCount = 100;
        this.items = range(0, 40).map((i) => ({ index: i, height: this.getHeight(i) }));
        this.nextPrependIndex = -1;
        this.nextAppendIndex = 40;
        this.statusMessage = "Console scenario: 40 items, overscan 100";
        if (this.useItemsProvider && this.virtualizeRef !== undefined) { await this.virtualizeRef.refreshDataAsync(); }
    }

    private setLowMaxItemCount(): void {
        this.itemSize = 50;
        this.maxItemCount = 20;
        this.overscanCount = 3;
        this.statusMessage = "MaxItemCount 20, overscan 3";
    }

    private setDoubleSize(): void {
        this.useAverageHeightTrap = false;
        this.useVariableHeight = false;
        this.itemSize = 100;
        for (const item of this.items) {
            item.height = this.itemSize;
        }
        this.statusMessage = "Item size 100";
    }

    private setAverageHeightTrap(): void {
        this.itemSize = 50;
        this.maxItemCount = 300;
        this.overscanCount = 3;
        this.useVariableHeight = false;
        this.useAverageHeightTrap = true;
        for (const item of this.items) {
            item.height = this.getHeight(item.index);
        }
        this.statusMessage = "Tall rows before index 100";
    }

    private expandVisibleItem(): void {
        const target = this.items.find((i) => i.index === 3);
        if (target !== undefined) {
            target.height = 400;
            this.statusMessage = `Expanded item ${target.index}`;
        } else {
            this.statusMessage = "No item to expand";
        }
    }

    private async deleteAbove(): Promise<void> {
        const count = Math.min(10, this.items.length);
        if (this.useItemsProvider && this.virtualizeRef !== undefined) {
            this.pendingDeleteFromTop = count;
            await this.virtualizeRef.refreshDataAsync();
        } else {
            this.items.splice(0, count);
        }
        this.statusMessage = `Deleted ${count} items from above`;
    }

    private async deleteBelow(): Promise<void> {
        const count = Math.min(10, this.items.length);
        if (this.useItemsProvider && this.virtualizeRef !== undefined) {
            this.pendingDeleteFromBottom = count;
            await this.virtualizeRef.refreshDataAsync();
        } else {
            const startIdx = this.items.length - count;
            this.items.splice(startIdx, count);
        }
        this.statusMessage = `Deleted ${count} items from below`;
    }

    private toggleProvider(): void {
        this.useItemsProvider = !this.useItemsProvider;
        this.statusMessage = this.useItemsProvider ? "Switched to ItemsProvider" : "Switched to Items";
    }

    private toggleComparer(): void {
        this.omitItemComparer = !this.omitItemComparer;
        this.statusMessage = this.omitItemComparer ? "Using default ItemComparer" : "Using custom ItemComparer";
    }

    private async getItems(request: VirtualizeItemsProviderRequest): Promise<VirtualizeItemsProviderResult<DynamicItem>> {
        await yieldToEventLoop();
        if (this.useProviderDelay) {
            await delay(500, request.signal);
        }
        if (this.useProviderGate) {
            const n = ++this.providerCallIndex;
            const gate = this.providerGate;
            this.providerEvents.push(`p${n}-enter`);
            this.stateHasChanged();
            try {
                await waitAsync(gate.promise, request.signal);
                this.providerEvents.push(`p${n}-return`);
                this.stateHasChanged();
            } catch (error) {
                if (isAbortError(error)) {
                    this.providerEvents.push(`p${n}-cancel`);
                    this.stateHasChanged();
                }
                throw error;
            }
        }

        // Apply pending mutations (simulates fetching updated data from a DB).
        if (this.pendingPrepend !== null) {
            this.items.splice(0, 0, ...this.pendingPrepend);
            this.pendingPrepend = null;
        }
        if (this.pendingAppend !== null) {
            this.items.push(...this.pendingAppend);
            this.pendingAppend = null;
        }
        if (this.pendingDeleteFromTop > 0) {
            const count = Math.min(this.pendingDeleteFromTop, this.items.length);
            this.items.splice(0, count);
            this.pendingDeleteFromTop = 0;
        }
        if (this.pendingDeleteFromBottom > 0) {
            const count = Math.min(this.pendingDeleteFromBottom, this.items.length);
            this.items.splice(this.items.length - count, count);
            this.pendingDeleteFromBottom = 0;
        }

        let result = this.items
            .slice(request.startIndex, request.startIndex + request.count)
            .map((i) => ({ index: i.index, height: i.height }));
        // With the default comparer we must hand back stable references so reference equality
        // can correctly detect prepend/append; copies would look like an all-new (prepended) window.
        if (this.omitItemComparer) {
            result = this.items.slice(request.startIndex, request.startIndex + request.count);
        }
        return { items: result, totalItemCount: this.items.length };
    }

    private toggleDelay(): void {
        this.useProviderDelay = !this.useProviderDelay;
        this.statusMessage = this.useProviderDelay ? "Provider delay for Virtualize: 500ms" : "Provider delay for Virtualize: None";
    }

    private toggleProviderGate(): void {
        this.useProviderGate = !this.useProviderGate;
        this.statusMessage = this.useProviderGate ? "Provider gate: On" : "Provider gate: Off";
    }

    private releaseProviderGate(): void {
        const old = this.providerGate;
        this.providerGate = deferred();
        old.resolve();
    }

    private async reloadWithInitialIndex(): Promise<void> {
        this.listLoaded = false;
        this.stateHasChanged();
        await yieldToEventLoop();
        this.loadedInitialItemIndex = this.manualInitialIndex;
        this.listLoaded = true;
    }

    private unloadList(): void {
        this.listLoaded = false;
    }

    private async scrollToTarget(): Promise<void> {
        if (this.virtualizeRef === undefined) { this.scrollStatus = "Faulted: no virtualizeRef"; return; }
        this.providerEvents.push("scroll-start");
        this.scrollStatus = `Scrolling to ${this.scrollTargetIndex}...`;
        try {
            await this.virtualizeRef.scrollToItemAsync(this.scrollTargetIndex);
            this.scrollStatus = `Completed: ${this.scrollTargetIndex}`;
            this.providerEvents.push("scroll-complete");
        } catch (error) {
            if (isAbortError(error)) {
                this.scrollStatus = `Canceled: ${this.scrollTargetIndex}`;
                this.providerEvents.push("scroll-cancel");
            } else {
                this.scrollStatus = `Faulted: ${messageOf(error)}`;
            }
        }
    }

    private async scrollRapid(): Promise<void> {
        const virtualize = this.virtualizeRef;
        if (virtualize === undefined) { this.scrollStatus = "Faulted: no virtualizeRef"; return; }
        this.scrollStatus = "Rapid scrolling...";
        // Fire 5 calls back-to-back; each subsequent call supersedes the previous.
        // Superseded calls resolve normally — only the final target lands in the viewport.
        const tasks = [50, 400, 100, 350, 250].map((index) => virtualize.scrollToItemAsync(index));
        const outcomes = await Promise.allSettled(tasks);
        const canceled = outcomes.filter((o) => o.status === "rejected" && isAbortError(o.reason)).length;
        const completed = outcomes.filter((o) => o.status === "fulfilled").length;
        const faulted = outcomes.filter((o) => o.status === "rejected" && !isAbortError(o.reason)).length;
        this.scrollStatus = `Completed: 250 (canceled=${canceled}, completed=${completed}, faulted=${faulted})`;
    }

    private async scrollCancellable(): Promise<void> {
        if (this.virtualizeRef === undefined) { this.scrollStatus = "Faulted: no virtualizeRef"; return; }
        this.userScrollController = new AbortController();
        this.scrollStatus = `Scrolling to ${this.scrollTargetIndex} (cancellable)...`;
        try {
            await this.virtualizeRef.scrollToItemAsync(this.scrollTargetIndex, this.userScrollController.signal);
            this.scrollStatus = `Completed: ${this.scrollTargetIndex}`;
        } catch (error) {
            this.scrollStatus = isAbortError(error) ? "Canceled" : `Faulted: ${messageOf(error)}`;
        }
    }

    private cancelScroll(): void {
        this.userScrollController?.abort();
    }
}
