@page "/virtualization/csp"
@inject NavigationManager nav

@if (useItemsProvider)
{
    <div id="csp-container-async">
        <Virtualize ItemsProvider="@loadItems" ItemSize="50" OverscanCount="3">
            <ItemContent>
                <div @key="context" class="csp-item-async">Async item @context</div>
            </ItemContent>
            <Placeholder>
                <div class="csp-placeholder">Loading...</div>
            </Placeholder>
        </Virtualize>
    </div>
}
else
{
    <div id="csp-container">
        <Virtualize Items="@fixedItems" ItemSize="50" OverscanCount="3">
            <div @key="context" class="csp-item">Item @context</div>
        </Virtualize>
    </div>
}

@code {
    private fixedItems: number[] = range(0, 1000);

    private get useItemsProvider(): boolean {
        return this.nav.uri.includes("mode=items-provider");
    }

    private async loadItems(request: VirtualizeItemsProviderRequest): Promise<VirtualizeItemsProviderResult<number>> {
        // Delay so placeholders actually render and the placeholder
        // data-blazor-virtualize-* path is exercised.
        await delay(50, request.signal);
        const items = range(request.startIndex, request.count);
        return { items, totalItemCount: 1000 };
    }
}
