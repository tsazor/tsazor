@page "/virtualization/large-overscan"
@* Test component to validate behavior when OverscanCount greatly exceeds MaxItemCount. *@

<div id="virtualize-large-overscan" style="height: 600px; overflow-y: auto; outline: 1px solid #999; background:#f8f8f8;">
    <Virtualize Items="items" ItemSize="20" MaxItemCount="100" OverscanCount="200">
        <div class="large-overscan-item" @key="context" style="height:20px; line-height:20px; border-bottom:1px solid #ddd;">Item @context</div>
    </Virtualize>
</div>

@code {
    private items: number[] = range(0, 500);
}
