{
  "name": "blazorhero",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BlazorHero (a Blazor WebAssembly app on MudBlazor) ported to Tsazor with @tsazor/fluent, against BlazorHero's unchanged API — the second app port (docs/port-blazorhero.md).",
  "scripts": {
    "backend": "node scripts/backend.mjs",
    "dev": "vite",
    "build": "tsazor check && vite build",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "check": "tsazor check",
    "verify": "node scripts/verify.mjs",
    "api": "tsazor-dotnet generate http://localhost:5350/swagger/v1/swagger.json --out src/api"
  },
  "dependencies": {
    "@microsoft/signalr": "^10.0.11",
    "@tsazor/charts": "workspace:*",
    "@tsazor/dotnet": "workspace:*",
    "@tsazor/fluent": "workspace:*",
    "@tsazor/fluent-icons": "workspace:*",
    "@tsazor/primitives": "workspace:*",
    "@tsazor/runtime": "workspace:*"
  },
  "devDependencies": {
    "@tsazor/cli": "workspace:*",
    "@tsazor/testing": "workspace:*",
    "@tsazor/vite-plugin": "workspace:*",
    "happy-dom": "^21.0.1",
    "playwright-core": "^1.63.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.7"
  }
}
