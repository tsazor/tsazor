@* The original's pages this port doesn't have yet (docs/port-blazorhero.md, phase 3). Its menu links them, as the
   original's does, so they say so instead of "doesn't exist". *@
@page "/account"
@page "/identity/users"
@page "/identity/roles"
@inject NavigationManager navigation

<div class="bh-not-ported">
    <Typography variant="h4">@(this.current?.name ?? "This page")</Typography>
    <Alert intent="info">
        Not ported yet: phase @(this.current?.phase ?? 3) of the BlazorHero port (docs/port-blazorhero.md).
        Ported so far: everything but the identity pages (phase 3).
    </Alert>
</div>

@code {
    /** Each route the menu links, the original's page it stands for, and the port's phase that brings it. */
    private static readonly pages: Readonly<Record<string, { name: string; phase: number }>> = {
        "account": { name: "Account", phase: 3 },
        "identity/users": { name: "Users", phase: 3 },
        "identity/roles": { name: "Roles", phase: 3 },
    };

    private get current(): { name: string; phase: number } | undefined {
        const path = this.navigation.toBaseRelativePath(this.navigation.uri).split(/[?#]/)[0]!;
        return NotPorted.pages[path];
    }
}
