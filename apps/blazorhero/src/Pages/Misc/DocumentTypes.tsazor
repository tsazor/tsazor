@* Client/Pages/Misc/DocumentTypes.razor(.cs): every document type, searched and sorted in the browser — MudTable with
   Items and Filter becomes a DataGrid of the filtered list, as on the brands page — with the actions the user's
   permissions allow: add and edit in a dialog, delete after a confirmation, export the (filtered) types. *@
@page "/document-types"
@authorize({ policy: "Permissions.DocumentTypes.View" })
@import { HubConnection } from "@microsoft/signalr"
@import { DialogService, GridSort, PaginationState, Toaster } from "@tsazor/fluent"
@import { AddEditDocumentTypeCommand, type GetAllDocumentTypesResponse } from "../../Application/Misc"
@import { downloadBase64, fileStamp } from "../../Extensions/Files"
@import AddEditDocumentTypeModal from "./AddEditDocumentTypeModal.tsazor"
@import DeleteConfirmation from "../../Shared/Dialogs/DeleteConfirmation.tsazor"
@inject DocumentTypeManager documentTypeManager
@inject AuthenticationStateProvider stateProvider
@inject AuthorizationService authorization
@inject DialogService dialogs
@inject Toaster toaster

<HeroTitle title="@L("Document Types")" description="@L("Manage Document Types.")" />
@if (!loaded) {
    <Spinner ariaLabel="@L("Document Types")" />
} else {
    <div class="bh-table-toolbar">
        <div class="bh-table-toolbar__actions">
            @if (canCreateDocumentTypes) {
                <Button intent="primary" iconStart="@Icons.Add" onClick="@(() => invokeModal())">@L("Create")</Button>
            }
            <Button intent="secondary" iconStart="@Icons.ArrowClockwise" onClick="@getDocumentTypesAsync">@L("Reload")</Button>
            @if (canExportDocumentTypes) {
                <Button iconStart="@Icons.DocumentTable" onClick="@exportToExcel">@L("Export")</Button>
            }
        </div>
        @if (canSearchDocumentTypes) {
            <TextInput class="bh-table-toolbar__search" ariaLabel="@L("Search for Document Types")" placeholder="@L("Search for Document Types")" @bind-Value="searchString" immediate>
                <ContentBefore><Icon value="@Icons.Search" /></ContentBefore>
            </TextInput>
        }
    </div>
    <DataGrid items="@filteredDocumentTypes" pagination="@pagination" hover striped="@striped" bordered="@bordered" small="@dense" ariaLabel="@L("Document Types")">
        <PropertyColumn property="(documentType) => documentType.id" title="@L("Id")" sortable />
        <TemplateColumn title="@L("Name")" sortBy="@byName" Context="documentType">
            <Highlighter text="@documentType.name" highlightedText="@searchString" />
        </TemplateColumn>
        <TemplateColumn title="@L("Description")" sortBy="@byDescription" Context="documentType">
            <Highlighter text="@documentType.description" highlightedText="@searchString" />
        </TemplateColumn>
        <TemplateColumn title="@L("Actions")" align="end" Context="documentType">
            @if (canEditDocumentTypes || canDeleteDocumentTypes) {
                <Menu label="@L("Actions")" ariaLabel='@(`${L("Actions")}: ${documentType.name}`)' placement="bottom-end">
                    @if (canEditDocumentTypes) {
                        <MenuItem onSelect="@(() => invokeModal(documentType.id))">@L("Edit")</MenuItem>
                    }
                    @if (canDeleteDocumentTypes) {
                        <MenuItem onSelect="@(() => deleteAsync(documentType.id))">@L("Delete")</MenuItem>
                    }
                </Menu>
            } else {
                <Button size="small" iconStart="@Icons.HandRight" disabled>@L("No Allowed Actions")</Button>
            }
        </TemplateColumn>
    </DataGrid>
    <div class="bh-table-footer">
        <div class="bh-table-footer__switches">
            <Switch label="@L("Dense")" @bind-Value="dense" />
            <Switch label="@L("Striped")" @bind-Value="striped" />
            <Switch label="@L("Bordered")" @bind-Value="bordered" />
        </div>
        <TablePager state="@pagination" />
    </div>
}

@code {
    @CascadingParameter({ type: HubConnection }) hubConnection?: HubConnection;

    private readonly L = localizerFor("DocumentTypes");
    private readonly pagination = new PaginationState();
    private documentTypeList: GetAllDocumentTypesResponse[] = [];
    private searchString = "";
    private dense = false;
    private striped = true;
    private bordered = false;

    private canCreateDocumentTypes = false;
    private canEditDocumentTypes = false;
    private canDeleteDocumentTypes = false;
    private canExportDocumentTypes = false;
    private canSearchDocumentTypes = false;
    private loaded = false;

    private readonly byName = GridSort.byAscending((documentType: GetAllDocumentTypesResponse) => documentType.name);
    private readonly byDescription = GridSort.byAscending((documentType: GetAllDocumentTypesResponse) => documentType.description);

    /** MudTable's Filter: the name or the description contains the search, in any case. */
    private get filteredDocumentTypes(): GetAllDocumentTypesResponse[] {
        const search = this.searchString.trim().toLowerCase();
        if (search === "") return this.documentTypeList;
        return this.documentTypeList.filter((documentType) => documentType.name.toLowerCase().includes(search) || documentType.description.toLowerCase().includes(search));
    }

    protected override async onInitialized(): Promise<void> {
        const user = (await this.stateProvider.getAuthenticationStateAsync()).user;
        const can = async (policy: string): Promise<boolean> => this.authorization.isAuthorized(user, { policy });
        this.canCreateDocumentTypes = await can(Permissions.DocumentTypes.Create);
        this.canEditDocumentTypes = await can(Permissions.DocumentTypes.Edit);
        this.canDeleteDocumentTypes = await can(Permissions.DocumentTypes.Delete);
        this.canExportDocumentTypes = await can(Permissions.DocumentTypes.Export);
        this.canSearchDocumentTypes = await can(Permissions.DocumentTypes.Search);

        await this.getDocumentTypesAsync();
        this.loaded = true;
    }

    private async getDocumentTypesAsync(): Promise<void> {
        const response = await this.documentTypeManager.getAllAsync();
        if (response.succeeded) {
            this.documentTypeList = response.data;
        } else {
            for (const message of response.messages) this.toaster.show({ message, intent: "danger" });
        }
    }

    private async deleteAsync(id: number): Promise<void> {
        const dialog = this.dialogs.show(DeleteConfirmation, {
            title: this.L("Delete"),
            size: "small",
            closeOnBackdrop: false,
            parameters: { contentText: this.L("Delete Content", { 0: id }) },
        });
        if ((await dialog.result).canceled) return;
        const response = await this.documentTypeManager.deleteAsync(id);
        await this.getDocumentTypesAsync();
        if (response.succeeded) {
            await this.updateDashboard();
            this.toaster.show({ message: response.messages[0]!, intent: "success" });
        } else {
            for (const message of response.messages) this.toaster.show({ message, intent: "danger" });
        }
    }

    private async exportToExcel(): Promise<void> {
        const response = await this.documentTypeManager.exportToExcelAsync(this.searchString);
        if (response.succeeded) {
            downloadBase64(response.data, `document_types_${fileStamp()}.xlsx`, ApplicationConstants.MimeTypes.OpenXml);
            this.toaster.show({ message: this.searchString.trim() === "" ? this.L("Document Types exported") : this.L("Filtered Document Types exported"), intent: "success" });
        } else {
            for (const message of response.messages) this.toaster.show({ message, intent: "danger" });
        }
    }

    private async invokeModal(id = 0): Promise<void> {
        const documentType = id === 0 ? undefined : this.documentTypeList.find((candidate) => candidate.id === id);
        const model = Object.assign(new AddEditDocumentTypeCommand(), documentType && { id: documentType.id, name: documentType.name, description: documentType.description });
        const dialog = this.dialogs.show(AddEditDocumentTypeModal, {
            title: id === 0 ? this.L("Create") : this.L("Edit"),
            size: "small",
            closeOnBackdrop: false,
            parameters: { addEditDocumentTypeModel: model },
        });
        if ((await dialog.result).canceled) return;
        await this.updateDashboard();
        await this.getDocumentTypesAsync();
    }

    /** The original's dialog and Delete send UpdateDashboard, so open dashboards reload their counts. */
    private async updateDashboard(): Promise<void> {
        await this.hubConnection?.send(ApplicationConstants.SignalR.SendUpdateDashboard);
    }
}
