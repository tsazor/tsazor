@* Client/_Imports.razor. Its `@attribute [Authorize]` protects every page; the sign-in page opts out with
   @allowAnonymous, as the original's [AllowAnonymous] (port-blazorhero.md, B12). *@
@authorize
@using @tsazor/fluent
@using ./Shared
@using ./Shared/Components
@using ./Shared/Dialogs
@* The standard runtime set (Blazor: @using Microsoft.AspNetCore.Components.*). Unused imports are dropped by the build. *@
@import { ComponentBase, LayoutComponentBase, Parameter, CascadingParameter, EventCallback, inject } from "@tsazor/runtime"
@import { NavigationManager, Router, RouteView, LayoutView, NavLink, NavLinkMatch, PageTitle, FocusOnNavigate } from "@tsazor/runtime"
@import { AuthorizeView, AuthorizeRouteView, AuthenticationStateProvider, AuthorizationService, TsazorHttp } from "@tsazor/runtime"
@import type { RenderFragment, RouteData } from "@tsazor/runtime"
@import type { Intent } from "@tsazor/fluent"
@* The app's own (Blazor: @using BlazorHero.CleanArchitecture.Client.Infrastructure.*, Shared.Constants.*). *@
@import * as Icons from "@tsazor/fluent-icons/regular/size20"
@import { localizerFor } from "./i18n"
@import { ApplicationConstants, LocalizationConstants, Permissions, RoleConstants, StorageConstants } from "./Application/Constants"
@import { BlazorHeroStateProvider } from "./Infrastructure/Authentication/BlazorHeroStateProvider"
@import { AuthenticationManager } from "./Infrastructure/Managers/AuthenticationManager"
@import { AccountManager, RoleManager, UserManager } from "./Infrastructure/Managers/IdentityManagers"
@import { BrandManager, ProductManager } from "./Infrastructure/Managers/CatalogManagers"
@import { ChatManager, DashboardManager } from "./Infrastructure/Managers/CommunicationManagers"
@import { AuditManager, DocumentExtendedAttributeManager, DocumentManager, DocumentTypeManager } from "./Infrastructure/Managers/MiscManagers"
@import { ClientPreferenceManager } from "./Infrastructure/Managers/ClientPreferenceManager"
@import { BlazorHeroLogo } from "./Infrastructure/Settings/BlazorHeroTheme"
