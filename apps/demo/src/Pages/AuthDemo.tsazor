@page "/auth"
@inject DemoAuthProvider Auth

<div class="card">
    <h1>Auth-Demo</h1>
    <p class="muted">AuthorizeView mit Blazor-Semantik — der AuthenticationStateProvider ist über DI registriert.</p>

    <AuthorizeView>
        <Authorized>
            <div class="success">Angemeldet als @(context.user.name).</div>
            <p>Diese Zeile sieht nur der angemeldete Benutzer.</p>
        </Authorized>
        <NotAuthorized>
            <p class="error-text">Nicht angemeldet — geschützter Inhalt ist ausgeblendet.</p>
        </NotAuthorized>
    </AuthorizeView>

    <div class="field">
        <button class="btn" @onclick="signIn">Anmelden (alice)</button>
        <button class="btn" @onclick="signOut">Abmelden</button>
    </div>
</div>

@code {
    private signIn() {
        this.Auth.signIn("alice");
    }

    private signOut() {
        this.Auth.signOut();
    }
}
