@page "/auth"
@inject DemoAuthProvider Auth

<div class="card">
    <h1>Auth demo</h1>
    <p class="muted">AuthorizeView with Blazor semantics — the AuthenticationStateProvider is registered via DI.</p>

    <AuthorizeView>
        <Authorized>
            <div class="success">Signed in as @(context.user.name).</div>
            <p>Only the signed-in user sees this line.</p>
        </Authorized>
        <NotAuthorized>
            <p class="error-text">Not signed in — protected content is hidden.</p>
        </NotAuthorized>
    </AuthorizeView>

    <div class="field">
        <button class="btn" @onclick="signIn">Sign in (alice)</button>
        <button class="btn" @onclick="signOut">Sign out</button>
    </div>
</div>

@code {
    private signIn() {
        this.Auth.signIn("alice");
    }

    private signOut() {
        this.Auth.signOut();
    }
}
