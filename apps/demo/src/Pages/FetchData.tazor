@page "/fetchdata"

<h1>FetchData</h1>

@if (error !== null) {
    <p class="error-text">@error</p>
} else if (loading) {
    <p class="loading">Loading…</p>
} else {
    <table class="data-table">
        <thead>
            <tr><th>Date</th><th>Summary</th><th>Temp (°C)</th></tr>
        </thead>
        <tbody>
            @for (const forecast of forecasts) {
                <tr>
                    <td>@forecast.date</td>
                    <td>@forecast.summary</td>
                    <td>@forecast.temperatureC</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private forecasts: Array<{ date: string; summary: string; temperatureC: number }> = [];
    private loading = true;
    private error: string | null = null;

    protected override async onInitialized(): Promise<void> {
        const http = new TasorHttp();
        try {
            const result = await http.getJson<Array<{ date: string; summary: string; temperatureC: number }>>("/weather.json");
            this.forecasts = result;
        } catch (err) {
            this.error = String(err);
        } finally {
            this.loading = false;
        }
    }
}