@page "/virtualize"

<h1>Virtualize demo</h1>
<p>10,000 items — only the visible window is rendered.</p>

@* A scrolling region must be reachable by keyboard (WCAG 2.1.1). *@
<div class="virtual-list" tabindex="0" role="region" aria-label="10,000 items">
    <Virtualize Items="@items" ItemSize="32" OverscanCount="5">
        <ItemContent Context="entry">
            <div class="virtual-item"><span>@entry.name</span><span class="muted">#@entry.index</span></div>
        </ItemContent>
    </Virtualize>
</div>

<h2 class="h4 mt-4">DataGrid with Virtualize</h2>
<p>10,000 orders in a scrolling panel — sorting works on all of them, the table renders the rows in view.</p>
<div class="virtual-grid" tabindex="0" role="region" aria-label="10,000 orders">
    <DataGrid Items="@orders" Virtualize="@true" ItemSize="33" Small="@true" StickyHeader="@true" AriaLabel="Orders">
        <PropertyColumn Property="(o) => o.id" Title="#" Sortable="@true" />
        <PropertyColumn Property="(o) => o.customer" Sortable="@true" />
        <PropertyColumn Property="(o) => o.total" Title="Total" Format="(v) => v.toFixed(2)" Align="end" Sortable="@true" />
    </DataGrid>
</div>

@code {
    private orders = Array.from({ length: 10_000 }, (_, i) => ({ id: i + 1, customer: ["Marta", "Jonas", "Lena", "Ali", "Noor", "Pavel"][(i * 7) % 6]!, total: ((i * 37) % 500) / 10 }));
    private items = Array.from({ length: 10_000 }, (_, i) => ({ index: i, name: `Item ${i}` }));
}
