@* A yes/no field's settings (FluentCMS's BooleanFieldSettings). *@
@inherits BaseFieldSettingView<BooleanFieldModel>
@import { BaseFieldSettingView } from "../BaseFieldSettingView"
@import type { BooleanFieldModel } from "../field-models"

<FormModal visible title="@this.formTitle" size="large" model="@model" onSubmit="@this.submitForm" onCancel="@onCancel">
    <Tabs ariaLabel="Field settings">
        <Tab title="Basic">
            <FieldBasics model="@model" />
        </Tab>
        <Tab title="View">
            <FieldViewSettings model="@model" />
        </Tab>
        <Tab title="Advanced">
            <FieldAdvanced model="@model">
                <Switch @bind-Value="model.defaultValue" label="Default Value" />
            </FieldAdvanced>
        </Tab>
    </Tabs>
</FormModal>
