@* A date field's settings (FluentCMS's DateFieldSettings); the format is a .NET date format, as FluentCMS stores it. *@
@inherits BaseFieldSettingView<DateFieldModel>
@import { BaseFieldSettingView } from "../BaseFieldSettingView"
@import { DATE_FORMATS, type DateFieldModel } from "../field-models"

<FormModal visible title="@this.formTitle" size="large" model="@model" onSubmit="@this.submitForm" onCancel="@onCancel">
    <Tabs ariaLabel="Field settings">
        <Tab title="Basic">
            <FieldBasics model="@model">
                <TextInput @bind-Value="model.placeholder" label="Placeholder" placeholder="Enter Field Placeholder" />
            </FieldBasics>
        </Tab>
        <Tab title="View">
            <FieldViewSettings model="@model" />
        </Tab>
        <Tab title="Advanced">
            <FieldAdvanced model="@model">
                <DateInput @bind-Value="model.defaultValue" label="Default Value" />
                <Select @bind-Value="model.format" label="Format">
                    <option value="">Choose Date format for view mode</option>
                    @foreach (const format of DATE_FORMATS) {
                        <option value="@format">@format</option>
                    }
                </Select>
            </FieldAdvanced>
        </Tab>
    </Tabs>
</FormModal>
