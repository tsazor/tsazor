@* A single-select field's settings (FluentCMS's SelectFieldSettings): its options, one per line. *@
@inherits BaseFieldSettingView<SelectFieldModel>
@import { BaseFieldSettingView } from "../BaseFieldSettingView"
@import { selectOptions, type SelectFieldModel } from "../field-models"

<FormModal visible title="@this.formTitle" size="large" model="@model" onSubmit="@this.submitForm" onCancel="@onCancel">
    <Tabs ariaLabel="Field settings">
        <Tab title="Basic">
            <FieldBasics model="@model">
                <TextInput @bind-Value="model.placeholder" label="Placeholder" placeholder="Enter Field Placeholder" />
            </FieldBasics>
        </Tab>
        <Tab title="View">
            <FieldViewSettings model="@model" />
        </Tab>
        <Tab title="Advanced">
            <FieldAdvanced model="@model">
                <Select @bind-Value="model.defaultValue" label="Default Value">
                    <option value="">@(model.placeholder || "(none)")</option>
                    @foreach (const option of selectOptions(model.options)) {
                        <option value="@option">@option</option>
                    }
                </Select>
                <TextArea @bind-Value="model.options" label="Options" placeholder="Enter Select options (each item in new line)" required />
            </FieldAdvanced>
        </Tab>
    </Tabs>
</FormModal>
