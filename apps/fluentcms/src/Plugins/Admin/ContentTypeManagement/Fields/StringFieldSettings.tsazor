@* A text field's settings (FluentCMS's StringFieldSettings). *@
@inherits BaseFieldSettingView<StringFieldModel>
@import { BaseFieldSettingView } from "../BaseFieldSettingView"
@import type { StringFieldModel } from "../field-models"

<FormModal visible title="@this.formTitle" size="large" model="@model" onSubmit="@this.submitForm" onCancel="@onCancel">
    <Tabs ariaLabel="Field settings">
        <Tab title="Basic">
            <FieldBasics model="@model">
                <NumberInput @bind-Value="model.minimumLength" min="0" label="Minimum Length" placeholder="Enter Minimum Length" />
                <NumberInput @bind-Value="model.maximumLength" min="0" label="Maximum Length" placeholder="Enter Maximum Length" />
                <TextInput @bind-Value="model.placeholder" label="Placeholder" placeholder="Enter Field Placeholder" />
            </FieldBasics>
        </Tab>
        <Tab title="View">
            <FieldViewSettings model="@model" />
        </Tab>
        <Tab title="Advanced">
            <FieldAdvanced model="@model">
                <TextInput @bind-Value="model.pattern" label="Regex pattern" placeholder="Enter regex pattern" />
                <TextArea @bind-Value="model.defaultValue" label="Default Value" placeholder="Enter default value" />
            </FieldAdvanced>
        </Tab>
    </Tabs>
</FormModal>
