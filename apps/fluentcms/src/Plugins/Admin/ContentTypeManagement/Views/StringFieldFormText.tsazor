@* A text field as a single-line input (FluentCMS's StringFieldFormText), with the field's length and pattern. *@
@inherits BaseFieldValueView<string | null, StringFieldModel>
@import { BaseFieldValueView } from "../BaseFieldValueView"
@import type { StringFieldModel } from "../field-models"

<TextInput @bind-Value="fieldValue.value" label="@field.label" placeholder="@(field.placeholder ?? undefined)" required="@field.required" minlength="@field.minimumLength" maxlength="@field.maximumLength" pattern="@(field.pattern || null)" />
