@* A text field as a multi-line input (FluentCMS's StringFieldFormTextArea). *@
@inherits BaseFieldValueView<string | null, StringFieldModel>
@import { BaseFieldValueView } from "../BaseFieldValueView"
@import type { StringFieldModel } from "../field-models"

<TextArea @bind-Value="fieldValue.value" label="@field.label" placeholder="@(field.placeholder ?? undefined)" required="@field.required" minlength="@field.minimumLength" maxlength="@field.maximumLength" />
