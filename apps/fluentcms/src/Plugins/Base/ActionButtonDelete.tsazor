@* The "delete" button in a list's row (FluentCMS's ActionButtonDelete). Its @onclick goes onto the button, as in Blazor. *@

<ActionButton iconName="@IconName.Delete" label="@label" intent="danger" visible="@visible" @attributes="@additionalAttributes" />

@code {
    @Parameter() label = "Delete";
    @Parameter() visible = true;
    @Parameter({ captureUnmatchedValues: true }) additionalAttributes?: Record<string, unknown>;
}
