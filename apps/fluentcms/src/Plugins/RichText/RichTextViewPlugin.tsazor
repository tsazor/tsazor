@* Rich text stored as the plugin's content, as the editor's HTML (FluentCMS's RichTextViewPlugin). *@
@inherits BasePlugin
@import { contentText, pluginContents, type PluginContentItem } from "../Base/plugin-content"

@if (this.item !== undefined) {
    <div class="f-rich-text-content">
        @(new MarkupString(contentText(this.item, "Content")))
    </div>
}

@code {
    private item?: PluginContentItem;

    protected override async onInitialized(): Promise<void> {
        [this.item] = await pluginContents(this.api, "RichTextContent", this.plugin.id);
    }
}
