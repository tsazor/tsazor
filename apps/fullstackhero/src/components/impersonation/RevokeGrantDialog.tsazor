@* components/impersonation/revoke-grant-dialog.tsx: the confirmation for revoking an active impersonation grant. It
   asks for an optional reason (recorded on the grant and in the security audit trail) and shows the impersonated
   user / actor / tenant trio, so the operator knows exactly what they're killing. Open while `grant` is set. *@
@import { ShieldOff } from "lucide"
@import { revokeImpersonationGrant, type ImpersonationGrantDto } from "@/api/impersonation-grants"
@import { queryClient } from "@/lib/query-client"
@import { toast } from "@/lib/toast"
@import { describe } from "@/components/tenants/format"
@import GrantSummaryRow from "./GrantSummaryRow.tsazor"

<Dialog open="@(grant !== null)" openChanged="@onOpenChange">
    <DialogContent size="md">
        <DialogHeader>
            <div class="flex items-center gap-2">
                <span aria-hidden="true" class="grid h-7 w-7 place-items-center rounded-md bg-[var(--color-destructive)]/15 text-[var(--color-destructive)]">
                    <Icon icon="@ShieldOff" class="h-4 w-4" />
                </span>
                <DialogTitle>Revoke impersonation grant</DialogTitle>
            </div>
            <DialogDescription>
                The issued token will be rejected on the next authenticated request (within ~1 second of cache TTL). The session in the dashboard tab is killed without warning.
            </DialogDescription>
        </DialogHeader>

        <DialogBody class="space-y-4">
            @if (grant) {
                <div class="space-y-2 rounded-md border border-[var(--color-border)] bg-[var(--color-surface-2)] px-3 py-3">
                    <GrantSummaryRow label="Impersonating">
                        <span class="font-medium">@(grant.impersonatedUserName ?? grant.impersonatedUserId)</span>
                        <Badge variant="muted" class="ml-1 font-mono uppercase tracking-[0.14em]">@grant.impersonatedTenantId</Badge>
                    </GrantSummaryRow>
                    <GrantSummaryRow label="Started by">
                        <span>@(grant.actorUserName ?? grant.actorUserId)</span>
                        <Badge variant="muted" class="ml-1 font-mono uppercase tracking-[0.14em]">@grant.actorTenantId</Badge>
                    </GrantSummaryRow>
                    <GrantSummaryRow label="Reason">
                        <span class="text-[var(--color-muted-foreground)]">@(grant.reason || "—")</span>
                    </GrantSummaryRow>
                    <GrantSummaryRow label="Expires">
                        <code class="code-chip">@(new Date(grant.expiresAtUtc).toLocaleString())</code>
                    </GrantSummaryRow>
                </div>
            }

            <div class="space-y-1.5">
                <label for="revoke-reason" class="meta text-[var(--color-muted-foreground)]">Reason (optional)</label>
                <textarea id="revoke-reason" value="@reason" @oninput="(e) => reason = (e.target as HTMLTextAreaElement).value"
                          placeholder="e.g. Operator left for lunch; ending session" rows="3" maxlength="500"
                          class="@cn("w-full resize-y rounded-md border border-[var(--color-input)] bg-transparent px-3 py-2 text-sm", "transition-[border-color,background-color,box-shadow] duration-[var(--duration-fast)]", "hover:border-[var(--color-border-strong)]", "focus-visible:outline-none focus-visible:border-[var(--color-accent-signal)] focus-visible:ring-2 focus-visible:ring-[oklch(from_var(--color-accent-signal)_l_c_h_/_0.25)] focus-visible:bg-[var(--color-surface-2)]")"></textarea>
                <p class="text-[11px] text-[var(--color-muted-foreground)]">Recorded on the grant and in the security audit trail.</p>
            </div>
        </DialogBody>

        <DialogFooter>
            <Button variant="outline" onClick="@(() => onOpenChange?.invokeAsync(false))" disabled="@pending">Cancel</Button>
            <Button variant="destructive" onClick="@revoke" disabled="@pending">
                <Icon icon="@ShieldOff" class="mr-1 h-3.5 w-3.5" />
                @(pending ? "Revoking…" : "Revoke now")
            </Button>
        </DialogFooter>
    </DialogContent>
</Dialog>

@code {
    @Parameter() grant: ImpersonationGrantDto | null = null;
    @Parameter() onOpenChange?: EventCallback<boolean>;
    /** Optional callback after a successful revoke — receives the updated grant. */
    @Parameter() onRevoked?: EventCallback<ImpersonationGrantDto>;

    private reason = "";
    private pending = false;
    private targetedId?: string;

    /** Reset the reason whenever a new grant is targeted (or the dialog reopens). */
    protected override onParametersSet(): void {
        const id = this.grant?.id;
        if (id !== this.targetedId) {
            if (id !== undefined) this.reason = "";
            this.targetedId = id;
        }
    }

    private async revoke(): Promise<void> {
        const grant = this.grant;
        if (!grant) return;
        this.pending = true;
        try {
            const updated = await revokeImpersonationGrant(grant.id, this.reason.trim() || undefined);
            toast.success("Impersonation revoked", {
                description: `Token for ${updated.impersonatedUserName ?? updated.impersonatedUserId} will be rejected on the next request.`,
            });
            void queryClient.invalidateQueries({ queryKey: ["impersonation-grants"] });
            await this.onRevoked?.invokeAsync(updated);
            await this.onOpenChange?.invokeAsync(false);
        } catch (err) {
            toast.error("Revoke failed", { description: describe(err) });
        } finally {
            this.pending = false;
        }
    }
}
