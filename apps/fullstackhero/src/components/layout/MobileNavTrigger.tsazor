@* components/layout/mobile-nav.tsx's MobileNavTrigger: the hamburger (`md:hidden`) in the topbar. *@
@import { Menu } from "lucide"
@import { ShellState } from "./shell-state"

<button type="button" aria-label="Open navigation menu" @onclick="() => shell.setMobileNavOpen(true)"
        class="@cn("grid h-9 w-9 cursor-pointer place-items-center rounded-md md:hidden", "text-[var(--color-muted-foreground)] hover:bg-[var(--color-accent)] hover:text-[var(--color-foreground)]", "transition-colors duration-[var(--duration-fast)] ease-[var(--ease-out-cubic)]", "focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-ring)]")">
    <Icon icon="@Menu" class="h-4 w-4" />
</button>

@code {
    @CascadingParameter({ type: ShellState }) shell!: ShellState;
}
