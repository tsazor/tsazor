@* components/layout/topbar.tsx's ProfileTile: the square topbar avatar — the uploaded profile image when present,
   the brand-tinted initials tile when missing or on load error. A new `src` (a freshly uploaded image) tries again,
   as the original's `key={avatarUrl}`. *@

<span aria-hidden="true" class="grid size-8 shrink-0 place-items-center overflow-hidden rounded-lg bg-[oklch(from_var(--color-primary)_l_c_h_/_0.15)] font-display text-[11px] font-bold tracking-tight text-[var(--color-primary)]">
    @if (src && failedSrc !== src) {
        <img src="@src" alt="" width="32" height="32" loading="lazy" decoding="async" @onerror="() => failedSrc = src" class="h-full w-full object-cover" />
    } else {
        @initials
    }
</span>

@code {
    @Parameter() src?: string | null;
    @Parameter() initials: string = "U";

    private failedSrc?: string | null;
}
