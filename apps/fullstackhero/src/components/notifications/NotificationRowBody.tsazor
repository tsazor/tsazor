@* The row's text: the title with its age, the body — inside the row's link or on its own (React's `const body = …`;
   Tsazor has no Razor templates in @code: port-fullstackhero.md, F3). *@
@import type { NotificationDto } from "@/api/notifications"
@import { formatRelative } from "./format"

<div class="min-w-0 flex-1">
    <div class="flex flex-wrap items-baseline gap-x-2">
        <span class="truncate font-medium">@notif.title</span>
        <span class="font-mono text-[10px] uppercase tracking-[0.14em] text-[var(--color-muted-foreground)]">@formatRelative(notif.createdAtUtc)</span>
    </div>
    @if (notif.body) {
        <p class="mt-0.5 line-clamp-2 text-[12px] text-[var(--color-muted-foreground)]">@notif.body</p>
    }
</div>

@code {
    @Parameter() notif!: NotificationDto;
}
