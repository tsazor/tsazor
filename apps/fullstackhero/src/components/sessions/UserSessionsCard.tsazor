@* components/sessions/user-sessions-card.tsx: the admin view on the user detail page — every session a user has,
   revocable one by one or all at once by an operator with Sessions.RevokeAll. Hidden without Sessions.ViewAll.
   useMutation's pending state is a field; the revokes in flight are a Set, so two quick revokes track independently
   and the first to finish doesn't clear the second row's busy state. *@
@import { LogOut } from "lucide"
@import { adminRevokeAllUserSessions, adminRevokeUserSession, getUserSessions } from "@/api/sessions"
@import { IdentityPermissions } from "@/lib/permissions"
@import { ApiRequestError } from "@/lib/api-client"
@import { queryClient } from "@/lib/query-client"
@import { toast } from "@/lib/toast"
@import { Query } from "@/lib/query"
@import SessionRow from "./SessionRow.tsazor"
@inject AuthService auth

@if (canView) {
    <FormShell>
        <FormSection title="Sessions" description="Active browser/device sessions for this user. Revoking signs the device out within ~10 seconds.">
            @if (query.result.isError) {
                <ErrorBand message="@(query.result.error instanceof ApiRequestError ? query.result.error.problem?.detail ?? query.result.error.message : "Failed to load sessions.")" />
            } else if (query.result.isLoading) {
                <p class="meta text-[var(--color-muted-foreground)]">Loading<span class="caret text-[var(--color-accent-signal)]"></span></p>
            } else if (sessions.length === 0) {
                <p class="text-sm text-[var(--color-muted-foreground)]">No sessions on record for this user.</p>
            } else {
                <ul class="divide-y divide-[var(--color-border)] border-y border-[var(--color-border)]">
                    @foreach (const s of sessions) {
                        <SessionRow @key="s.id" session="@s" canRevoke="@(canRevoke && s.isActive)" busy="@busyIds.has(s.id)" onRevoke="@(() => revokeOne(s.id))" />
                    }
                </ul>

                @if (canRevoke && activeCount > 0) {
                    <div class="flex flex-wrap items-center justify-between gap-3 pt-2">
                        <span class="meta text-[var(--color-muted-foreground)]">@activeCount active @(activeCount === 1 ? "session" : "sessions")</span>
                        <Button variant="outline" size="sm" onClick="@revokeAll" disabled="@revokingAll">
                            <Icon icon="@LogOut" class="mr-1.5 h-3.5 w-3.5" />
                            @(revokingAll ? "Signing out…" : "Revoke all sessions")
                        </Button>
                    </div>
                }
            }
        </FormSection>
    </FormShell>
}

@code {
    @Parameter() userId!: string;

    private busyIds: ReadonlySet<string> = new Set();
    private revokingAll = false;

    private readonly query = new Query(() => ({
        queryKey: ["admin", "user-sessions", this.userId],
        queryFn: () => getUserSessions(this.userId),
        enabled: this.canView && Boolean(this.userId),
        staleTime: 15_000,
    }));

    protected override onInitialized(): void {
        this.observe(this.auth.changes);
        this.observe(this.query);
    }

    private get granted(): string[] {
        return this.auth.user?.permissions ?? [];
    }

    private get canView(): boolean {
        return this.granted.includes(IdentityPermissions.Sessions.ViewAll);
    }

    private get canRevoke(): boolean {
        return this.granted.includes(IdentityPermissions.Sessions.RevokeAll);
    }

    private get sessions() {
        return this.query.result.data ?? [];
    }

    private get activeCount(): number {
        return this.sessions.filter((s) => s.isActive).length;
    }

    private async revokeOne(sessionId: string): Promise<void> {
        this.busyIds = new Set(this.busyIds).add(sessionId);
        try {
            await adminRevokeUserSession(this.userId, sessionId);
            toast.success("Session revoked");
            void queryClient.invalidateQueries({ queryKey: ["admin", "user-sessions", this.userId] });
        } catch (err) {
            toast.error("Revoke failed", { description: this.describe(err) });
        } finally {
            const next = new Set(this.busyIds);
            next.delete(sessionId);
            this.busyIds = next;
        }
    }

    private async revokeAll(): Promise<void> {
        this.revokingAll = true;
        try {
            const data = await adminRevokeAllUserSessions(this.userId);
            toast.success(`Revoked ${data.revokedCount} ${data.revokedCount === 1 ? "session" : "sessions"}`);
            void queryClient.invalidateQueries({ queryKey: ["admin", "user-sessions", this.userId] });
        } catch (err) {
            toast.error("Revoke all failed", { description: this.describe(err) });
        } finally {
            this.revokingAll = false;
        }
    }

    private describe(err: unknown): string {
        if (err instanceof ApiRequestError) return err.problem?.detail ?? err.problem?.title ?? err.message;
        if (err instanceof Error) return err.message;
        return String(err);
    }
}
