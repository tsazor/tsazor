@* create-tenant-dialog.tsx's PreviewRail: the live preview of the tenant being created — its monogram, name, slug,
   admin email, plan — beside the form (a compact banner on mobile). *@

<aside class="@cn("relative flex items-center gap-4 overflow-hidden p-5 sm:flex-col sm:items-start sm:gap-0 sm:p-6", "border-b border-[var(--color-border)] sm:border-b-0 sm:border-r", "bg-gradient-to-b from-[oklch(from_var(--color-primary)_l_c_h_/_0.06)] to-[var(--color-muted)]/40")">
    @* Soft radial glow behind the monogram for depth *@
    <div aria-hidden="true" class="pointer-events-none absolute -left-8 -top-10 h-40 w-40 rounded-full opacity-60 blur-2xl bg-[radial-gradient(circle,oklch(from_var(--color-primary)_l_c_h_/_0.18),transparent_70%)]"></div>

    <div class="relative shrink-0">
        <Monogram seed="@(slug || name || "new")" fallback="@displayName" size="lg" />
    </div>

    <div class="relative min-w-0 sm:mt-4">
        <p class="truncate font-display text-[15px] font-semibold leading-tight text-[var(--color-foreground)]">@displayName</p>
        <p class="mt-1 truncate font-mono text-[12px] text-[var(--color-muted-foreground)]">@displaySlug</p>

        @if (email.trim()) {
            <p class="mt-0.5 hidden truncate font-mono text-[11px] text-[var(--color-muted-foreground)]/80 sm:block">@email.trim()</p>
        }

        @* Live facts — hidden on mobile to keep the banner compact *@
        <dl class="mt-4 hidden space-y-2 sm:block">
            <div class="flex items-center gap-2">
                <span aria-hidden="true" class="size-1.5 rounded-full bg-[var(--color-primary)] ring-2 ring-[oklch(from_var(--color-primary)_l_c_h_/_0.18)]"></span>
                <span class="text-[12px] text-[var(--color-muted-foreground)]">@(planLabel ?? "Default plan")</span>
            </div>
            <div class="flex items-center gap-2">
                <span aria-hidden="true" class="size-1.5 rounded-full bg-[var(--color-success)] ring-2 ring-[oklch(from_var(--color-success)_l_c_h_/_0.18)]"></span>
                <span class="text-[12px] text-[var(--color-muted-foreground)]">Active on creation</span>
            </div>
        </dl>
    </div>

    <p class="relative mt-auto hidden pt-6 text-[11px] leading-relaxed text-[var(--color-muted-foreground)]/75 sm:block">
        Provisioning runs in the background. You can track progress on the tenant's detail page.
    </p>
</aside>

@code {
    @Parameter() name: string = "";
    @Parameter() slug: string = "";
    @Parameter() planLabel: string | null = null;
    @Parameter() email: string = "";

    private get displayName(): string {
        return this.name.trim() || "New tenant";
    }

    private get displaySlug(): string {
        return this.slug || "tenant-id";
    }
}
