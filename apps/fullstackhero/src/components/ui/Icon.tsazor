@* lucide-react's icon components, from lucide's framework-free package: an icon is its drawing (`IconNode`, the
   elements of the SVG), drawn here with lucide's own defaults — a 24×24 outline in currentColor, 2px strokes — and
   the classes it is given (`class="size-4"`). Decorative unless it has an aria-label, as lucide-react's are. *@
@import { MarkupString } from "@tsazor/runtime"
@import type { IconNode } from "lucide"
@import { cn } from "@/lib/cn"

<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
     stroke-width="@strokeWidth" stroke-linecap="round" stroke-linejoin="round" @attributes="@this.attributes">@(new MarkupString(this.drawing))</svg>

@code {
    /** The icon (lucide's `Users`, `Plus`, …). */
    @Parameter() icon!: IconNode;
    /** lucide-react's `strokeWidth`. */
    @Parameter() strokeWidth: number = 2;
    /** `class`, `aria-label`, … on the `<svg>`. */
    @Parameter({ captureUnmatchedValues: true }) additionalAttributes?: Record<string, unknown>;

    private get attributes(): Record<string, unknown> {
        const labelled = this.additionalAttributes?.["aria-label"] !== undefined;
        return {
            "aria-hidden": labelled ? null : "true",
            ...this.additionalAttributes,
            class: cn("lucide", this.additionalAttributes?.class as string | undefined),
        };
    }

    /** The SVG's elements as markup: lucide's drawings are trusted package data, never user input. */
    private get drawing(): string {
        const escape = (value: string): string => value.replace(/&/g, "&amp;").replace(/"/g, "&quot;").replace(/</g, "&lt;");
        return this.icon
            .map(([tag, attributes]) => `<${tag} ${Object.entries(attributes).map(([name, value]) => `${name}="${escape(String(value))}"`).join(" ")}/>`)
            .join("");
    }
}
