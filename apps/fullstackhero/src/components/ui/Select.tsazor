@* components/ui/select.tsx: the filter Select — a single-select dropdown on the DropdownMenu (a trigger in the outline
   Button's language, the selected option with a brand check and tint), optionally labelled before the trigger. With a
   `placeholder`, a leading option "" (e.g. "All statuses", "Any role") clears the filter. React's value/onChange is
   `@bind-value`. (The form-field variant, list/select.tsx, is FormSelect here — two components can't share a name
   in one namespace.) *@
@import { Check, ChevronDown } from "lucide"
@import type { SelectOption } from "./select-option"

<div class="@cn("flex items-center gap-2", additionalAttributes?.class as string)">
    @if (label) {
        <span class="shrink-0 font-mono text-[0.6875rem] uppercase tracking-[0.18em] text-[var(--color-muted-foreground)]">@label</span>
    }

    <DropdownMenu>
        <DropdownMenuTrigger disabled="@disabled" style="min-width: @minWidth"
                             class="@cn("group inline-flex h-9 items-center justify-between gap-2 rounded-lg border border-[var(--color-input)]", "bg-[var(--color-card)] px-3 py-2 text-sm font-sans shadow-xs", value !== "" ? "text-[var(--color-foreground)]" : "text-[var(--color-muted-foreground)]", "transition-[border-color,box-shadow,background-color] duration-[var(--duration-fast)] ease-[var(--ease-out-cubic)]", "hover:border-[var(--color-border-strong)] hover:bg-[var(--color-accent)]", "focus-visible:outline-none focus-visible:border-[var(--color-ring)] focus-visible:ring-[3px] focus-visible:ring-[oklch(from_var(--color-ring)_l_c_h_/_0.5)]", "data-[state=open]:border-[var(--color-ring)] data-[state=open]:ring-[3px] data-[state=open]:ring-[oklch(from_var(--color-ring)_l_c_h_/_0.5)]", "disabled:cursor-not-allowed disabled:opacity-50")">
            <span class="truncate">@displayLabel</span>
            <Icon icon="@ChevronDown" class="h-4 w-4 shrink-0 text-[var(--color-muted-foreground)] transition-transform duration-[var(--duration-fast)] ease-[var(--ease-out-cubic)] group-data-[state=open]:rotate-180" />
        </DropdownMenuTrigger>

        <DropdownMenuContent align="start" style="min-width: @minWidth" class="py-1">
            @foreach (const option of allOptions) {
                <DropdownMenuItem @key="@(option.value || "__empty__")" onSelect="@(() => valueChanged?.invokeAsync(option.value))"
                                  class="@cn(option.value === value && ["bg-[oklch(from_var(--color-primary)_l_c_h_/_0.08)]", "text-[var(--color-primary)]", "data-[highlighted]:bg-[oklch(from_var(--color-primary)_l_c_h_/_0.12)]", "data-[highlighted]:text-[var(--color-primary)]"])">
                    <span class="flex-1 truncate">
                        @option.label
                        @if (option.hint) {
                            <span class="ml-1.5 text-[var(--color-muted-foreground)] text-xs">— @option.hint</span>
                        }
                    </span>
                    @if (option.value === value) {
                        <Icon icon="@Check" class="ml-auto h-3.5 w-3.5 shrink-0 text-[var(--color-primary)]" />
                    }
                </DropdownMenuItem>
            }
        </DropdownMenuContent>
    </DropdownMenu>
</div>

@code {
    /** Currently-selected value. "" is the "all / empty" state. */
    @Parameter() value: string = "";
    @Parameter() valueChanged?: EventCallback<string>;
    @Parameter() options: readonly SelectOption[] = [];
    /** A leading option with value "" and this label; picking it reports "". */
    @Parameter() placeholder?: string;
    /** Optional visible label rendered before the trigger button. */
    @Parameter() label?: string;
    @Parameter() disabled: boolean = false;
    /** Minimum width applied to both trigger and content. Defaults to 10rem. */
    @Parameter() minWidth: string = "10rem";
    @Parameter({ captureUnmatchedValues: true }) additionalAttributes?: Record<string, unknown>;

    private get allOptions(): SelectOption[] {
        return this.placeholder ? [{ value: "", label: this.placeholder }, ...this.options] : [...this.options];
    }

    private get displayLabel(): string {
        const current = this.allOptions.find((option) => option.value === this.value) ?? (this.placeholder ? { value: "", label: this.placeholder } : this.allOptions[0]);
        return current?.label ?? this.placeholder ?? "Select…";
    }
}
