@* components/ui/table.tsx's TableHead. *@
@import { withClass } from "@/lib/attributes"

<th @attributes="@withClass("h-10 px-3 text-left align-middle font-mono text-[10.5px] font-medium uppercase tracking-[var(--tracking-meta)] text-[var(--color-muted-foreground)]", additionalAttributes)">@childContent</th>

@code {
    @Parameter() childContent?: RenderFragment;
    @Parameter({ captureUnmatchedValues: true }) additionalAttributes?: Record<string, unknown>;
}
