@* components/ui/table.tsx's TableRow. *@
@import { withClass } from "@/lib/attributes"

<tr @attributes="@withClass("border-b border-[var(--color-border)] transition-colors hover:bg-[var(--color-accent)] data-[state=selected]:bg-[var(--color-accent)]", additionalAttributes)">@childContent</tr>

@code {
    @Parameter() childContent?: RenderFragment;
    @Parameter({ captureUnmatchedValues: true }) additionalAttributes?: Record<string, unknown>;
}
