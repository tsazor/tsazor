@* pages/dashboard.tsx: the operator overview — the EntityPageHeader greeting, four KPI tiles drawing from real data,
   then pivot cards into the rest of the app. *@
@page "/"
@authorize
@import { Building2, FileText, LayoutDashboard, Receipt, UsersRound } from "lucide"
@import { listTenants } from "@/api/tenants"
@import { getPlans, listInvoices } from "@/api/billing"
@import { Query } from "@/lib/query"
@import PivotCard from "./PivotCard.tsazor"
@inject AuthService auth

<div class="space-y-6">
    @* ── Page header ──────────────────────────────────────────────── *@
    <div class="fsh-enter">
        <EntityPageHeader icon="@LayoutDashboard" tone="primary"
                          description="Operate every tenant on this instance — identity, multitenancy, billing, and the rest of the system surface.">
            <TitleContent><text>Overview</text>@if (firstName) {<span class="text-[var(--color-muted-foreground)]">, @firstName</span>}</TitleContent>
        </EntityPageHeader>
    </div>

    @* ── KPI stat strip ───────────────────────────────────────────── *@
    <StatStrip cols="4" class="fsh-enter fsh-enter-2">
        <Stat label="Tenants" hint="registered on this instance">
            <ValueContent>
                @if (tenants.result.isLoading) { <Skeleton class="h-7 w-16" /> } else { @(tenants.result.data?.totalCount.toLocaleString() ?? "—") }
            </ValueContent>
        </Stat>
        <Stat label="Plans" hint="@(`${activePlans} active`)">
            <ValueContent>
                @if (plans.result.isLoading) { <Skeleton class="h-7 w-16" /> } else { @planList.length.toLocaleString() }
            </ValueContent>
        </Stat>
        <Stat label="Invoices" hint="@(invoicesPage ? `${invoicesPage.totalCount.toLocaleString()} total ledger` : "loading…")">
            <ValueContent>
                @if (invoices.result.isLoading) { <Skeleton class="h-7 w-16" /> } else { @(invoicesPage?.items.length.toLocaleString() ?? "—") }
            </ValueContent>
        </Stat>
        <Stat label="Outstanding" hint="issued, awaiting payment" tone="@(outstandingCount > 0 ? "warning" : "default")">
            <ValueContent>
                @if (invoices.result.isLoading) { <Skeleton class="h-7 w-16" /> } else { @outstandingCount.toLocaleString() }
            </ValueContent>
        </Stat>
    </StatStrip>

    @* ── Quick pivots ─────────────────────────────────────────────── *@
    <section class="fsh-enter fsh-enter-3 space-y-3">
        <p class="text-[11px] font-semibold uppercase tracking-wider text-[var(--color-muted-foreground)]">Entry points</p>
        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
            <PivotCard to="/tenants" icon="@Building2" tone="info" title="Tenants" description="Provision, suspend, and inspect tenants." />
            <PivotCard to="/users" icon="@UsersRound" tone="primary" title="Users" description="Root-tenant operators and role management." />
            <PivotCard to="/billing/plans" icon="@Receipt" tone="success" title="Billing" description="Plans, subscriptions, invoices and pricing." />
            <PivotCard to="/billing/invoices" icon="@FileText" tone="warning" title="Invoices" description="Cross-tenant ledger. Issue, mark paid, void." />
        </div>
    </section>
</div>

@code {
    private readonly tenants = new Query(() => ({
        queryKey: ["tenants", { pageNumber: 1, pageSize: 1 }],
        queryFn: () => listTenants({ pageNumber: 1, pageSize: 1 }),
    }));
    private readonly plans = new Query(() => ({
        queryKey: ["billing", "plans", { includeInactive: true }],
        queryFn: () => getPlans(true),
    }));
    private readonly invoices = new Query(() => ({
        queryKey: ["billing", "invoices", { pageNumber: 1, pageSize: 50 }],
        queryFn: () => listInvoices({ pageNumber: 1, pageSize: 50 }),
    }));

    protected override onInitialized(): void {
        this.observe(this.auth.changes);
        this.observe(this.tenants);
        this.observe(this.plans);
        this.observe(this.invoices);
    }

    private get planList() {
        return this.plans.result.data ?? [];
    }

    private get activePlans(): number {
        return this.planList.filter((plan) => plan.isActive).length;
    }

    private get invoicesPage() {
        return this.invoices.result.data;
    }

    private get outstandingCount(): number {
        return this.invoicesPage?.items.filter((invoice) => invoice.status === "Issued").length ?? 0;
    }

    private get firstName(): string | undefined {
        return this.auth.user?.name?.split(" ")[0];
    }
}
