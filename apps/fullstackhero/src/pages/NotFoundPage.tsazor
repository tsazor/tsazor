@* pages/not-found.tsx: the calm centered "page not found" card — atmospheric orbs, a muted icon tile, the requested
   path, the way home and back. The Router's NotFound (routes.tsx: `path: "*"`). *@
@import { ArrowLeft, FileQuestion, Home } from "lucide"
@import { buttonVariants } from "@/components/ui/variants"
@inject NavigationManager navigation

<div class="relative flex min-h-screen items-center justify-center overflow-hidden bg-[var(--color-background)] px-5 py-8 sm:py-12">
    @* Atmospheric background — same primary/saffron orbs as the auth pages *@
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
        <div class="absolute -top-[25%] -left-[15%] h-[70vw] w-[70vw] rounded-full blur-[140px]" style="background-color: oklch(from var(--color-primary) l c h / 0.05)"></div>
        <div class="absolute -bottom-[20%] -right-[10%] h-[55vw] w-[55vw] rounded-full blur-[120px]" style="background-color: oklch(from var(--color-saffron, var(--color-primary)) l c h / 0.07)"></div>
    </div>

    <div class="relative z-10 flex w-full max-w-[460px] flex-col items-center text-center fsh-enter fsh-enter-1">
        <div class="mb-5 grid size-14 place-items-center rounded-2xl bg-[var(--color-muted)]">
            <Icon icon="@FileQuestion" class="size-6 text-[oklch(from_var(--color-muted-foreground)_l_c_h_/_0.5)]" />
        </div>

        <h1 class="mb-2 font-display text-[clamp(1.5rem,5vw,2rem)] font-semibold tracking-tight text-[var(--color-foreground)]">Page not found</h1>
        <p class="mb-2 max-w-[380px] text-[14px] leading-relaxed text-[var(--color-muted-foreground)]">
            We couldn't find anything at that address. It may be a stale link, a renamed route, or a path that never existed.
        </p>

        @* Requested path — soft inline display *@
        <p class="mb-7 inline-flex max-w-full items-center gap-1.5 text-[12px] text-[var(--color-muted-foreground)]" title="@requested">
            <span class="text-[oklch(from_var(--color-muted-foreground)_l_c_h_/_0.6)]">Requested</span>
            <span class="truncate text-[var(--color-foreground)]">@requested</span>
        </p>

        @* Primary actions *@
        <div class="flex w-full flex-col items-center gap-2 sm:flex-row sm:justify-center">
            <a href="/" class="@cn(buttonVariants(), "group h-11 px-5 text-[14px] font-semibold")">
                <Icon icon="@Home" class="size-4" />
                <span>Back home</span>
            </a>
        </div>

        @* Tertiary — go-back *@
        <button type="button" @onclick="() => history.back()" class="mt-5 inline-flex items-center gap-1.5 text-[12px] text-[var(--color-muted-foreground)] transition-colors hover:text-[var(--color-foreground)]">
            <Icon icon="@ArrowLeft" class="size-3.5" />
            <span>Go back to the previous page</span>
        </button>
    </div>
</div>

@code {
    private get requested(): string {
        const url = new URL(this.navigation.uri);
        return url.pathname + url.search;
    }
}
