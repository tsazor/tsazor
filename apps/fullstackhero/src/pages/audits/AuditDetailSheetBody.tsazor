@* pages/audits/detail.tsx's AuditDetailSheetBody: the sheet's content — a header with the event type and time and the
   Close button, then the scrolling body: identity, correlation ids, context tiles and the JSON payload. *@
@import { ScrollText, X } from "lucide"
@import { getAudit, type AuditDetailDto } from "@/api/audits"
@import { ApiRequestError } from "@/lib/api-client"
@import { Query } from "@/lib/query"
@import { formatEventType, formatTimestamp } from "./audit-detail-format"
@import IdentityBand from "./IdentityBand.tsazor"
@import CorrelationBand from "./CorrelationBand.tsazor"
@import ContextGrid from "./ContextGrid.tsazor"
@import PayloadPanel from "./PayloadPanel.tsazor"

<div class="flex h-full flex-col">
    @* Header *@
    <div class="flex items-start justify-between gap-3 border-b border-[var(--color-border)] px-6 py-5">
        <div class="flex items-center gap-2.5">
            <span class="grid h-8 w-8 shrink-0 place-items-center rounded-lg bg-[var(--color-muted)]">
                <Icon icon="@ScrollText" class="h-4 w-4 text-[var(--color-muted-foreground)]" />
            </span>
            <div>
                <div class="text-[13px] font-semibold leading-tight tracking-tight text-[var(--color-foreground)]">
                    @(event ? `${formatEventType(event.eventType)} event` : "Audit event")
                </div>
                <div class="mt-0.5 font-mono text-[10.5px] text-[var(--color-muted-foreground)]">
                    @(event ? formatTimestamp(event.occurredAtUtc) : "Loading…")
                </div>
            </div>
        </div>
        <button type="button" aria-label="Close" @onclick="() => onClose?.invokeAsync()" class="@closeClass">
            <Icon icon="@X" class="h-4 w-4" />
        </button>
    </div>

    @* Scrollable body *@
    <div class="min-h-0 flex-1 overflow-y-auto">
        @if (query.result.isLoading && !event) {
            <div class="p-6">
                <LoadingRow label="Loading event" />
            </div>
        }

        @if (query.result.isError) {
            <div class="p-6">
                <ErrorBand message="@(query.result.error instanceof ApiRequestError ? query.result.error.problem?.detail ?? query.result.error.message : "Failed to load event.")" />
            </div>
        }

        @if (event) {
            <div class="space-y-0 divide-y divide-[var(--color-border)]">
                <IdentityBand event="@event" />
                <CorrelationBand event="@event" />
                <ContextGrid event="@event" />
                @* `unknown` spelled out: a component parameter's value is an AttributeValue to `tsazor check`, which
                   excludes `unknown` (Blazor's AddAttribute takes any object). *@
                <PayloadPanel payload="@event.payload" />
            </div>
        }
    </div>
</div>

@code {
    @Parameter() auditId: string | null = null;
    @Parameter() onClose?: EventCallback;

    private readonly query = new Query(() => {
        const auditId = this.auditId;
        return {
            queryKey: ["audits", auditId],
            queryFn: () => getAudit(auditId!),
            enabled: Boolean(auditId),
            staleTime: 60_000,
        };
    });

    private readonly closeClass = cn(
        "grid h-7 w-7 shrink-0 place-items-center rounded-md",
        "text-[var(--color-muted-foreground)] transition-colors",
        "hover:bg-[var(--color-accent)] hover:text-[var(--color-foreground)]",
        "focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-ring)]",
    );

    protected override onInitialized(): void {
        this.observe(this.query);
    }

    private get event(): AuditDetailDto | undefined {
        return this.query.result.data;
    }
}
