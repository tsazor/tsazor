@* pages/auth/forgot-password.tsx: Forgot-password — admin variant. Same security contract as the dashboard variant:
   server returns 200 for any input, so the UI must NOT branch on response shape to imply account existence. Always
   render the same "check your inbox" success. A signed-in user goes to "/" (the original's <Navigate replace />).
   The request is the original's mutation as a plain handler; React's `autoFocus` (a focus() on mount, not the HTML
   attribute) is an attachment on the field's wrapper, since the shared Input doesn't take one. *@
@page "/forgot-password"
@layout BlankLayout
@import { AlertCircle, ArrowRight, Building2, Check, Loader2, Mail, MailCheck, ShieldCheck } from "lucide"
@import type { Attachment } from "@tsazor/runtime"
@import { requestPasswordReset } from "@/api/users"
@import { ApiRequestError } from "@/lib/api-client"
@import { env } from "@/env"
@import BlankLayout from "@/layouts/BlankLayout.tsazor"
@inject AuthService auth
@inject NavigationManager navigation

<div class="relative flex min-h-screen items-center justify-center overflow-hidden bg-[var(--color-background)] px-5 py-8 sm:py-12">
    @* Atmospheric background orbs *@
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
        <div class="absolute -top-[25%] -left-[15%] h-[70vw] w-[70vw] rounded-full blur-[140px]" style="background-color: oklch(from var(--color-primary) l c h / 0.05)"></div>
        <div class="absolute -bottom-[20%] -right-[10%] h-[55vw] w-[55vw] rounded-full blur-[120px]" style="background-color: oklch(from var(--color-saffron, var(--color-primary)) l c h / 0.07)"></div>
        <div class="absolute top-[10%] right-[5%] h-[30vw] w-[30vw] rounded-full blur-[80px]" style="background-color: oklch(from var(--color-primary) l c h / 0.025)"></div>
    </div>

    @* Card column *@
    <div class="relative z-10 w-full max-w-[420px] fsh-enter fsh-enter-1">
        @* Brand lockup *@
        <div class="mb-8 flex flex-col items-center">
            <div class="flex items-center gap-2.5">
                <img src="/logo-fullstackhero.png" alt="fullstackhero" class="size-9 object-contain" />
                <span class="font-display text-[26px] font-semibold tracking-tight text-[var(--color-foreground)]">fullstack<span class="text-[var(--color-primary)]">hero</span></span>
            </div>
            <div class="mt-3 flex items-center gap-2 text-[10px] font-semibold uppercase tracking-[0.2em] text-[oklch(from_var(--color-muted-foreground)_l_c_h_/_0.7)]">
                <span aria-hidden="true" class="h-px w-6 bg-[var(--color-border)]"></span>
                <span>.NET 10 Starter Kit</span>
                <span aria-hidden="true" class="h-px w-6 bg-[var(--color-border)]"></span>
            </div>
        </div>

        @* Form card *@
        <div class="rounded-xl border border-[var(--color-border)] bg-[oklch(from_var(--color-card)_l_c_h_/_0.85)] shadow-[0_1px_3px_oklch(0_0_0_/_0.04),0_8px_24px_oklch(0_0_0_/_0.06)] backdrop-blur-xl">
            <div class="px-6 py-7 sm:px-8 sm:py-9">
                @if (submitted) {
                    <div class="fsh-enter space-y-5 text-center">
                        <div class="grid place-items-center">
                            <span aria-hidden="true" class="grid size-14 place-items-center rounded-2xl bg-[oklch(from_var(--color-success)_l_c_h_/_0.10)] text-[var(--color-success)]">
                                <Icon icon="@MailCheck" class="size-6" />
                            </span>
                        </div>
                        <div>
                            <h1 class="mb-1.5 font-display text-[22px] font-semibold tracking-tight text-[var(--color-foreground)]">
                                Check your <span class="text-[var(--color-primary)]">inbox</span>
                            </h1>
                            <p class="text-[13px] leading-relaxed text-[var(--color-muted-foreground)]">
                                If an account exists for <span class="text-[var(--color-foreground)]">@email</span> in tenant <span class="text-[var(--color-foreground)]">@tenant</span>, a one-time
                                reset link is on its way. The link expires in 30 minutes.
                            </p>
                        </div>
                        <ul class="space-y-1.5 text-left text-[12.5px] text-[var(--color-muted-foreground)]">
                            <li class="flex items-start gap-2">
                                <Icon icon="@Check" class="mt-0.5 size-3.5 shrink-0 text-[var(--color-success)]" />
                                Didn't get it? Wait a minute, then check spam.
                            </li>
                            <li class="flex items-start gap-2">
                                <Icon icon="@Check" class="mt-0.5 size-3.5 shrink-0 text-[var(--color-success)]" />
                                Still nothing? Confirm the email + tenant and retry.
                            </li>
                        </ul>
                        <div class="flex items-center gap-2 pt-1">
                            <Button type="button" variant="ghost" onClick="@tryAgain">Try a different address</Button>
                            <a href="/login" class="ml-auto">
                                <Button type="button" variant="outline">Back to sign in</Button>
                            </a>
                        </div>
                    </div>
                } else {
                    <div class="mb-6 sm:mb-8">
                        <h1 class="mb-1.5 font-display text-[22px] font-semibold tracking-tight text-[var(--color-foreground)]">
                            Reset your <span class="text-[var(--color-primary)]">password</span>
                        </h1>
                        <p class="text-[13px] text-[var(--color-muted-foreground)]">
                            Enter the email + tenant you sign in with. We'll dispatch a one-time link.
                        </p>
                    </div>

                    <form @onsubmit="onSubmit" @onsubmit:preventDefault class="space-y-5" novalidate aria-describedby="@(error ? "forgot-error" : null)">
                        <div class="space-y-1.5">
                            <Label for="reset-tenant" class="block text-[11.5px] font-semibold uppercase tracking-wider text-[var(--color-muted-foreground)]">Tenant</Label>
                            <div class="relative">
                                <Icon icon="@Building2" class="pointer-events-none absolute left-3.5 top-1/2 size-4 -translate-y-1/2 text-[oklch(from_var(--color-muted-foreground)_l_c_h_/_0.6)]" />
                                <Input id="reset-tenant" @bind-value="tenant" required autocomplete="organization" placeholder="root"
                                       aria-invalid="@(error ? "true" : null)" aria-describedby="@(error ? "forgot-error" : null)" class="h-11 pl-10 text-[14px]" />
                            </div>
                        </div>
                        <div class="space-y-1.5">
                            <Label for="reset-email" class="block text-[11.5px] font-semibold uppercase tracking-wider text-[var(--color-muted-foreground)]">Email</Label>
                            <div class="relative" @attach="autoFocus">
                                <Icon icon="@Mail" class="pointer-events-none absolute left-3.5 top-1/2 size-4 -translate-y-1/2 text-[oklch(from_var(--color-muted-foreground)_l_c_h_/_0.6)]" />
                                <Input id="reset-email" type="email" @bind-value="email" required autocomplete="email" placeholder="operator@root.example"
                                       aria-invalid="@(error ? "true" : null)" aria-describedby="@(error ? "forgot-error" : null)" class="h-11 pl-10 text-[14px]" />
                            </div>
                        </div>

                        @if (error) {
                            <div id="forgot-error" role="alert"
                                 class="@cn("fsh-enter flex items-start gap-2 rounded-lg border px-3 py-2 text-sm", "border-[oklch(from_var(--color-destructive)_l_c_h_/_0.30)]", "bg-[oklch(from_var(--color-destructive)_l_c_h_/_0.06)]", "text-[var(--color-destructive)]")">
                                <Icon icon="@AlertCircle" class="mt-0.5 size-4 shrink-0" />
                                <span class="leading-snug">@error</span>
                            </div>
                        }

                        <div class="pt-1.5">
                            <Button type="submit" disabled="@(pending || !email || !tenant)" class="group h-11 w-full text-[14px] font-semibold">
                                @if (pending) {
                                    <Icon icon="@Loader2" class="size-4 animate-spin" />
                                    <span>Dispatching link…</span>
                                } else {
                                    <span>Send reset link</span>
                                    <Icon icon="@ArrowRight" class="size-[14px] opacity-60 transition-all duration-200 group-hover:translate-x-0.5 group-hover:opacity-100" />
                                }
                            </Button>
                        </div>
                    </form>
                }
            </div>
        </div>

        <div class="mt-6 text-center text-[12.5px] text-[var(--color-muted-foreground)]">
            Remembered it? <a href="/login" class="text-[var(--color-foreground)] underline-offset-4 hover:underline">Sign in</a>
        </div>

        <div class="mt-4 flex items-center justify-center gap-1.5 text-[11px] text-[var(--color-muted-foreground)]">
            <Icon icon="@ShieldCheck" class="size-3" />
            <span>Encrypted in transit · JWT-secured session</span>
        </div>
    </div>
</div>

@code {
    private email = "";
    private tenant = env.defaultTenant;
    private submitted = false;
    private error: string | null = null;
    private pending = false;

    /** React's autoFocus: the field's input takes the focus when it mounts. */
    private readonly autoFocus: Attachment<HTMLElement> = (element) => element.querySelector("input")?.focus();

    protected override onInitialized(): void {
        this.observe(this.auth.changes, () => this.leaveIfSignedIn());
        this.leaveIfSignedIn();
    }

    /** The original's `if (isAuthenticated) return <Navigate to="/" replace />`. */
    private leaveIfSignedIn(): void {
        if (this.auth.isAuthenticated) this.navigation.navigateTo("/", { replaceHistoryEntry: true });
    }

    private async onSubmit(): Promise<void> {
        this.error = null;
        this.pending = true;
        try {
            await requestPasswordReset({ email: this.email, tenant: this.tenant });
            this.submitted = true;
        } catch (err) {
            this.error =
                err instanceof ApiRequestError
                    ? err.problem?.detail ?? err.problem?.title ?? err.message
                    : (err as Error).message;
        } finally {
            this.pending = false;
        }
    }

    private tryAgain(): void {
        this.submitted = false;
        this.error = null;
    }
}
