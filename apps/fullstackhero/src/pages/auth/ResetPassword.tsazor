@* pages/auth/reset-password.tsx: the emailed link's landing — token, email and tenant come from the query string
   (useSearchParams → SupplyParameterFromQuery); a link missing one of them gets the "incomplete" card. The new
   password has a strength meter and a match hint; success toasts and replaces the entry with /login. A signed-in
   user goes to "/". Typing clears the error (the original's effect on password and confirm: `@bind-value:after`). *@
@page "/reset-password"
@layout BlankLayout
@import { AlertCircle, ArrowRight, Check, Eye, EyeOff, Loader2, ShieldCheck } from "lucide"
@import { SupplyParameterFromQuery, type Attachment } from "@tsazor/runtime"
@import { resetPassword } from "@/api/users"
@import { ApiRequestError } from "@/lib/api-client"
@import { toast } from "@/lib/toast"
@import BlankLayout from "@/layouts/BlankLayout.tsazor"
@import { scorePassword, STRENGTH_META } from "./password-strength"
@inject AuthService auth
@inject NavigationManager navigation

<div class="relative flex min-h-screen items-center justify-center overflow-hidden bg-[var(--color-background)] px-5 py-8 sm:py-12">
    @* Atmospheric background orbs *@
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
        <div class="absolute -top-[25%] -left-[15%] h-[70vw] w-[70vw] rounded-full blur-[140px]" style="background-color: oklch(from var(--color-primary) l c h / 0.05)"></div>
        <div class="absolute -bottom-[20%] -right-[10%] h-[55vw] w-[55vw] rounded-full blur-[120px]" style="background-color: oklch(from var(--color-saffron, var(--color-primary)) l c h / 0.07)"></div>
        <div class="absolute top-[10%] right-[5%] h-[30vw] w-[30vw] rounded-full blur-[80px]" style="background-color: oklch(from var(--color-primary) l c h / 0.025)"></div>
    </div>

    @* Card column *@
    <div class="relative z-10 w-full max-w-[420px] fsh-enter fsh-enter-1">
        @* Brand lockup *@
        <div class="mb-8 flex flex-col items-center">
            <div class="flex items-center gap-2.5">
                <img src="/logo-fullstackhero.png" alt="fullstackhero" class="size-9 object-contain" />
                <span class="font-display text-[26px] font-semibold tracking-tight text-[var(--color-foreground)]">fullstack<span class="text-[var(--color-primary)]">hero</span></span>
            </div>
            <div class="mt-3 flex items-center gap-2 text-[10px] font-semibold uppercase tracking-[0.2em] text-[oklch(from_var(--color-muted-foreground)_l_c_h_/_0.7)]">
                <span aria-hidden="true" class="h-px w-6 bg-[var(--color-border)]"></span>
                <span>.NET 10 Starter Kit</span>
                <span aria-hidden="true" class="h-px w-6 bg-[var(--color-border)]"></span>
            </div>
        </div>

        @* Form card *@
        <div class="rounded-xl border border-[var(--color-border)] bg-[oklch(from_var(--color-card)_l_c_h_/_0.85)] shadow-[0_1px_3px_oklch(0_0_0_/_0.04),0_8px_24px_oklch(0_0_0_/_0.06)] backdrop-blur-xl">
            <div class="px-6 py-7 sm:px-8 sm:py-9">
                @if (malformed) {
                    <div class="space-y-4">
                        <div class="mb-2">
                            <h1 class="mb-1.5 font-display text-[22px] font-semibold tracking-tight text-[var(--color-foreground)]">
                                This link is <span class="text-[var(--color-primary)]">incomplete</span>
                            </h1>
                            <p class="text-[13px] leading-relaxed text-[var(--color-muted-foreground)]">
                                The link is missing one of <span class="text-[var(--color-foreground)]">token</span>, <span class="text-[var(--color-foreground)]">email</span>, or <span class="text-[var(--color-foreground)]">tenant</span>. Some email
                                clients clip long URLs — try copy-pasting the full link from the original
                                email into your browser's address bar, or request a new one.
                            </p>
                        </div>
                        <div class="flex gap-2 pt-1">
                            <a href="/forgot-password">
                                <Button type="button" variant="outline">Request a new link</Button>
                            </a>
                            <a href="/login">
                                <Button type="button" variant="ghost">Back to sign in</Button>
                            </a>
                        </div>
                    </div>
                } else {
                    <div class="mb-6 sm:mb-8">
                        <h1 class="mb-1.5 font-display text-[22px] font-semibold tracking-tight text-[var(--color-foreground)]">
                            Set a new <span class="text-[var(--color-primary)]">password</span>
                        </h1>
                        <p class="text-[13px] text-[var(--color-muted-foreground)]">
                            Resetting password for <span class="text-[var(--color-foreground)]">@email</span> on <span class="text-[var(--color-foreground)]">@tenant</span>.
                        </p>
                    </div>

                    <form @onsubmit="onSubmit" @onsubmit:preventDefault class="space-y-5" novalidate aria-describedby="@(error ? "reset-error" : null)">
                        <div class="space-y-1.5">
                            <Label for="new-password" class="block text-[11.5px] font-semibold uppercase tracking-wider text-[var(--color-muted-foreground)]">New password</Label>
                            <div class="relative" @attach="autoFocus">
                                <Input id="new-password" type="@(showPassword ? "text" : "password")" @bind-value="password" @bind-value:after="clearError"
                                       required autocomplete="new-password" minlength="8" placeholder="At least 8 characters"
                                       aria-invalid="@(error ? "true" : null)" aria-describedby="@(error ? "reset-error" : null)" class="h-11 pr-11 text-[14px]" />
                                <button type="button" @onclick="() => showPassword = !showPassword" aria-label="@(showPassword ? "Hide password" : "Show password")"
                                        class="absolute right-3.5 top-1/2 grid h-6 w-6 -translate-y-1/2 cursor-pointer place-items-center rounded text-[var(--color-muted-foreground)] transition-colors hover:text-[var(--color-foreground)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-ring)]">
                                    <Icon icon="@(showPassword ? EyeOff : Eye)" class="size-4" />
                                </button>
                            </div>
                            @if (strength) {
                                <div class="fsh-enter flex items-center gap-2 pt-1.5">
                                    <div class="h-1 flex-1 overflow-hidden rounded-full bg-[var(--color-muted)]">
                                        <div class="@cn("h-full transition-all duration-200", STRENGTH_META[strength].fill, STRENGTH_META[strength].bar)"></div>
                                    </div>
                                    <span class="min-w-[3.5rem] text-right text-[10px] font-semibold uppercase tracking-wider text-[var(--color-muted-foreground)]">@(STRENGTH_META[strength].label)</span>
                                </div>
                            }
                        </div>

                        <div class="space-y-1.5">
                            <Label for="confirm-password" class="block text-[11.5px] font-semibold uppercase tracking-wider text-[var(--color-muted-foreground)]">Confirm password</Label>
                            <div class="relative">
                                <Input id="confirm-password" type="@(showConfirm ? "text" : "password")" @bind-value="confirm" @bind-value:after="clearError"
                                       required autocomplete="new-password" minlength="8" placeholder="Re-enter password"
                                       aria-invalid="@(error ? "true" : null)" aria-describedby="@(error ? "reset-error" : null)" class="h-11 pr-11 text-[14px]" />
                                <button type="button" @onclick="() => showConfirm = !showConfirm" aria-label="@(showConfirm ? "Hide password" : "Show password")"
                                        class="absolute right-3.5 top-1/2 grid h-6 w-6 -translate-y-1/2 cursor-pointer place-items-center rounded text-[var(--color-muted-foreground)] transition-colors hover:text-[var(--color-foreground)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-ring)]">
                                    <Icon icon="@(showConfirm ? EyeOff : Eye)" class="size-4" />
                                </button>
                            </div>
                            @if (confirm.length > 0) {
                                <div class="@cn("flex items-center gap-1.5 pt-1 text-[11.5px]", matches ? "text-[var(--color-success)]" : "text-[var(--color-muted-foreground)]")">
                                    <Icon icon="@Check" class="@cn("size-3.5", matches ? "opacity-100" : "opacity-40")" />
                                    <span>@(matches ? "Passwords match" : "Doesn't match yet")</span>
                                </div>
                            }
                        </div>

                        @if (error) {
                            <div id="reset-error" role="alert"
                                 class="@cn("fsh-enter flex items-start gap-2 rounded-lg border px-3 py-2 text-sm", "border-[oklch(from_var(--color-destructive)_l_c_h_/_0.30)]", "bg-[oklch(from_var(--color-destructive)_l_c_h_/_0.06)]", "text-[var(--color-destructive)]")">
                                <Icon icon="@AlertCircle" class="mt-0.5 size-4 shrink-0" />
                                <span class="leading-snug">@error</span>
                            </div>
                        }

                        <div class="pt-1.5">
                            <Button type="submit" disabled="@(pending || !matches || password.length < 8)" class="group h-11 w-full text-[14px] font-semibold">
                                @if (pending) {
                                    <Icon icon="@Loader2" class="size-4 animate-spin" />
                                    <span>Updating password…</span>
                                } else {
                                    <Icon icon="@ShieldCheck" class="size-4" />
                                    <span>Set new password</span>
                                    <Icon icon="@ArrowRight" class="size-[14px] opacity-60 transition-all duration-200 group-hover:translate-x-0.5 group-hover:opacity-100" />
                                }
                            </Button>
                        </div>
                    </form>
                }
            </div>
        </div>

        <div class="mt-6 text-center text-[12.5px] text-[var(--color-muted-foreground)]">
            Changed your mind? <a href="/login" class="text-[var(--color-foreground)] underline-offset-4 hover:underline">Sign in</a>
        </div>
    </div>
</div>

@code {
    @SupplyParameterFromQuery() token: string | null = null;
    @SupplyParameterFromQuery() email: string | null = null;
    @SupplyParameterFromQuery() tenant: string | null = null;

    private password = "";
    private confirm = "";
    private error: string | null = null;
    private showPassword = false;
    private showConfirm = false;
    private pending = false;

    /** React's autoFocus: the field's input takes the focus when it mounts. */
    private readonly autoFocus: Attachment<HTMLElement> = (element) => element.querySelector("input")?.focus();

    protected override onInitialized(): void {
        this.observe(this.auth.changes, () => this.leaveIfSignedIn());
        this.leaveIfSignedIn();
    }

    private get malformed(): boolean {
        return !this.token || !this.email || !this.tenant;
    }

    private get strength() {
        return scorePassword(this.password);
    }

    private get matches(): boolean {
        return this.password.length > 0 && this.password === this.confirm;
    }

    /** The original's `if (isAuthenticated) return <Navigate to="/" replace />`. */
    private leaveIfSignedIn(): void {
        if (this.auth.isAuthenticated) this.navigation.navigateTo("/", { replaceHistoryEntry: true });
    }

    private clearError(): void {
        this.error = null;
    }

    private async onSubmit(): Promise<void> {
        if (!this.matches) {
            this.error = "Passwords don't match.";
            return;
        }
        if (this.password.length < 8) {
            this.error = "Use at least 8 characters.";
            return;
        }
        this.pending = true;
        try {
            await resetPassword({ email: this.email ?? "", password: this.password, token: this.token ?? "", tenant: this.tenant ?? "" });
            toast.success("Password updated", {
                description: "Sign in with your new password to continue.",
            });
            this.navigation.navigateTo("/login", { replaceHistoryEntry: true });
        } catch (err) {
            this.error =
                err instanceof ApiRequestError
                    ? err.problem?.detail ?? err.problem?.title ?? err.message
                    : (err as Error).message;
        } finally {
            this.pending = false;
        }
    }
}
