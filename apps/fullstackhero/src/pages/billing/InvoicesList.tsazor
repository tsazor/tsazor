@* pages/billing/invoices-list.tsx: the cross-tenant invoice ledger — a KPI strip over the current page, the filters
   (tenant, status, period year and month; AND-combined, each change back to page 1), the invoices of the page (a row
   opens the invoice) and the pagination. The previous page stays while the next loads (keepPreviousData). *@
@page "/billing/invoices"
@authorize({ policy: "Permissions.Billing.View" })
@layout BillingLayout
@import { ChevronLeft, ChevronRight, FileText, Filter, X } from "lucide"
@import { keepPreviousData } from "@tanstack/query-core"
@import { listInvoices, type InvoiceDto, type InvoiceStatus } from "@/api/billing"
@import { Query } from "@/lib/query"
@import { inputClass } from "@/components/ui/variants"
@import { describe, formatDate, formatMoney, formatPeriod, invoiceStatusVariant } from "@/components/billing/billing-format"
@import BillingLayout from "./BillingLayout.tsazor"
@inject NavigationManager navigation

<div class="space-y-6">
    @* KPI strip — page-scope (current page, not all-time) *@
    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
        <KpiTile label="Page invoices" subtitle="@(data ? `${data.totalCount.toLocaleString()} total` : "loading…")">
            <ValueContent>@if (query.result.isLoading) { <Skeleton class="h-7 w-16" /> } else { @(data?.items.length ?? 0) }</ValueContent>
        </KpiTile>
        <KpiTile label="Billed" subtitle="this page">
            <ValueContent>@if (query.result.isLoading) { <Skeleton class="h-7 w-24" /> } else { @formatMoney(totals.totalBilled, totals.currency) }</ValueContent>
        </KpiTile>
        <KpiTile label="Outstanding" subtitle="issued, awaiting payment">
            <ValueContent>@if (query.result.isLoading) { <Skeleton class="h-7 w-24" /> } else { @formatMoney(totals.outstanding, totals.currency) }</ValueContent>
        </KpiTile>
        <KpiTile label="Paid" subtitle="@(`${totals.paidCount} invoice${totals.paidCount === 1 ? "" : "s"}`)">
            <ValueContent>@if (query.result.isLoading) { <Skeleton class="h-7 w-24" /> } else { @formatMoney(totals.paid, totals.currency) }</ValueContent>
        </KpiTile>
    </div>

    @* Filter panel *@
    <Card>
        <CardHeader class="flex flex-row items-center justify-between gap-3">
            <div>
                <CardTitle class="flex items-center gap-2">
                    <Icon icon="@Filter" class="h-4 w-4 text-[var(--color-muted-foreground)]" />
                    <span>Filters</span>
                </CardTitle>
                <CardDescription>
                    All filters are AND-combined. Period is matched exactly (year + month).
                </CardDescription>
            </div>
            @if (filtersDirty) {
                <Button variant="ghost" size="sm" onClick="@clearFilters">
                    <Icon icon="@X" class="mr-1 h-3.5 w-3.5" /> Clear
                </Button>
            }
        </CardHeader>
        <CardContent class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
            <div class="space-y-1.5">
                <Label for="filter-tenant">Tenant</Label>
                <Input id="filter-tenant" placeholder="tenant identifier" @bind-Value="tenantFilter" @bind-Value:after="firstPage" autocomplete="off" />
            </div>
            <div class="space-y-1.5">
                <Label for="filter-status">Status</Label>
                <FormSelect id="filter-status" @bind-value="statusFilter" @bind-value:after="firstPage" options="@statusOptions" emptyLabel="All" />
            </div>
            @* The period inputs are Input's <input>: their handler writes the digits back (setPeriod). *@
            <div class="space-y-1.5">
                <Label for="filter-year">Year</Label>
                <input data-slot="input" id="filter-year" inputmode="numeric" placeholder="2026" class="@inputClass"
                       value="@periodYear" @oninput="@((event: Event) => setPeriod(event, "periodYear", 4))" />
            </div>
            <div class="space-y-1.5">
                <Label for="filter-month">Month</Label>
                <input data-slot="input" id="filter-month" inputmode="numeric" placeholder="1–12" class="@inputClass"
                       value="@periodMonth" @oninput="@((event: Event) => setPeriod(event, "periodMonth", 2))" />
            </div>
        </CardContent>
    </Card>

    @* List *@
    <Card>
        <CardHeader>
            <CardTitle>Invoices</CardTitle>
            <CardDescription>
                @if (data) {
                    <text>Page <span class="tabular-nums">@data.pageNumber</span> of <span class="tabular-nums">@Math.max(data.totalPages, 1)</span> · <span class="tabular-nums">@data.totalCount.toLocaleString()</span> total</text>
                } else {
                    <text>Loading…</text>
                }
            </CardDescription>
        </CardHeader>
        <CardContent class="p-0">
            @if (query.result.isError) {
                <div class="border-t border-[var(--color-border)] px-6 py-4 text-sm text-[var(--color-destructive)]">
                    @describe(query.result.error, "Failed to load invoices.")
                </div>
            }

            @if (query.result.isLoading && items.length === 0) {
                <ul class="divide-y divide-[var(--color-border)]">
                    @for (let i = 0; i < 5; i++) {
                        <li class="px-6 py-4">
                            <div class="flex items-center justify-between">
                                <div class="space-y-2">
                                    <Skeleton class="h-4 w-40" />
                                    <Skeleton class="h-3 w-64" />
                                </div>
                                <Skeleton class="h-5 w-20" />
                            </div>
                        </li>
                    }
                </ul>
            } else if (items.length === 0) {
                <div class="px-6 py-10 text-center text-sm text-[var(--color-muted-foreground)]">
                    No invoices match the current filters.
                </div>
            } else {
                <ul>
                    @foreach (const [i, inv] of items.entries()) {
                        <li @key="inv.id" class="border-t border-[var(--color-border)] first:border-t-0">
                            <button type="button" @onclick="() => navigation.navigateTo(`/billing/invoices/${inv.id}`)"
                                    class="fsh-enter grid w-full grid-cols-[1fr_auto] items-center gap-x-6 gap-y-1 px-6 py-4 text-left transition-colors hover:bg-[var(--color-muted)] cursor-pointer"
                                    style="@(`animation-delay: ${Math.min(i, 8) * 25}ms`)">
                                @* Identity column *@
                                <div class="flex min-w-0 items-center gap-3">
                                    <span aria-hidden="true" class="grid h-9 w-9 shrink-0 place-items-center rounded-md bg-[var(--color-surface-2)] text-[var(--color-muted-foreground)] ring-1 ring-inset ring-[var(--color-border)]">
                                        <Icon icon="@FileText" class="h-4 w-4" />
                                    </span>
                                    <div class="min-w-0">
                                        <div class="flex flex-wrap items-center gap-2">
                                            <code class="rounded bg-[var(--color-surface-2)] px-1.5 py-0.5 font-mono text-[11px] font-medium tracking-tight">@inv.invoiceNumber</code>
                                            <Badge variant="@invoiceStatusVariant(inv.status)">@inv.status</Badge>
                                            @if (inv.purpose) {
                                                <Badge variant="outline">@(inv.purpose === "Subscription" ? "Subscription" : "Usage")</Badge>
                                            }
                                        </div>
                                        <div class="mt-1 truncate font-mono text-[11px] tracking-tight text-[var(--color-muted-foreground)]">
                                            tenant <span class="text-[var(--color-foreground)]">@inv.tenantId</span> ·
                                            period @formatPeriod(inv.periodYear, inv.periodMonth) ·
                                            created @formatDate(inv.createdAtUtc)
                                            @if (inv.paidAtUtc) {
                                                <text> · </text><span class="text-[var(--color-success)]">paid @formatDate(inv.paidAtUtc)</span>
                                            }
                                            @if (inv.voidedAtUtc) {
                                                <text> · </text><span class="text-[var(--color-destructive)]">voided @formatDate(inv.voidedAtUtc)</span>
                                            }
                                        </div>
                                    </div>
                                </div>

                                @* Amount column *@
                                <div class="text-right">
                                    <div class="text-display text-base font-semibold tabular-nums">@formatMoney(inv.subtotalAmount, inv.currency)</div>
                                    @if (inv.dueAtUtc && inv.status === "Issued") {
                                        <div class="font-mono text-[11px] text-[var(--color-warning)]">due @formatDate(inv.dueAtUtc)</div>
                                    }
                                </div>
                            </button>
                        </li>
                    }
                </ul>
            }
        </CardContent>
    </Card>

    @* Pagination *@
    <div class="flex items-center justify-between text-sm">
        <div class="font-mono text-[11px] uppercase tracking-[0.18em] text-[var(--color-muted-foreground)]">
            @(data ? `Page ${data.pageNumber} / ${Math.max(data.totalPages, 1)}` : "")
        </div>
        <div class="flex items-center gap-2">
            <Button variant="outline" size="sm" disabled="@(!data?.hasPrevious || query.result.isFetching)" onClick="@(() => pageNumber = Math.max(1, pageNumber - 1))">
                <Icon icon="@ChevronLeft" class="mr-1 h-4 w-4" /> Previous
            </Button>
            <Button variant="outline" size="sm" disabled="@(!data?.hasNext || query.result.isFetching)" onClick="@(() => pageNumber = pageNumber + 1)">
                Next <Icon icon="@ChevronRight" class="ml-1 h-4 w-4" />
            </Button>
        </div>
    </div>
</div>

@code {
    static readonly pageSize = 20;
    static readonly statuses: InvoiceStatus[] = ["Draft", "Issued", "Paid", "Void"];

    private pageNumber = 1;
    private tenantFilter = "";
    private statusFilter: InvoiceStatus | "" = "";
    private periodYear = "";
    private periodMonth = "";

    private readonly statusOptions = InvoicesList.statuses.map((s) => ({ value: s, label: s }));

    private readonly query = new Query(() => {
        const filters = this.filters;
        return {
            queryKey: ["billing", "invoices", { pageNumber: this.pageNumber, ...filters }],
            queryFn: () => listInvoices({ pageNumber: this.pageNumber, pageSize: InvoicesList.pageSize, ...filters }),
            placeholderData: keepPreviousData,
        };
    });

    protected override onInitialized(): void {
        this.observe(this.query);
    }

    private get filters() {
        return {
            tenantId: this.tenantFilter.trim() || undefined,
            status: this.statusFilter || undefined,
            periodYear: this.periodYear ? Number(this.periodYear) : undefined,
            periodMonth: this.periodMonth ? Number(this.periodMonth) : undefined,
        };
    }

    private get data() {
        return this.query.result.data;
    }

    private get items(): InvoiceDto[] {
        return this.data?.items ?? [];
    }

    private get totals(): { totalBilled: number; outstanding: number; paid: number; paidCount: number; currency: string } {
        let totalBilled = 0;
        let outstanding = 0;
        let paid = 0;
        let paidCount = 0;
        const items = this.items;
        const firstCurrency = items[0]?.currency ?? "USD";
        for (const inv of items) {
            totalBilled += inv.subtotalAmount;
            if (inv.status === "Paid") {
                paid += inv.subtotalAmount;
                paidCount += 1;
            } else if (inv.status === "Issued") {
                outstanding += inv.subtotalAmount;
            }
        }
        return { totalBilled, outstanding, paid, paidCount, currency: firstCurrency };
    }

    private get filtersDirty(): boolean {
        return !!this.tenantFilter || !!this.statusFilter || !!this.periodYear || !!this.periodMonth;
    }

    private firstPage(): void {
        this.pageNumber = 1;
    }

    /**
     * The year and month filters keep digits only (4 and 2 at most). React's controlled input shows the state after
     * every change, also when the state rejected the keystroke ("20" + "x" stays "20"); Tsazor, as Blazor, writes
     * `value` only when the rendered value changes — so the handler puts the digits back into the field itself.
     */
    private setPeriod(event: Event, field: "periodYear" | "periodMonth", maxLength: number): void {
        const input = event.target as HTMLInputElement;
        const value = input.value.replace(/[^0-9]/g, "").slice(0, maxLength);
        if (input.value !== value) input.value = value;
        this[field] = value;
        this.pageNumber = 1;
    }

    private clearFilters(): void {
        this.tenantFilter = "";
        this.statusFilter = "";
        this.periodYear = "";
        this.periodMonth = "";
        this.pageNumber = 1;
    }
}
