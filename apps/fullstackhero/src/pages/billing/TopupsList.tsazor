@* pages/billing/topups-list.tsx: the wallet top-up requests of every tenant — a KPI strip over the current page, the
   filters (tenant, status; Pending by default), the requests with their amount, status and linked invoice, and the
   pagination. Billing.Manage approves (which generates an invoice) or rejects a pending request after a
   confirmation with an optional note or reason. *@
@page "/billing/topups"
@authorize({ policy: "Permissions.Billing.View" })
@layout BillingLayout
@import { Check, ChevronLeft, ChevronRight, Filter, Receipt, Wallet, X } from "lucide"
@import { keepPreviousData } from "@tanstack/query-core"
@import { approveTopupRequest, listTopupRequests, rejectTopupRequest, type TopupRequestDto, type TopupRequestStatus } from "@/api/wallet"
@import { BillingPermissions } from "@/lib/permissions"
@import { Query } from "@/lib/query"
@import { queryClient } from "@/lib/query-client"
@import { toast } from "@/lib/toast"
@import { describe, formatDate, formatMoney, topupStatusVariant } from "@/components/billing/billing-format"
@import BillingLayout from "./BillingLayout.tsazor"
@inject AuthService auth
@inject NavigationManager navigation

<div class="space-y-6">
    @* KPI strip — page-scope (current page, not all-time) *@
    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
        <KpiTile label="Page requests" subtitle="@(data ? `${data.totalCount.toLocaleString()} total` : "loading…")">
            <ValueContent>@if (query.result.isLoading) { <Skeleton class="h-7 w-16" /> } else { @(data?.items.length ?? 0) }</ValueContent>
        </KpiTile>
        <KpiTile label="Pending" subtitle="awaiting decision (this page)">
            <ValueContent>@if (query.result.isLoading) { <Skeleton class="h-7 w-12" /> } else { @totals.pendingCount }</ValueContent>
        </KpiTile>
        <KpiTile label="Requested" subtitle="this page">
            <ValueContent>@if (query.result.isLoading) { <Skeleton class="h-7 w-24" /> } else { @formatMoney(totals.requested, totals.currency) }</ValueContent>
        </KpiTile>
    </div>

    @* Filter panel *@
    <Card>
        <CardHeader class="flex flex-row items-center justify-between gap-3">
            <div>
                <CardTitle class="flex items-center gap-2">
                    <Icon icon="@Filter" class="h-4 w-4 text-[var(--color-muted-foreground)]" />
                    <span>Filters</span>
                </CardTitle>
                <CardDescription>
                    Review wallet top-up requests across every tenant. Approve to generate an invoice.
                </CardDescription>
            </div>
            @if (filtersDirty) {
                <Button variant="ghost" size="sm" onClick="@clearFilters">
                    <Icon icon="@X" class="mr-1 h-3.5 w-3.5" /> Clear
                </Button>
            }
        </CardHeader>
        <CardContent class="grid grid-cols-1 gap-3 sm:grid-cols-2">
            <div class="space-y-1.5">
                <Label for="filter-tenant">Tenant</Label>
                <Input id="filter-tenant" placeholder="tenant identifier" @bind-Value="tenantFilter" @bind-Value:after="firstPage" autocomplete="off" />
            </div>
            <div class="space-y-1.5">
                <Label for="filter-status">Status</Label>
                <FormSelect id="filter-status" @bind-value="statusFilter" @bind-value:after="firstPage" options="@statusOptions" emptyLabel="All" />
            </div>
        </CardContent>
    </Card>

    @* List *@
    <Card>
        <CardHeader>
            <CardTitle>Top-up requests</CardTitle>
            <CardDescription>
                @if (data) {
                    <text>Page <span class="tabular-nums">@data.pageNumber</span> of <span class="tabular-nums">@Math.max(data.totalPages, 1)</span> · <span class="tabular-nums">@data.totalCount.toLocaleString()</span> total</text>
                } else {
                    <text>Loading…</text>
                }
            </CardDescription>
        </CardHeader>
        <CardContent class="p-0">
            @if (query.result.isError) {
                <div class="border-t border-[var(--color-border)] px-6 py-4 text-sm text-[var(--color-destructive)]">
                    @describe(query.result.error, "Failed to load top-up requests.")
                </div>
            }

            @if (query.result.isLoading && items.length === 0) {
                <ul class="divide-y divide-[var(--color-border)]">
                    @for (let i = 0; i < 5; i++) {
                        <li class="px-6 py-4">
                            <div class="flex items-center justify-between">
                                <div class="space-y-2">
                                    <Skeleton class="h-4 w-40" />
                                    <Skeleton class="h-3 w-64" />
                                </div>
                                <Skeleton class="h-5 w-20" />
                            </div>
                        </li>
                    }
                </ul>
            } else if (items.length === 0) {
                <div class="px-6 py-10 text-center text-sm text-[var(--color-muted-foreground)]">
                    No top-up requests match the current filters.
                </div>
            } else {
                <ul>
                    @foreach (const [i, req] of items.entries()) {
                        <li @key="req.id"
                            class="fsh-enter grid grid-cols-[1fr_auto] items-center gap-x-6 gap-y-1 border-t border-[var(--color-border)] px-6 py-4 first:border-t-0"
                            style="@(`animation-delay: ${Math.min(i, 8) * 25}ms`)">
                            @* Identity column *@
                            <div class="flex min-w-0 items-center gap-3">
                                <span aria-hidden="true" class="grid h-9 w-9 shrink-0 place-items-center rounded-md bg-[var(--color-surface-2)] text-[var(--color-muted-foreground)] ring-1 ring-inset ring-[var(--color-border)]">
                                    <Icon icon="@Wallet" class="h-4 w-4" />
                                </span>
                                <div class="min-w-0">
                                    <div class="flex flex-wrap items-center gap-2">
                                        <span class="text-display text-base font-semibold tabular-nums">@formatMoney(req.amount, req.currency)</span>
                                        <Badge variant="@topupStatusVariant(req.status)">@req.status</Badge>
                                        @if (req.invoiceId) {
                                            <button type="button" @onclick="() => navigation.navigateTo(`/billing/invoices/${req.invoiceId}`)"
                                                    class="inline-flex items-center gap-1 rounded font-mono text-[11px] text-[var(--color-primary)] underline-offset-2 hover:underline">
                                                <Icon icon="@Receipt" class="h-3 w-3" /> invoice
                                            </button>
                                        }
                                    </div>
                                    <div class="mt-1 truncate font-mono text-[11px] tracking-tight text-[var(--color-muted-foreground)]">
                                        tenant <span class="text-[var(--color-foreground)]">@req.tenantId</span> ·
                                        created @formatDate(req.createdAtUtc)
                                        @if (req.decidedAtUtc) {
                                            <text> · decided @formatDate(req.decidedAtUtc)</text>
                                        }
                                        @if (req.note) {
                                            <text> · “@req.note”</text>
                                        }
                                    </div>
                                </div>
                            </div>

                            @* Actions column *@
                            @if (canManageBilling && req.status === "Pending") {
                                <div class="flex items-center gap-2">
                                    <Button size="sm" disabled="@actionPending" onClick="@(() => startAction(req, "approve"))">
                                        <Icon icon="@Check" class="mr-1 h-3.5 w-3.5" /> Approve
                                    </Button>
                                    <Button variant="outline" size="sm" disabled="@actionPending" onClick="@(() => startAction(req, "reject"))">
                                        <Icon icon="@X" class="mr-1 h-3.5 w-3.5" /> Reject
                                    </Button>
                                </div>
                            }
                        </li>
                    }
                </ul>
            }
        </CardContent>
    </Card>

    @* Pagination *@
    <div class="flex items-center justify-between text-sm">
        <div class="font-mono text-[11px] uppercase tracking-[0.18em] text-[var(--color-muted-foreground)]">
            @(data ? `Page ${data.pageNumber} / ${Math.max(data.totalPages, 1)}` : "")
        </div>
        <div class="flex items-center gap-2">
            <Button variant="outline" size="sm" disabled="@(!data?.hasPrevious || query.result.isFetching)" onClick="@(() => pageNumber = Math.max(1, pageNumber - 1))">
                <Icon icon="@ChevronLeft" class="mr-1 h-4 w-4" /> Previous
            </Button>
            <Button variant="outline" size="sm" disabled="@(!data?.hasNext || query.result.isFetching)" onClick="@(() => pageNumber = pageNumber + 1)">
                Next <Icon icon="@ChevronRight" class="ml-1 h-4 w-4" />
            </Button>
        </div>
    </div>

    @* Approve / Reject confirmation *@
    <ConfirmDialog open="@(action !== null)" openChanged="@((open: boolean) => { if (!open) closeAction(); })"
                   title="@(action?.mode === "reject" ? "Reject top-up request" : "Approve top-up request")"
                   destructive="@(action?.mode === "reject")"
                   confirmLabel="@(action?.mode === "reject" ? "Reject" : "Approve & generate invoice")"
                   pending="@actionPending" onConfirm="@confirmAction">
        <DescriptionContent>
            @if (action) {
                <div class="space-y-3">
                    <p>
                        @if (action.mode === "reject") {
                            <text>Reject the <span class="font-semibold">@formatMoney(action.request.amount, action.request.currency)</span> top-up for tenant <span class="font-mono">@action.request.tenantId</span>? This cannot be undone.</text>
                        } else {
                            <text>Approve the <span class="font-semibold">@formatMoney(action.request.amount, action.request.currency)</span> top-up for tenant <span class="font-mono">@action.request.tenantId</span>? An invoice will be generated for the operator to mark paid.</text>
                        }
                    </p>
                    <div class="space-y-1.5">
                        <Label for="decision-note">
                            @(action.mode === "reject" ? "Reason" : "Note") <span class="text-[var(--color-muted-foreground)]">(optional)</span>
                        </Label>
                        <Input id="decision-note" placeholder="@(action.mode === "reject" ? "duplicate · invalid · …" : "internal note")"
                               @bind-Value="decisionNote" disabled="@actionPending" autocomplete="off" />
                    </div>
                </div>
            }
        </DescriptionContent>
    </ConfirmDialog>
</div>

@code {
    static readonly pageSize = 20;
    static readonly statuses: TopupRequestStatus[] = ["Pending", "Approved", "Rejected", "Completed"];

    private pageNumber = 1;
    private tenantFilter = "";
    private statusFilter: TopupRequestStatus | "" = "Pending";

    /** The request being approved or rejected — the confirmation is open while it is set. */
    private action: { request: TopupRequestDto; mode: "approve" | "reject" } | null = null;
    private decisionNote = "";
    private actionPending = false;

    private readonly statusOptions = TopupsList.statuses.map((s) => ({ value: s, label: s }));

    private readonly query = new Query(() => {
        const filters = this.filters;
        return {
            queryKey: ["billing", "topup-requests", { pageNumber: this.pageNumber, ...filters }],
            queryFn: () => listTopupRequests({ pageNumber: this.pageNumber, pageSize: TopupsList.pageSize, ...filters }),
            placeholderData: keepPreviousData,
        };
    });

    protected override onInitialized(): void {
        this.observe(this.auth.changes);
        this.observe(this.query);
    }

    /** Approve / reject mutate the request and generate invoices — gated by Billing.Manage. */
    private get canManageBilling(): boolean {
        return (this.auth.user?.permissions ?? []).includes(BillingPermissions.Manage);
    }

    private get filters() {
        return {
            tenantId: this.tenantFilter.trim() || undefined,
            status: this.statusFilter || undefined,
        };
    }

    private get data() {
        return this.query.result.data;
    }

    private get items(): TopupRequestDto[] {
        return this.data?.items ?? [];
    }

    private get totals(): { pendingCount: number; requested: number; currency: string } {
        let pendingCount = 0;
        let requested = 0;
        const items = this.items;
        const firstCurrency = items[0]?.currency ?? "USD";
        for (const req of items) {
            requested += req.amount;
            if (req.status === "Pending") pendingCount += 1;
        }
        return { pendingCount, requested, currency: firstCurrency };
    }

    private get filtersDirty(): boolean {
        return !!this.tenantFilter || this.statusFilter !== "Pending";
    }

    private firstPage(): void {
        this.pageNumber = 1;
    }

    private clearFilters(): void {
        this.tenantFilter = "";
        this.statusFilter = "Pending";
        this.pageNumber = 1;
    }

    // ── approve / reject mutations ─────────────────────────────────────

    private startAction(request: TopupRequestDto, mode: "approve" | "reject"): void {
        this.decisionNote = "";
        this.action = { request, mode };
    }

    private closeAction(): void {
        this.action = null;
        this.decisionNote = "";
    }

    private invalidate(): void {
        void queryClient.invalidateQueries({ queryKey: ["billing", "topup-requests"] });
    }

    /** The request and the note as they are at the confirmation, never a later state. */
    private async confirmAction(): Promise<void> {
        const action = this.action;
        if (!action) return;
        const note = this.decisionNote;
        this.actionPending = true;
        try {
            if (action.mode === "approve") {
                const invoiceId = await approveTopupRequest(action.request.id, note);
                toast.success("Invoice generated", {
                    description: "A draft invoice was created for this top-up.",
                    action: invoiceId ? { label: "View invoice", onClick: () => this.navigation.navigateTo(`/billing/invoices/${invoiceId}`) } : undefined,
                });
            } else {
                await rejectTopupRequest(action.request.id, note);
                toast.success("Request rejected");
            }
            this.invalidate();
            this.closeAction();
        } catch (err) {
            if (action.mode === "approve") toast.error("Approve failed", { description: describe(err, "Could not approve the request.") });
            else toast.error("Reject failed", { description: describe(err, "Could not reject the request.") });
        } finally {
            this.actionPending = false;
        }
    }
}
