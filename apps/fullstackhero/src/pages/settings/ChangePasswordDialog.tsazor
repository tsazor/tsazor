@* pages/settings/security.tsx's ChangePasswordDialog: current, new and confirmed password. react-hook-form + zodResolver
   become an EditForm with a StandardSchemaValidator over the original's zod schema (unchanged: the refinements put
   "Passwords don't match." on `confirm` and the reuse check on `next`); `register("x")` is a RevealInput bound to the
   model, `errors.x?.message` Field's `for="x"`. The form resets every time the dialog opens, so stale values don't
   bleed (the original's effect on `open`). *@
@import { KeyRound } from "lucide"
@import { z } from "zod"
@import { EditForm, FocusOnInvalidSubmit, StandardSchemaValidator } from "@tsazor/runtime"
@import { changePassword } from "@/api/users"
@import { ApiRequestError } from "@/lib/api-client"
@import { toast } from "@/lib/toast"
@import RevealInput from "./RevealInput.tsazor"

<Dialog open="@open" openChanged="@openChanged">
    <DialogContent>
        <DialogHeader>
            <div class="flex items-center gap-3">
                <span class="grid size-9 shrink-0 place-items-center rounded-lg bg-[oklch(from_var(--color-primary)_l_c_h_/_0.10)] ring-1 ring-inset ring-[oklch(from_var(--color-primary)_l_c_h_/_0.20)]">
                    <Icon icon="@KeyRound" class="size-4 text-[var(--color-primary)]" />
                </span>
                <DialogTitle>Change password</DialogTitle>
            </div>
            <DialogDescription>
                Sign-out events for other devices aren't fired automatically — visit the Sessions tab
                below to end them after rotating your password.
            </DialogDescription>
        </DialogHeader>

        <EditForm Model="@model" OnValidSubmit="@submit" class="contents" novalidate>
            <StandardSchemaValidator Schema="@passwordSchema" />
            <FocusOnInvalidSubmit />
            <DialogBody class="space-y-4">
                <Field id="pw-current" label="Current password" required for="current">
                    <RevealInput id="pw-current" autocomplete="current-password" class="font-mono" autofocus @bind-value="model.current" />
                </Field>
                <Field id="pw-next" label="New password" required hint="At least 8 characters." for="next">
                    <RevealInput id="pw-next" autocomplete="new-password" class="font-mono" @bind-value="model.next" />
                </Field>
                <Field id="pw-confirm" label="Confirm new password" required for="confirm">
                    <RevealInput id="pw-confirm" autocomplete="new-password" class="font-mono" @bind-value="model.confirm" />
                </Field>
            </DialogBody>

            <DialogFooter>
                <Button type="button" variant="ghost" onClick="@(() => openChanged?.invokeAsync(false))" disabled="@submitting">Cancel</Button>
                <Button type="submit" disabled="@submitting">
                    <Icon icon="@KeyRound" class="mr-1 h-3.5 w-3.5" />
                    @(submitting ? "Updating…" : "Update password")
                </Button>
            </DialogFooter>
        </EditForm>
    </DialogContent>
</Dialog>

@code {
    @Parameter() open: boolean = false;
    @Parameter() openChanged?: EventCallback<boolean>;

    private readonly passwordSchema = z
        .object({
            current: z.string().min(1, "Required."),
            next: z.string().min(8, "At least 8 characters."),
            confirm: z.string().min(8),
        })
        .refine((v) => v.next === v.confirm, {
            path: ["confirm"],
            message: "Passwords don't match.",
        })
        .refine((v) => v.next !== v.current, {
            path: ["next"],
            message: "New password must differ from the current one.",
        });

    private model = { current: "", next: "", confirm: "" };
    private submitting = false;
    private wasOpen = false;

    /** Reset form every time the dialog opens so stale values don't bleed (a new model is a new EditContext). */
    protected override onParametersSet(): void {
        if (this.open && !this.wasOpen) this.model = { current: "", next: "", confirm: "" };
        this.wasOpen = this.open;
    }

    /** The original's mutation: onSuccess closes, onError toasts the server's detail. */
    private async submit(): Promise<void> {
        const values = this.passwordSchema.parse(this.model);
        this.submitting = true;
        try {
            await changePassword({ password: values.current, newPassword: values.next, confirmNewPassword: values.confirm });
            toast.success("Password changed", {
                description: "Other active sessions remain valid until you revoke them.",
            });
            await this.openChanged?.invokeAsync(false);
        } catch (err) {
            const detail =
                err instanceof ApiRequestError
                    ? (err.problem?.detail ?? err.problem?.title ?? err.message)
                    : (err as Error).message;
            toast.error("Change failed", { description: detail });
        } finally {
            this.submitting = false;
        }
    }
}
