@* pages/settings/security.tsx's PasswordSection: the password card, whose button opens the change dialog. *@
@import { KeyRound } from "lucide"
@import ChangePasswordDialog from "./ChangePasswordDialog.tsazor"

<SettingsSection title="Password" icon="@KeyRound" description="Used to sign in to this console. Choose a strong, unique passphrase of 16+ characters.">
    <div class="flex items-center justify-between gap-4">
        <p class="text-sm text-[var(--color-muted-foreground)]">
            Changing your password does not revoke other sessions automatically — visit the Sessions
            tab to sign out other devices.
        </p>
        <Button variant="outline" size="sm" onClick="@(() => dialogOpen = true)">Change password</Button>
    </div>
</SettingsSection>

<ChangePasswordDialog @bind-open="dialogOpen" />

@code {
    private dialogOpen = false;
}
