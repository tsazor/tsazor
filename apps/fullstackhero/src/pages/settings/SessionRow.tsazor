@* pages/settings/sessions.tsx's SessionRow: one signed-in device — the device tile (brand-tinted for this device),
   browser on OS with its badges, IP and times, and the action: "use Sign out" here, Revoke elsewhere. *@
@import { LogOut, Monitor, MoreHorizontal, Smartphone } from "lucide"
@import type { UserSessionDto } from "@/api/sessions"
@import { describeDevice, formatDate, formatRelative } from "./session-format"

<li class="@cn("grid grid-cols-[auto_1fr_auto] items-center gap-4 py-3", !session.isActive && "opacity-60")">
    <span class="@cn("grid h-9 w-9 place-items-center rounded-full ring-1 ring-inset shrink-0", session.isCurrentSession ? "bg-[var(--color-primary-soft,oklch(from_var(--color-accent-signal)_l_c_h_/_0.12))] text-[var(--color-accent-signal)] ring-[oklch(from_var(--color-accent-signal)_l_c_h_/_0.30)]" : "bg-[var(--color-muted)] text-[var(--color-muted-foreground)] ring-[var(--color-border)]")">
        <Icon icon="@(isMobile ? Smartphone : Monitor)" class="h-4 w-4" />
    </span>
    <div class="min-w-0">
        <div class="flex flex-wrap items-baseline gap-2">
            <span class="truncate text-sm font-medium">@describeDevice(session)</span>
            @if (session.isCurrentSession) {
                <Badge variant="brand" class="font-mono uppercase tracking-[0.14em]">This device</Badge>
            }
            @if (!session.isActive) {
                <Badge variant="muted" class="font-mono uppercase tracking-[0.14em]">Revoked</Badge>
            }
        </div>
        <div class="mt-0.5 flex flex-wrap items-baseline gap-x-3 gap-y-0.5 font-mono text-[10.5px] text-[var(--color-muted-foreground)]">
            <span>@(session.ipAddress ?? "unknown ip")</span>
            <span>· last seen @formatRelative(session.lastActivityAt)</span>
            <span>· expires @formatDate(session.expiresAt)</span>
        </div>
    </div>
    @if (session.isCurrentSession) {
        <span class="text-[10.5px] font-semibold uppercase tracking-wider text-[var(--color-muted-foreground)]/60 flex items-center gap-1">
            <Icon icon="@MoreHorizontal" class="h-3.5 w-3.5" /> use Sign out
        </span>
    } else if (session.isActive) {
        <Button variant="outline" size="sm" onClick="@(() => onRevoke?.invokeAsync())" disabled="@busy">
            <Icon icon="@LogOut" class="mr-1.5 h-3.5 w-3.5" />
            @(busy ? "Revoking…" : "Revoke")
        </Button>
    } else {
        <span aria-hidden="true"></span>
    }
</li>

@code {
    @Parameter() session!: UserSessionDto;
    @Parameter() busy: boolean = false;
    @Parameter() onRevoke?: EventCallback;

    private get isMobile(): boolean {
        return (this.session.deviceType ?? "").toLowerCase().includes("mobile");
    }
}
