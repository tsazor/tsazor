@* pages/settings/layout.tsx: SettingsLayout — editorial numbered left-nav + content parity with the dashboard
   settings shell. Desktop: `lg:grid-cols-[260px_1fr]` with a sticky vertical "Sections" rail; active item shows a
   primary brand bar on the left edge. Mobile: horizontal pill tabs (overflow-x scroll). Masthead resolves to
   "Settings · {active section}" so the active context is always visible at page level.
   - React Router's nested route is a nested layout: the settings pages name this one in `@layout`, <Outlet /> is
     @Body, and this layout's own `@layout AppShell` puts it into the shell (Blazor's nested layouts, F10).
   - NavLink's render props (`isActive`, with `end`: an exact match) are computed from the location, which the layout
     observes. *@
@inherits LayoutComponentBase
@import { ChevronRight, Settings } from "lucide"
@layout AppShell
@import { pad2, TABS, type Tab } from "./settings-tabs"
@inject NavigationManager navigation

<div class="space-y-6">
    @* Page header — resolves to "Settings · {active section}" so the active context is visible without stacking
       a second header. *@
    <EntityPageHeader icon="@Settings" description="@active.hint">
        <TitleContent>
            <span class="flex flex-wrap items-baseline gap-x-2.5 gap-y-1">
                <span>Settings</span>
                <span aria-hidden="true" class="text-[oklch(from_var(--color-border-strong)_l_c_h_/_0.7)]">·</span>
                <span class="font-display text-[20px] font-semibold tracking-tight text-[var(--color-foreground)]">@active.label</span>
            </span>
        </TitleContent>
    </EntityPageHeader>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-[260px_1fr] lg:gap-10">
        @* ─── Editorial left nav ─── *@
        <nav aria-label="Settings sections">
            @* Desktop: sticky vertical numbered list *@
            <div class="sticky top-6 hidden lg:block">
                <p class="mb-4 pl-5 text-[10px] font-semibold uppercase tracking-[0.18em] text-[oklch(from_var(--color-muted-foreground)_l_c_h_/_0.6)]">Sections</p>
                <ul class="relative space-y-px">
                    @* Faint vertical rail tying the numbers together *@
                    <div aria-hidden="true" class="absolute bottom-1 left-[14px] top-1 w-px bg-[oklch(from_var(--color-border)_l_c_h_/_0.6)]"></div>
                    @foreach (const [i, tab] of TABS.entries()) {
                        const isActive = matches(tab);
                        <li @key="tab.to">
                            <a href="@tab.to" aria-current="@(isActive ? "page" : null)"
                               class="@cn("group relative flex w-full cursor-pointer items-start gap-3 rounded-lg py-3 pl-5 pr-3 text-left transition-all", isActive ? "bg-[var(--color-card)] shadow-xs" : "hover:bg-[oklch(from_var(--color-muted)_l_c_h_/_0.4)]")">
                                @if (isActive) {
                                    <span aria-hidden="true" class="absolute left-0 top-1/2 h-7 w-[3px] -translate-y-1/2 rounded-full bg-[var(--color-primary)]"></span>
                                }
                                <span class="@cn("z-10 mt-0.5 bg-[var(--color-background)] px-1 font-display text-[11px] font-semibold leading-5 tabular-nums transition-colors", isActive ? "text-[var(--color-primary)]" : "text-[oklch(from_var(--color-muted-foreground)_l_c_h_/_0.5)]")">@pad2(i + 1)</span>
                                <span class="min-w-0 flex-1">
                                    <span class="@cn("block text-[13px] font-semibold transition-colors", isActive ? "text-[var(--color-foreground)]" : "text-[var(--color-muted-foreground)] group-hover:text-[var(--color-foreground)]")">@tab.label</span>
                                    <span class="mt-0.5 block truncate text-[11px] text-[oklch(from_var(--color-muted-foreground)_l_c_h_/_0.6)]">@tab.hint</span>
                                </span>
                                <Icon icon="@ChevronRight" class="@cn("mt-1 size-3.5 shrink-0 transition-all", isActive ? "translate-x-0.5 text-[var(--color-primary)]" : "text-[oklch(from_var(--color-muted-foreground)_l_c_h_/_0.3)] group-hover:text-[oklch(from_var(--color-muted-foreground)_l_c_h_/_0.5)]")" />
                            </a>
                        </li>
                    }
                </ul>
            </div>

            @* Mobile: horizontal pill tabs (overflow scroll) *@
            <div class="-mx-2 overflow-x-auto pb-1 lg:hidden">
                <div class="flex gap-1 px-2">
                    @foreach (const tab of TABS) {
                        <a @key="tab.to" href="@tab.to" aria-current="@(matches(tab) ? "page" : null)"
                           class="@cn("inline-flex h-9 shrink-0 items-center gap-1.5 rounded-full px-3.5 text-[12px] font-medium", "transition-colors duration-[var(--duration-fast)] ease-[var(--ease-out-cubic)]", "focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-ring)] focus-visible:ring-offset-2", matches(tab) ? "bg-[var(--color-primary-soft)] text-[var(--color-primary)]" : "text-[var(--color-muted-foreground)] hover:bg-[var(--color-accent)] hover:text-[var(--color-foreground)]")">
                            <Icon icon="@tab.icon" class="size-3.5" />
                            @tab.label
                        </a>
                    }
                </div>
            </div>
        </nav>

        @* ─── Tab content ─── *@
        <div class="min-w-0">
            <div class="space-y-5">
                @Body
            </div>
        </div>
    </div>
</div>

@code {
    protected override onInitialized(): void {
        // React Router's useLocation(): every navigation re-renders the masthead and the nav.
        this.observe(this.navigation);
    }

    private get pathname(): string {
        return new URL(this.navigation.uri).pathname;
    }

    /** The masthead's section: the first tab the path starts with, else the first. */
    private get active(): Tab {
        const activeIndex = Math.max(0, TABS.findIndex((tab) => this.pathname.startsWith(tab.to)));
        return TABS[activeIndex] ?? TABS[0]!;
    }

    /** NavLink's isActive with `end`: the path is the tab's (React Router: case-insensitive, a trailing slash allowed). */
    private matches(tab: Tab): boolean {
        return this.pathname.replace(/\/+$/, "").toLowerCase() === tab.to.toLowerCase();
    }
}
