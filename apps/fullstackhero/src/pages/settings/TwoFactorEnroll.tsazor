@* pages/settings/security.tsx's TwoFactorEnroll: "Enable two-factor" asks the server for a shared key and an otpauth://
   URI, shows the URI as a QR code (and the key to type in), and enables 2FA once the authenticator's 6-digit code
   verifies. The QR is the original's: the lazily loaded qrcode lib renders it as SVG, its fills themed so it adapts
   to dark mode, inlined as markup (MarkupString — dangerouslySetInnerHTML). Rendering it is the original's effect on
   `enrollment`: a newer enrollment (or none) makes a pending render stale. *@
@import { ClipboardCheck, Copy, ShieldCheck } from "lucide"
@import { MarkupString } from "@tsazor/runtime"
@import { enrollTwoFactor, verifyEnrollTwoFactor, type TwoFactorEnrollmentResponse } from "@/api/two-factor"
@import { ApiRequestError } from "@/lib/api-client"
@import { queryClient } from "@/lib/query-client"
@import { toast } from "@/lib/toast"

<SettingsSection title="Two-factor authentication" icon="@ShieldCheck">
    <DescriptionContent>
        <span class="flex flex-wrap items-center gap-2">
            Adds an authenticator app code on top of your password. Recommended for every operator
            account.
            <Badge variant="outline" class="font-mono uppercase tracking-[0.14em]">off</Badge>
        </span>
    </DescriptionContent>
    <ChildContent>
        @if (!enrollment) {
            <div class="flex flex-wrap items-center gap-3">
                <Button onClick="@begin" disabled="@beginning">
                    <Icon icon="@ShieldCheck" class="mr-1.5 h-3.5 w-3.5" />
                    @(beginning ? "Generating…" : "Enable two-factor")
                </Button>
                <span class="text-xs text-[var(--color-muted-foreground)]">
                    You'll scan a QR code in your authenticator app (1Password, Google Authenticator, Authy…).
                </span>
            </div>
        } else {
            <div class="space-y-5">
                <div class="grid gap-5 sm:grid-cols-[14rem_1fr] sm:items-start">
                    <div class="grid h-52 w-52 place-items-center rounded-md border border-[var(--color-border)] bg-[var(--color-muted)] p-2 text-[var(--color-foreground)]">
                        @if (qrSvg) {
                            @* qrSvg is locally generated by the qrcode lib from the authenticator URI (not server/user
                               HTML) — safe to inline. *@
                            <div aria-label="Two-factor QR code" role="img" class="h-full w-full [&_svg]:h-full [&_svg]:w-full">@(new MarkupString(qrSvg))</div>
                        } else {
                            <span class="text-[11px] font-semibold uppercase tracking-wider text-[var(--color-muted-foreground)]">Rendering…</span>
                        }
                    </div>
                    <div class="space-y-3">
                        <div>
                            <div class="text-[11px] font-semibold uppercase tracking-wider text-[var(--color-muted-foreground)]">Can't scan? Enter manually</div>
                            <div class="mt-1 flex items-center gap-2">
                                <code class="break-all rounded-md border border-[var(--color-border)] bg-[var(--color-muted)] px-2 py-1 font-mono text-[11px]">@enrollment.sharedKey</code>
                                <button type="button" @onclick="copyKey"
                                        class="inline-flex h-7 items-center gap-1 rounded-md px-2 text-[11px] font-semibold uppercase tracking-wider text-[var(--color-muted-foreground)] transition-colors hover:bg-[var(--color-muted)] hover:text-[var(--color-foreground)]">
                                    @if (copiedKey) {
                                        <Icon icon="@ClipboardCheck" class="h-3 w-3" /> <text>copied</text>
                                    } else {
                                        <Icon icon="@Copy" class="h-3 w-3" /> <text>copy</text>
                                    }
                                </button>
                            </div>
                        </div>

                        <div class="space-y-1.5">
                            <Label for="totp-code">6-digit code from your app</Label>
                            <Input id="totp-code" inputmode="numeric" autocomplete="one-time-code" placeholder="123 456" maxlength="8"
                                   value="@code" valueChanged="@setCode"
                                   class="@cn("font-mono text-lg tracking-[0.4em]", code.length >= 6 && "border-[var(--color-accent-signal)]")" />
                        </div>

                        <div class="flex flex-wrap items-center gap-2 pt-1">
                            <Button onClick="@verify" disabled="@(code.length < 6 || verifying)" variant="signal">
                                @(verifying ? "Verifying…" : "Confirm & enable")
                            </Button>
                            <Button variant="ghost" onClick="@cancel" disabled="@verifying">Cancel</Button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </ChildContent>
</SettingsSection>

@code {
    private enrollment: TwoFactorEnrollmentResponse | null = null;
    private code = "";
    private qrSvg: string | null = null;
    private copiedKey = false;
    private beginning = false;
    private verifying = false;
    private copiedTimer?: ReturnType<typeof setTimeout>;

    private async begin(): Promise<void> {
        this.beginning = true;
        try {
            this.setEnrollment(await enrollTwoFactor());
        } catch (err) {
            toast.error("Enrollment failed", { description: this.detail(err) });
        } finally {
            this.beginning = false;
        }
    }

    private async verify(): Promise<void> {
        this.verifying = true;
        try {
            const data = await verifyEnrollTwoFactor(this.code);
            if (data.success) {
                toast.success("Two-factor enabled", {
                    description: "Future logins require a 6-digit code from your authenticator.",
                });
                this.setEnrollment(null);
                this.code = "";
                void queryClient.invalidateQueries({ queryKey: ["identity", "profile"] });
            } else {
                toast.error("Verification failed", { description: "That code didn't match. Try again." });
            }
        } catch (err) {
            toast.error("Verification failed", { description: this.detail(err) });
        } finally {
            this.verifying = false;
        }
    }

    private cancel(): void {
        this.setEnrollment(null);
        this.code = "";
    }

    /** The input's onChange: the code without its spaces ("123 456" reads as "123456"). */
    private setCode(value: string): void {
        this.code = value.replace(/\s/g, "");
    }

    private async copyKey(): Promise<void> {
        if (!this.enrollment) return;
        try {
            await navigator.clipboard.writeText(this.enrollment.sharedKey);
            this.copiedKey = true;
            clearTimeout(this.copiedTimer);
            this.copiedTimer = setTimeout(() => {
                this.copiedKey = false;
                this.stateHasChanged();
            }, 1500);
        } catch {
            /* clipboard unavailable — silently noop */
        }
    }

    private setEnrollment(enrollment: TwoFactorEnrollmentResponse | null): void {
        this.enrollment = enrollment;
        this.qrSvg = null;
        if (enrollment) void this.renderQr(enrollment);
    }

    /** Render the QR as inline SVG — keeps the image source-of-truth in JS without an extra <canvas>. */
    private async renderQr(enrollment: TwoFactorEnrollmentResponse): Promise<void> {
        let themed: string | null = null;
        try {
            // Lazy-load the ~50 KB qrcode lib only when 2FA enrollment actually starts.
            const { default: QRCode } = await import("qrcode");
            const svg = await QRCode.toString(enrollment.authenticatorUri, {
                type: "svg",
                margin: 1,
                width: 200,
                errorCorrectionLevel: "M",
            });
            // Strip the default white background so the QR adapts to dark mode.
            themed = svg
                .replace(/fill="#ffffff"/gi, 'fill="transparent"')
                .replace(/fill="#FFFFFF"/gi, 'fill="transparent"')
                .replace(/fill="#000000"/gi, 'fill="currentColor"')
                .replace(/fill="#000"/gi, 'fill="currentColor"');
        } catch {
            themed = null;
        }
        // The effect's cleanup: a newer enrollment (or none), or the component gone, cancels this one.
        if (this.enrollment !== enrollment || this.disposeSignal.aborted) return;
        this.qrSvg = themed;
        this.stateHasChanged();
    }

    /** The mutations' onError: the server's ProblemDetails, else the error's message. */
    private detail(err: unknown): string {
        return err instanceof ApiRequestError ? (err.problem?.detail ?? err.problem?.title ?? err.message) : (err as Error).message;
    }

    dispose(): void {
        clearTimeout(this.copiedTimer);
    }
}
