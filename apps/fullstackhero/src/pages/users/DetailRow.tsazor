@* pages/users/detail.tsx's DetailRow: a label and its value on one baseline (a <dt>/<dd> pair); `mono` for identifiers. *@

<div class="flex items-baseline justify-between gap-3 py-2.5">
    <dt class="shrink-0 text-[11.5px] font-medium text-[var(--color-muted-foreground)]">@label</dt>
    <dd class="@cn("min-w-0 truncate text-right text-[13px] text-[var(--color-foreground)]", mono && "font-mono text-[11.5px]")">@childContent</dd>
</div>

@code {
    @Parameter() label!: string;
    @Parameter() mono: boolean = false;
    @Parameter() childContent?: RenderFragment;
}
