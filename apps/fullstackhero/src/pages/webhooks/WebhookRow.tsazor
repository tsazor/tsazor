@* pages/webhooks/list.tsx's Row: a subscription — its number, the active dot, the URL with up to four events (the
   button that opens it), the status badge, Test and Delete. *@
@import { ChevronRight, Send, Trash2 } from "lucide"
@import type { WebhookSubscriptionDto } from "@/api/webhooks"

<li>
    <div class="group grid grid-cols-[3rem_auto_1fr_auto_auto_auto] items-center gap-3 px-1 py-3.5">
        <span class="font-mono text-xs tabular-nums text-[var(--color-muted-foreground)]">#@num</span>
        <span class="@cn("grid h-2 w-2 place-items-center rounded-full", sub.isActive ? "bg-[var(--color-accent-signal)]" : "bg-[var(--color-muted-foreground)]/50")"
              aria-hidden="true" title="@(sub.isActive ? "Active" : "Inactive")"></span>
        <button type="button" @onclick="() => onOpen?.invokeAsync()" class="min-w-0 text-left transition-colors hover:bg-[var(--color-muted)]/40 -mx-2 px-2 py-1 rounded-md">
            <div class="truncate font-mono text-[13px] font-medium">@sub.url</div>
            <div class="mt-0.5 flex flex-wrap items-center gap-1.5">
                @foreach (const e of sub.events.slice(0, 4)) {
                    <code @key="e" class="code-chip">@e</code>
                }
                @if (sub.events.length > 4) {
                    <span class="font-mono text-[10.5px] text-[var(--color-muted-foreground)]">+@(sub.events.length - 4) more</span>
                }
                <span class="font-mono text-[10.5px] uppercase tracking-[0.18em] text-[var(--color-muted-foreground)]">
                    · since @(new Date(sub.createdAtUtc).toLocaleDateString())
                </span>
            </div>
        </button>
        <Badge variant="@(sub.isActive ? "success" : "muted")" class="font-mono uppercase tracking-[0.14em]">
            @(sub.isActive ? "Active" : "Inactive")
        </Badge>
        <Button variant="outline" size="sm" onClick="@(() => onTest?.invokeAsync())" disabled="@busy">
            <Icon icon="@Send" class="mr-1 h-3.5 w-3.5" /> Test
        </Button>
        <Button variant="ghost" size="sm" onClick="@(() => onDelete?.invokeAsync())" disabled="@busy" aria-label="@(`Delete subscription to ${sub.url}`)"
                class="text-[var(--color-destructive)] hover:bg-[oklch(from_var(--color-destructive)_l_c_h_/_0.08)]">
            <Icon icon="@Trash2" class="h-3.5 w-3.5" />
        </Button>
        <Icon icon="@ChevronRight" class="hidden h-4 w-4 text-[var(--color-muted-foreground)] transition-transform group-hover:translate-x-0.5" aria-hidden="true" />
    </div>
</li>

@code {
    @Parameter() sub!: WebhookSubscriptionDto;
    @Parameter() index: number = 1;
    @Parameter() busy: boolean = false;
    @Parameter() onTest?: EventCallback;
    @Parameter() onDelete?: EventCallback;
    @Parameter() onOpen?: EventCallback;

    private get num(): string {
        return String(this.index).padStart(3, "0");
    }
}
