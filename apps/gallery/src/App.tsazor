@import MainLayout from "./MainLayout.tsazor"
@inject ThemeState Theme

<Router>
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@MainLayout" />
    </Found>
    <Navigating>
        <p class="navigating" role="status">Loading…</p>
    </Navigating>
    <NotFound>
        <p class="not-found">Page not found.</p>
    </NotFound>
</Router>
