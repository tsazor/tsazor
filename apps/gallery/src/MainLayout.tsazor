@inherits LayoutComponentBase
@inject ThemeState Theme

<FluentProvider theme="@this.Theme.theme">
    <div class="app-shell">
        <aside class="sidebar">
            <div class="sidebar-brand">Tsazor Fluent</div>
            <div class="sidebar-nav">
                <SidebarNav links="@this.navLinks" ariaLabel="Sections" />
            </div>
        </aside>
        <main class="content">
            <header class="topbar">
                <span class="topbar-title">@this.Theme.theme</span>
                <button class="theme-toggle" type="button" @onclick="() => this.Theme.toggle()">
                    @if (this.Theme.theme === "dark") {
                        <text>Light</text>
                    } else {
                        <text>Dark</text>
                    }
                </button>
            </header>
            <div class="page">@Body</div>
        </main>
    </div>
</FluentProvider>

@code {
    private unsub: () => void = () => {};

    /** Sidebar sections, rendered through SidebarNav + runtime NavLink. */
    private navLinks: { href: string; label: string }[] = [
        { href: "/", label: "Overview" },
        { href: "/button", label: "Button" },
        { href: "/inputs", label: "Inputs" },
        { href: "/form", label: "Form" },
        { href: "/tabs", label: "Tabs" },
        { href: "/table", label: "Table" },
        { href: "/dialog", label: "Dialog" },
        { href: "/feedback", label: "Feedback" },
        { href: "/primitives", label: "Layout" },
        { href: "/theme", label: "Theme" },
        { href: "/dashboard", label: "Dashboard" },
    ];

    protected override onInitialized(): void {
        // The sidebar shows the theme toggle outcome — the layout subscribes.
        this.unsub = this.Theme.subscribe(() => this.stateHasChanged());
    }

    dispose(): void {
        this.unsub();
    }
}