@page "/button"
@import * as Icons from "@tsazor/fluent-icons"

<h1>Button</h1>
<p class="intro">Appearances, shapes and sizes. Fluent 2: secondary is the default appearance.</p>

<section class="demo">
    <h2>Appearance</h2>
    <div class="demo-row">
        <Button intent="primary" onClick="@(() => this.bump())">Primary</Button>
        <Button>Secondary</Button>
        <Button appearance="subtle">Subtle</Button>
        <Button appearance="transparent">Transparent</Button>
    </div>
    <p>Clicks: <strong class="click-count">@this.clicks</strong></p>
</section>

<section class="demo">
    <h2>Shape &amp; size</h2>
    <div class="demo-row">
        <Button intent="primary">Rounded</Button>
        <Button shape="circular" intent="primary">Circular</Button>
        <Button size="small" intent="primary">Small</Button>
        <Button size="large" intent="primary">Large</Button>
    </div>
</section>

<section class="demo">
    <h2>Icons</h2>
    <p>Fluent UI Blazor's <code>IconStart</code> and <code>IconEnd</code>, drawn at the icon's own size. Without a label it is an icon-only button, named by <code>ariaLabel</code>.</p>
    <div class="demo-row icon-buttons">
        <Button intent="primary" iconStart="@Icons.Regular.Size20.Save">Save</Button>
        <Button iconEnd="@Icons.Regular.Size20.ChevronDown">More</Button>
        <Button appearance="subtle" ariaLabel="Delete" iconStart="@Icons.Regular.Size20.Delete" />
        <Button shape="circular" ariaLabel="Add" iconStart="@Icons.Regular.Size20.Add" />
        <Button size="small" iconStart="@Icons.Regular.Size16.Edit">Small</Button>
        <Button size="large" intent="primary" iconStart="@Icons.Regular.Size24.Settings">Large</Button>
        <Badge intent="success" iconStart="@Icons.Filled.Size12.Checkmark" iconLabel="Done">Shipped</Badge>
    </div>
</section>

<section class="demo">
    <h2>Disabled</h2>
    <div class="demo-row">
        <Button disabled="true">Disabled</Button>
        <Button disabled="true" intent="primary">Primary disabled</Button>
    </div>
</section>

<section class="demo">
    <h2>Toolbar</h2>
    <Toolbar ariaLabel="Text formatting">
        <Button appearance="subtle" ariaLabel="Bold" iconStart="@Icons.Regular.Size20.TextBold" />
        <Button appearance="subtle" ariaLabel="Italic" iconStart="@Icons.Regular.Size20.TextItalic" />
        <Button appearance="subtle" ariaLabel="Underline" iconStart="@Icons.Regular.Size20.TextUnderline" />
        <Divider orientation="vertical" />
        <Button appearance="subtle" ariaLabel="Bulleted list" iconStart="@Icons.Regular.Size20.TextBulletList" />
        <Button appearance="subtle" ariaLabel="Numbered list" iconStart="@Icons.Regular.Size20.TextNumberListLtr" />
        <Divider orientation="vertical" />
        <Button appearance="subtle" disabled="true" ariaLabel="Undo" iconStart="@Icons.Regular.Size20.ArrowUndo" />
    </Toolbar>
    <p>One tab stop: the arrow keys move between the buttons and skip the disabled one.</p>
</section>

@code {
    private clicks = 0;
    private bump(): void {
        this.clicks++;
        this.stateHasChanged();
    }
}