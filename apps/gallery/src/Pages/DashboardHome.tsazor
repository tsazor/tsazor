@page "/dashboard"

<h1>Admin dashboard</h1>
<p class="intro">KPIs over Fluent cards, plus a live orders table. The sub-pages exercise the full app pattern: <a href="/dashboard/orders">Orders</a> (filter, sort, paging, detail dialog) and <a href="/dashboard/settings">Settings</a> (validated form + confirm).</p>

<div class="kpi-grid">
    <div class="kpi">
        <div class="kpi__label">Orders today</div>
        <div class="kpi__value">@this.kpiOrders</div>
        <div class="kpi__delta"><Badge color="success">+12%</Badge></div>
    </div>
    <div class="kpi">
        <div class="kpi__label">Volume</div>
        <div class="kpi__value">@this.kpiVolume</div>
        <div class="kpi__delta"><Badge color="success">+8%</Badge></div>
    </div>
    <div class="kpi">
        <div class="kpi__label">Open tickets</div>
        <div class="kpi__value">@this.kpiTickets</div>
        <div class="kpi__delta"><Badge color="warning">2 due</Badge></div>
    </div>
    <div class="kpi">
        <div class="kpi__label">Uptime</div>
        <div class="kpi__value">@this.kpiUptime</div>
        <div class="kpi__delta"><Badge color="success">99.9%</Badge></div>
    </div>
</div>

<h2>Recent orders</h2>
<Table items="@this.rows" striped="true" hover="true" colSpan="4">
    <HeaderContent>
        <tr><th>Order</th><th>Customer</th><th>Total (€)</th><th>Status</th></tr>
    </HeaderContent>
    <RowContent Context="row">
        <tr><td>#@row.id</td><td>@row.customer</td><td>@row.total</td><td>@row.status</td></tr>
    </RowContent>
</Table>

@code {
    private kpiOrders = "128";
    private kpiVolume = "€4,320";
    private kpiTickets = "7";
    private kpiUptime = "30 d";

    private orders = [
        { id: 101, customer: "Alice", total: 42, status: "paid" },
        { id: 102, customer: "Bruno", total: 17, status: "paid" },
        { id: 103, customer: "Chiara", total: 99, status: "shipped" },
        { id: 104, customer: "Dilan", total: 8, status: "open" },
        { id: 105, customer: "Emil", total: 230, status: "shipped" },
        { id: 106, customer: "Femke", total: 54, status: "open" },
    ];

    private get rows(): { id: number; customer: string; total: number; status: string }[] {
        return this.orders.slice(this.orders.length - 3);
    }
}