@page "/datagrid"

<h1>DataGrid</h1>
<p class="intro">
    The templated grid (4.2): a column list builds header and body —
    <code>format</code> shapes the cell text, <code>align</code> right-aligns
    numbers, and <code>cellContent</code> replaces a cell with your own
    fragment. Rows arrive typed; filter, sort and paging stay app-side.
</p>

<section class="demo">
    <DataGrid items="@this.rows" columns="@this.columns" striped="true" hover="true" />
    <p class="echo">Showing @this.rows.length of @this.orders.length orders.</p>
</section>

@code {
    private orders: { customer: string; placed: string; total: number }[] = [
        { customer: "Alice", placed: "2026-01-02", total: 42.5 },
        { customer: "Bruno", placed: "2026-01-05", total: 17 },
        { customer: "Chiara", placed: "2026-01-09", total: 99 },
        { customer: "Dilan", placed: "2026-01-13", total: 8 },
    ];

    /** Column list — the DataGridColumn&lt;T&gt; shape from @tsazor/fluent (datagrid-columns.ts). */
    private columns: { field: string; title?: string; align?: "start" | "center" | "end"; format?: (row: { customer: string; placed: string; total: number }) => string }[] = [
        { field: "customer", title: "Customer" },
        { field: "placed", title: "Placed" },
        { field: "total", title: "Total (€)", align: "end", format: (row) => row.total.toFixed(2) },
    ];

    private get rows(): { customer: string; placed: string; total: number }[] {
        return this.orders;
    }
}