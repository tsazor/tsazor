@page "/datagrid"
@import { GridSort, PaginationState } from "@tsazor/fluent"
@import type { GalleryOrder } from "./gallery-order"

<h1>DataGrid</h1>
<p class="intro">
    QuickGrid-shaped: the columns are child components and take the row type from the grid, so
    <code>Property="(o) => o.customer"</code> is typed. Click a header to sort; the paginator pages;
    the checkboxes select rows. <code>Format</code> shapes a cell's text, <code>Align="end"</code>
    right-aligns numbers, and a <code>TemplateColumn</code> renders its own content per row.
</p>

<section class="demo">
    <DataGrid Items="@orders" Pagination="@pagination" SelectionMode="multiple" @bind-SelectedItems="selected" AriaLabel="Orders" Striped="@true" Hover="@true">
        <PropertyColumn Property="(o) => o.customer" Title="Customer" Sortable="@true" IsDefaultSortColumn="@true" />
        <PropertyColumn Property="(o) => o.placed" Title="Placed" Sortable="@true" />
        <PropertyColumn Property="(o) => o.total" Title="Total (€)" Format="(v) => v.toFixed(2)" Align="end" Sortable="@true" />
        <TemplateColumn Title="Status" Context="order" SortBy="@byStatus">
            <Badge Intent="@(order.paid ? "success" : "warning")" Appearance="subtle">@(order.paid ? "paid" : "open")</Badge>
        </TemplateColumn>
    </DataGrid>
    <Paginator State="@pagination" />
    <p class="echo">@selected.length selected</p>
</section>

@code {
    private readonly orders: GalleryOrder[] = [
        { customer: "Alice", placed: "2026-01-02", total: 42.5, paid: true },
        { customer: "Bruno", placed: "2026-01-05", total: 17, paid: false },
        { customer: "Chiara", placed: "2026-01-09", total: 99, paid: true },
        { customer: "Dilan", placed: "2026-01-13", total: 8, paid: false },
        { customer: "Emil", placed: "2026-01-14", total: 23.9, paid: true },
        { customer: "Fatma", placed: "2026-01-18", total: 61, paid: false },
        { customer: "Greta", placed: "2026-01-21", total: 12.4, paid: true },
    ];
    private readonly pagination = new PaginationState();
    private selected: GalleryOrder[] = [];
    private readonly byStatus = GridSort.byAscending((o: GalleryOrder) => o.paid).thenAscending((o) => o.customer);

    protected override onInitialized(): void {
        this.pagination.itemsPerPage = 5;
    }
}
