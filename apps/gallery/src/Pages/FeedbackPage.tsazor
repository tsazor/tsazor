@page "/feedback"

<h1>Feedback</h1>
<p class="intro">
    <code>ToastProvider</code> is a cascading service — any child grabs it and calls
    <code>show()</code>. Toasts auto-dismiss after their timeout; error toasts use
    <code>role="alert"</code>. ToastPanel below is a real nested component using the cascade.
</p>

<ToastProvider position="top-right">
    <div class="demo">
        <h2>Badges</h2>
        <div class="demo-row">
            <Badge>Filled</Badge>
            <Badge appearance="subtle">Subtle</Badge>
            <Badge color="success">Success</Badge>
            <Badge color="warning">Warning</Badge>
            <Badge color="error">Error</Badge>
            <Badge size="small">Small</Badge>
        </div>
    </div>

    <div class="demo">
        <h2>Spinner &amp; Card</h2>
        <div class="demo-row">
            <Spinner size="small" />
            <Spinner />
            <Spinner size="large" />
        </div>
        <Card>
            <CardHeader>Cards hold any content</CardHeader>
            Fluent 2 standard card with divider and footer.
            <CardFooter>
                <Divider appearance="subtle" />
                <div class="demo-row">
                    <Button appearance="subtle">Later</Button>
                    <Button appearance="primary">Do it</Button>
                </div>
            </CardFooter>
        </Card>
    </div>

    <ToastPanel />
</ToastProvider>