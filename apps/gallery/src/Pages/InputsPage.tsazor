@page "/inputs"

<h1>Inputs</h1>
<p class="intro">
    Fluent form controls built on the runtime's <code>InputBase</code> — state,
    <code>fieldClass</code> and <code>@@bind</code> round-trips come from core, only the Fluent chrome lives here.
</p>

<div class="card">
    <div class="field">
        <TextInput @bind="this.model.name" label="Name" placeholder="Your name" id="demo-name" />
        <p class="echo"><code>name</code> = "@this.model.name"</p>
    </div>
    <div class="field">
        <TextArea @bind="this.model.notes" label="Notes" rows="3" id="demo-notes" />
        <p class="echo"><code>notes</code> = "@this.model.notes"</p>
    </div>
    <div class="field">
        <NumberInput @bind="this.model.age" label="Age" id="demo-age" />
        <p class="echo"><code>age</code> = "@this.model.age"</p>
    </div>
    <div class="field">
        <Checkbox @bind="this.model.agree" label="Subscribe to updates" id="demo-agree" />
        <p class="echo"><code>agree</code> = "@this.agreeText"</p>
    </div>
    <div class="field">
        <Switch @bind="this.model.compact" label="Compact mode" id="demo-compact" />
        <p class="echo"><code>compact</code> = "@this.compactText"</p>
    </div>
    <div class="field">
        <Select @bind="this.model.topic" label="Topic" id="demo-topic">
            <option value="general">General</option>
            <option value="support">Support</option>
            <option value="feedback">Feedback</option>
        </Select>
        <p class="echo"><code>topic</code> = "@this.model.topic"</p>
    </div>
    <div class="field">
        <Slider @bind="this.model.volume" label="Volume" step="10" tickMarks="true" valueLabel="true" valueFormat="@this.percent" id="demo-volume" />
        <p class="echo"><code>volume</code> = @this.model.volume</p>
    </div>
</div>

@code {
    private model = { name: "Ada", notes: "", age: 18, agree: false, compact: false, topic: "general", volume: 60 };
    private readonly percent = (value: number): string => `${value} %`;

    private get agreeText(): string {
        return this.model.agree ? "true" : "false";
    }

    private get compactText(): string {
        return this.model.compact ? "true" : "false";
    }
}