@page "/table"

<h1>Table</h1>
<p class="intro">
    Generic <code>Table</code> chrome around your rows — filter, sort and paging
    belong to the app. Rows arrive through <code>rowContent</code>, headers through
    <code>headerContent</code>; the dashboard page shows the full pattern.
</p>

<section class="demo">
    <div class="table-toolbar">
        <TextInput @bind="this.filter" placeholder="Filter by customer…" id="table-filter" />
        <Button onClick="@(() => this.reset())" appearance="subtle">Reset rows</Button>
    </div>
    <Table items="@this.rows" headerContent="@this.header" rowContent="@this.rowFor" striped="true" hover="true" colSpan="2" />
    <p class="echo">Showing @this.rows.length of @this.pool.length rows.</p>
</section>

@code {
    private filter = "";

    private pool = [
        { customer: "Alice", total: 42 },
        { customer: "Bruno", total: 17 },
        { customer: "Chiara", total: 99 },
        { customer: "Dilan", total: 8 },
    ];

    private get rows(): { customer: string; total: number }[] {
        const needle = this.filter.trim().toLowerCase();
        if (!needle) return this.pool;
        return this.pool.filter((row) => row.customer.toLowerCase().includes(needle));
    }

    private header: RenderFragment = (b) => {
        b.openElement(0, "tr");
        b.openElement(1, "th");
        b.addContent(2, "Customer");
        b.closeElement();
        b.openElement(3, "th");
        b.addContent(4, "Total (€)");
        b.closeElement();
        b.closeElement();
    };

    private rowFor = (row: { customer: string; total: number }): RenderFragment => (b) => {
        b.openElement(0, "tr");
        b.openElement(1, "td");
        b.addContent(2, row.customer);
        b.closeElement();
        b.openElement(3, "td");
        b.addContent(4, String(row.total));
        b.closeElement();
        b.closeElement();
    };

    private reset(): void {
        this.filter = "";
        this.stateHasChanged();
    }
}