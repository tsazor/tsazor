@page "/table"

<h1>Table</h1>
<p class="intro">
    Generic <code>Table</code> chrome around your rows — filter, sort and paging
    belong to the app. Rows arrive through the <code>RowContent</code> template, headers through
    <code>HeaderContent</code>; the dashboard page shows the full pattern.
</p>

<section class="demo">
    <div class="table-toolbar">
        <TextInput @bind="this.filter" placeholder="Filter by customer…" id="table-filter" />
        <Button onClick="@(() => this.reset())" appearance="subtle">Reset rows</Button>
    </div>
    <Table items="@this.rows" striped="true" hover="true" colSpan="2">
        <HeaderContent>
            <tr><th>Customer</th><th>Total (€)</th></tr>
        </HeaderContent>
        <RowContent Context="row">
            <tr><td>@row.customer</td><td>@row.total</td></tr>
        </RowContent>
    </Table>
    <p class="echo">Showing @this.rows.length of @this.pool.length rows.</p>
</section>

@code {
    private filter = "";

    private pool = [
        { customer: "Alice", total: 42 },
        { customer: "Bruno", total: 17 },
        { customer: "Chiara", total: 99 },
        { customer: "Dilan", total: 8 },
    ];

    private get rows(): { customer: string; total: number }[] {
        const needle = this.filter.trim().toLowerCase();
        if (!needle) return this.pool;
        return this.pool.filter((row) => row.customer.toLowerCase().includes(needle));
    }

    private reset(): void {
        this.filter = "";
        this.stateHasChanged();
    }
}