@import { Toaster } from "@tsazor/fluent"
@inject Toaster toaster

<div class="demo">
    <h2>Toasts</h2>
    <div class="demo-row">
        <Button onClick="@(() => this.show("info", "Release notes are available."))">Info toast</Button>
        <Button onClick="@(() => this.show("success", "Saved."))">Success toast</Button>
        <Button onClick="@(() => this.show("warning", "Disk almost full."))">Warning toast</Button>
        <Button onClick="@(() => this.show("danger", "Upload failed."))">Error toast</Button>
    </div>
</div>

@code {
    private show(intent: "info" | "success" | "warning" | "danger", message: string): void {
        this.toaster.show({ message, intent, timeout: 4000 });
    }
}
