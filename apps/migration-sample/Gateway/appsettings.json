{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Tsazor": {
    "Routes": [ "/orders" ]
  },
  "ReverseProxy": {
    "Routes": {
      "blazor": {
        "ClusterId": "blazor",
        "Match": { "Path": "{**catch-all}" }
      }
    },
    "Clusters": {
      "blazor": {
        "Destinations": {
          "legacy": { "Address": "http://localhost:5411/" }
        }
      }
    }
  }
}
