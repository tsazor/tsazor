@page "/orders"
@authorize
@inject OrdersClient Orders

<PageTitle>Orders · Bakery admin</PageTitle>

<h1>Orders</h1>
@if (!orders) {
    <p role="status">Loading…</p>
} else {
    <table class="grid">
        <thead><tr><th>#</th><th>Customer</th><th>Item</th><th>Total</th><th>Status</th></tr></thead>
        <tbody>
            @foreach (const order of orders) {
                <tr @key="order.id">
                    <td><a href="@("orders/" + order.id)">@order.id</a></td>
                    <td>@order.customer</td>
                    <td>@order.item</td>
                    <td>@order.total.toFixed(2)</td>
                    <td>@order.status</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private orders?: Order[];

    protected override async onInitialized(): Promise<void> {
        this.orders = await this.Orders.getOrders();
    }
}
