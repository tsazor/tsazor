@page "/structure"
@import type { TreeViewItem } from "@tsazor/bootstrap"
@import { icons } from "../skin-icons"

<Typography Variant="h1">Structure</Typography>

<Breadcrumb>
    <BreadcrumbItem Href="/">Overview</BreadcrumbItem>
    <BreadcrumbItem Active="@true">Structure</BreadcrumbItem>
</Breadcrumb>

<section class="demo">
    <Typography Variant="h2">Tabs and accordion</Typography>
    <Tabs AriaLabel="Order details">
        <Tab Title="Items">Two sourdough loaves, one rye.</Tab>
        <Tab Title="Delivery">Tomorrow, 7:00.</Tab>
        <Tab Title="Invoice">Sent on delivery.</Tab>
    </Tabs>
    <Accordion>
        <AccordionItem Title="Delivery">We bake at 4 and deliver from 6 in the morning.</AccordionItem>
        <AccordionItem Title="Payment">Invoice, card or cash on delivery.</AccordionItem>
    </Accordion>
</section>

<section class="demo">
    <Typography Variant="h2">Feedback</Typography>
    <Stack Gap="s" Wrap="@true" Align="center">
        <Badge Intent="primary">New</Badge>
        <Badge Intent="success">Paid</Badge>
        <Badge Intent="warning">Open</Badge>
        <Badge Intent="danger">Overdue</Badge>
        <Spinner Size="small" />
        <Spinner Label="Loading orders…" />
    </Stack>
    <Alert Intent="warning" Dismissible="@true">The oven is being serviced on Monday.</Alert>
    <div class="demo-row" role="region" aria-busy="true" aria-label="Loading the customer">
        <Skeleton Shape="circle" Width="48px" />
        <div style="flex: 1"><Skeleton Lines="2" /></div>
    </div>
</section>

<section class="demo">
    <Typography Variant="h2">Pagination and collapse</Typography>
    <Pagination Page="@currentPage" PageCount="7" OnPageChanged="@((p: number) => this.currentPage = p)" />
    <Typography Variant="caption"><span class="page-echo">Page @currentPage of 7</span></Typography>
    <Divider />
    <Button Appearance="outline" OnClick="@(() => this.detailsOpen = !this.detailsOpen)" aria-expanded="@(detailsOpen ? "true" : "false")">Details</Button>
    <Collapse IsOpen="@detailsOpen">
        <p class="details">Sourdough rests 18 hours; rye 12.</p>
    </Collapse>
</section>

<section class="demo">
    <Typography Variant="h2">Splitter</Typography>
    <Splitter class="demo-splitter" OnResize="@((args) => this.resized = `Pane ${args.paneIndex + 1}: ${Math.round(args.newSize)}%`)">
        <SplitterPane Size="25%" Min="15%" Collapsible="@true" Label="Resize the orders">
            <div class="pane-body">Orders</div>
        </SplitterPane>
        <SplitterPane Min="20%" Label="Resize the order">
            <div class="pane-body">Order 1042</div>
        </SplitterPane>
        <SplitterPane Size="30%" Min="20%" Max="50%">
            <div class="pane-body">Notes</div>
        </SplitterPane>
    </Splitter>
    <Typography Variant="caption"><span class="splitter-echo">@resized</span></Typography>
</section>

<section class="demo">
    <Typography Variant="h2">Sortable lists</Typography>
    <div class="sortable-demo">
        <div>
            <span class="sortable-title" id="bakes-title">Today's bakes</span>
            <SortableList aria-labelledby="bakes-title" Group="bakery" ItemFilter="@isSignature" @bind-Items="bakes">
                <ItemTemplate Context="bread">@bread</ItemTemplate>
            </SortableList>
        </div>
        <div>
            <span class="sortable-title" id="sold-title">Sold out</span>
            <SortableList aria-labelledby="sold-title" Group="bakery" @bind-Items="soldOut">
                <ItemTemplate Context="bread">@bread</ItemTemplate>
            </SortableList>
        </div>
    </div>
    <Typography Variant="caption">
        Bakes: <span class="sortable-bakes">@bakes.join(", ")</span>. Sold out: <span class="sortable-sold">@soldOut.join(", ")</span>.
    </Typography>
</section>

<section class="demo">
    <Typography Variant="h2">Overflow</Typography>
    <div class="overflow-demo" style="@(`width: ${overflowWidth}`)">
        <Overflow Items="@steps" role="group" aria-label="Order steps">
            <ItemTemplate Context="step"><Button OnClick="@(() => this.stepped = step)">@step</Button></ItemTemplate>
        </Overflow>
    </div>
    <div class="demo-row">
        <Button OnClick="@(() => this.overflowWidth = this.overflowWidth === "18rem" ? "48rem" : "18rem")">Toggle the width</Button>
        <Typography Variant="caption">Last step: <span class="overflow-echo">@stepped</span>.</Typography>
    </div>
</section>

<section class="demo">
    <Typography Variant="h2">Tree and side navigation</Typography>
    <div class="tree-demo">
        <SidebarNav AriaLabel="Sections" Links="@sections" />
        <SidebarNav AriaLabel="Sections, compact" Links="@sections" Compact="@true" />
        <TreeView AriaLabel="Menu" Items="@menu" @bind-SelectedItem="picked" />
    </div>
    <Typography Variant="caption">Picked: <span class="tree-picked">@(picked?.text ?? "nothing")</span>.</Typography>
</section>

@code {
    private readonly steps = ["Bake", "Slice", "Wrap", "Label", "Pack", "Ship", "Invoice"];
    private stepped = "";
    private overflowWidth = "18rem";
    private readonly menu: TreeViewItem[] = [
        { id: "breads", text: "Breads", items: [{ id: "rye", text: "Rye" }, { id: "spelt", text: "Spelt" }, { id: "sourdough", text: "Sourdough" }] },
        { id: "pastries", text: "Pastries", items: [{ id: "croissant", text: "Croissant" }, { id: "danish", text: "Danish", disabled: true }] },
        { id: "drinks", text: "Drinks" },
    ];
    private picked: TreeViewItem | null = null;
    private readonly sections = [
        { href: "/", label: "Overview", match: NavLinkMatch.All, icon: icons.folder },
        { href: "/forms", label: "Forms", icon: icons.save },
        { href: "/structure", label: "Structure", icon: icons.settings },
    ];
    private bakes = ["Sourdough (fixed)", "Rye", "Spelt", "Brioche"];
    private soldOut = ["Pretzel"];
    private readonly isSignature = (bread: string): boolean => bread.startsWith("Sourdough");
    private resized = "Drag a bar, or focus it and use the arrows.";
    private currentPage = 2;
    private detailsOpen = false;
}
