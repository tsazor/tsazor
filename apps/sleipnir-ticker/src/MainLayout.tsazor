@inherits LayoutComponentBase
@inject TickerStore Store

<div class="layout">
    <nav class="nav">
        <span class="brand">Sleipnir Ticker</span>
        <NavLink Href="/" Match="@NavLinkMatch.All">Live</NavLink>
        <NavLink Href="/history">Verlauf</NavLink>
        <span class="status-slot">
            <Badge Variant="@this.Store.statusVariant">@this.Store.statusText</Badge>
        </span>
    </nav>
    <main class="main page">
        @Body
    </main>
</div>

@code {
    protected override onInitialized(): void {
        // The layout always shows the connection state — it observes the store itself.
        this.observe(this.Store);
    }
}

<style>
    .layout { font-family: system-ui, sans-serif; }
    .nav { display: flex; gap: 1rem; padding: 0.75rem 1rem; border-bottom: 1px solid #ddd; align-items: center; }
    .nav a { text-decoration: none; color: #0366d6; }
    .nav a.active { font-weight: 700; text-decoration: underline; }
    .brand { font-weight: 700; margin-right: 1rem; }
    .status-slot { margin-left: auto; }
    .main { padding: 1rem; max-width: 900px; margin: 0 auto; }
    .not-found { color: #b3261e; }
</style>