@page "/history"
@inject TickerStore Store

<div class="history-page">
    <h1>History</h1>
    <p class="text-muted">@this.Store.points.length recorded price points (newest first).</p>

    @if (this.Store.points.length === 0) {
        <p class="loading">No data yet…</p>
    } else {
        <table class="history-table">
            <thead>
                <tr><th>Time</th><th>Price</th></tr>
            </thead>
            <tbody>
                @for (const point of this.reversed) {
                    <tr>
                        <td>@this.cellTime(point.t)</td>
                        <td>@this.cellPrice(point.price)</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private reversed: PricePoint[] = [];

    protected override onInitialized(): void {
        this.observe(this.Store, () => this.updateRows());
        this.updateRows();
    }

    private updateRows(): void {
        this.reversed = [...this.Store.points].reverse().slice(0, 120);
    }

    private cellTime(t: number | undefined): string {
        return t === undefined ? "—" : new Date(t).toTimeString().slice(0, 8);
    }

    private cellPrice(price: number | undefined): string {
        return price === undefined ? "—" : price.toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }
}