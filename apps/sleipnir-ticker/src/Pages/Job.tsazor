@page "/jobs/{jobId:int}"
@import JobWatch from "../JobWatch"
@import { formatPct, formatUsd } from "../formatters.mjs"
@import { jobVariant } from "../jobs.mjs"
@inject SleipnirClient Client

<div class="job-page">
    <p><NavLink Href="/jobs">← All jobs</NavLink></p>
    <h1>Job #@this.jobId</h1>

    @if (this.watch.error !== null) {
        <Alert Intent="danger">@this.watch.error</Alert>
    }

    <Card>
        <CardBody>
            <Progress Value="@(this.watch.latest?.percent ?? 0)" Striped="@(!this.watch.completed)" Animated="@(!this.watch.completed)"
                      Intent="@jobVariant(this.watch.latest?.state)" Label="@(`${this.watch.latest?.percent ?? 0} %`)" AriaLabel="Job progress" />
            <p class="job-state" role="status">@this.stateText</p>
            @if (this.watch.latest?.result) {
                <dl class="job-result">
                    <dt>Min</dt><dd>@formatUsd(this.watch.latest.result.min)</dd>
                    <dt>Max</dt><dd>@formatUsd(this.watch.latest.result.max)</dd>
                    <dt>Average</dt><dd>@formatUsd(this.watch.latest.result.average)</dd>
                    <dt>Change</dt><dd>@formatPct(this.watch.latest.result.changePercent)</dd>
                </dl>
            }
        </CardBody>
    </Card>

    <Card>
        <CardHeader>Events (@this.watch.events.length)</CardHeader>
        <CardBody>
            <ListGroup Flush="@true">
                @for (const event of this.watch.events) {
                    <ListGroupItem>
                        <span class="seq">#@event.seq</span>
                        <span class="msg">@event.message</span>
                    </ListGroupItem>
                }
            </ListGroup>
        </CardBody>
    </Card>
</div>

@code {
    @Parameter() jobId!: number;

    private watch!: JobWatch;
    private stopWatch: (() => void) | null = null;

    protected override onParametersSet(): void {
        if (this.watch?.jobId === this.jobId) return;
        // One subscription per job: a new jobId (same page instance) ends the previous one;
        // disposing the page ends the current one (both through the signal).
        this.stopWatch?.();
        const controller = new AbortController();
        this.disposeSignal.addEventListener("abort", () => controller.abort(), { once: true });
        this.watch = new JobWatch(this.Client, this.jobId, controller.signal);
        const stopObserving = this.observe(this.watch);
        this.stopWatch = () => {
            stopObserving();
            controller.abort();
        };
    }

    private get stateText(): string {
        if (this.watch.error !== null) return "failed";
        if (this.watch.completed) return "completed";
        return this.watch.latest === null ? "waiting for the first event…" : "running";
    }
}

<style>
    .job-page { display: grid; gap: 1rem; }
    .job-state { margin: 0.75rem 0 0; }
    .job-result { display: grid; grid-template-columns: max-content 1fr; gap: 0.25rem 1rem; margin: 0.75rem 0 0; }
    .job-result dd { margin: 0; }
    .seq { color: #6c757d; margin-right: 0.5rem; }
</style>
