@page "/jobs/{jobId:int}"
@import { jobProgress } from "../job-progress"
@import type { JobProgress } from "../api"
@import { formatPct, formatUsd } from "../formatters.mjs"
@import { jobVariant } from "../jobs.mjs"
@inject SleipnirClient Client

<div class="job-page">
    <p><NavLink Href="/jobs">← All jobs</NavLink></p>
    <h1>Job #@this.jobId</h1>

    @if (this.error !== null) {
        <Alert Intent="danger">@this.error</Alert>
    }

    <Card>
        <CardBody>
            <Progress Value="@(this.latest?.percent ?? 0)" Striped="@(!this.completed)" Animated="@(!this.completed)"
                      Intent="@jobVariant(this.latest?.state)" Label="@(`${this.latest?.percent ?? 0} %`)" AriaLabel="Job progress" />
            <p class="job-state" role="status">@this.stateText</p>
            @if (this.latest?.result) {
                <dl class="job-result">
                    <dt>Min</dt><dd>@formatUsd(this.latest.result.min)</dd>
                    <dt>Max</dt><dd>@formatUsd(this.latest.result.max)</dd>
                    <dt>Average</dt><dd>@formatUsd(this.latest.result.average)</dd>
                    <dt>Change</dt><dd>@formatPct(this.latest.result.changePercent)</dd>
                </dl>
            }
        </CardBody>
    </Card>

    <Card>
        <CardHeader>Events (@this.events.length)</CardHeader>
        <CardBody>
            <ListGroup Flush="@true">
                @for (const event of this.events) {
                    <ListGroupItem>
                        <span class="seq">#@event.seq</span>
                        <span class="msg">@event.message</span>
                    </ListGroupItem>
                }
            </ListGroup>
        </CardBody>
    </Card>
</div>

@code {
    @Parameter() jobId!: number;

    /** The job's events in `seq` order, each once. */
    private events: JobProgress[] = [];
    /** True once the server completed the stream (the job is over). */
    private completed = false;
    private error: string | null = null;
    private watchedId: number | null = null;
    private stopWatching: (() => void) | null = null;

    protected override onParametersSet(): void {
        if (this.watchedId === this.jobId) return;
        // One subscription per job: a new jobId (same page instance) stops the previous one; disposing the page
        // stops the current one.
        this.stopWatching?.();
        this.watchedId = this.jobId;
        this.events = [];
        this.completed = false;
        this.error = null;
        this.stopWatching = this.observe(jobProgress(this.Client, this.jobId), {
            next: (event) => { this.events = [...this.events, event]; },
            complete: () => { this.completed = true; },
            error: (err) => { this.error = err instanceof Error ? err.message : String(err); },
        });
    }

    /** The newest event (null before the first). */
    private get latest(): JobProgress | null {
        return this.events.at(-1) ?? null;
    }

    private get stateText(): string {
        if (this.error !== null) return "failed";
        if (this.completed) return "completed";
        return this.latest === null ? "waiting for the first event…" : "running";
    }
}

<style>
    .job-page { display: grid; gap: 1rem; }
    .job-state { margin: 0.75rem 0 0; }
    .job-result { display: grid; grid-template-columns: max-content 1fr; gap: 0.25rem 1rem; margin: 0.75rem 0 0; }
    .job-result dd { margin: 0; }
    .seq { color: #6c757d; margin-right: 0.5rem; }
</style>
