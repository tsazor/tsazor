@page "/"
@inject TickerStore Store

<div class="ticker-page">
    @if (this.Store.lastError !== null) {
        <Alert Intent="danger">@this.Store.lastError</Alert>
    }

    <Card>
        <CardBody>
            <p class="ticker-price" role="status">
                <span class="price">@this.Store.priceText</span>
                <Badge Intent="@this.Store.changeVariant">@this.Store.changeText</Badge>
            </p>
            <div class="ticker-stats">
                <Card>
                    <CardBody>
                        <div class="stat-card">
                            <span class="stat-label">24h high</span>
                            <span class="stat-value">@this.Store.highText</span>
                        </div>
                    </CardBody>
                </Card>
                <Card>
                    <CardBody>
                        <div class="stat-card">
                            <span class="stat-label">24h low</span>
                            <span class="stat-value">@this.Store.lowText</span>
                        </div>
                    </CardBody>
                </Card>
                <Card>
                    <CardBody>
                        <div class="stat-card">
                            <span class="stat-label">Volume (base)</span>
                            <span class="stat-value">@this.Store.volumeText</span>
                        </div>
                    </CardBody>
                </Card>
                <Card>
                    <CardBody>
                        <div class="stat-card">
                            <span class="stat-label">Volume (Quote)</span>
                            <span class="stat-value">@this.Store.quoteVolumeText</span>
                        </div>
                    </CardBody>
                </Card>
            </div>
            <div class="sync-line">Last update: @this.Store.updatedText · @this.Store.statusText</div>
        </CardBody>
    </Card>

    <Card>
        <CardHeader>History (60 s)</CardHeader>
        <CardBody>
            <Sparkline Points="@this.Store.points" />
        </CardBody>
    </Card>

    <Card>
        <CardHeader>Incoming ticks</CardHeader>
        <CardBody>
            <EventLog Entries="@this.Store.log" />
        </CardBody>
    </Card>
</div>

@code {
    protected override onInitialized(): void {
        // Page re-renders on every store tick (push, not polling); unsubscribed on dispose.
        this.observe(this.Store);
    }
}