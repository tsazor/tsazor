@import { rollDie } from "./dice"

<button @onclick="roll" disabled="@rolling">Roll the die</button>
<p>@message</p>

@code {
    message = "Click to roll.";
    rolling = false;

    async roll() {
        this.rolling = true;
        this.message = "Rolling…";
        const value = await rollDie();
        this.message = `You rolled a ${value}.`;
        this.rolling = false;
    }
}
