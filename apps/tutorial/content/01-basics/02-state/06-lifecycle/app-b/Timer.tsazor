<p>The timer has been running for @seconds s.</p>

@code {
    seconds = 0;
    private interval?: ReturnType<typeof setInterval>;

    override onInitialized() {
        this.interval = setInterval(() => {
            this.seconds++;
            this.stateHasChanged();
        }, 1000);
    }

    dispose() {
        clearInterval(this.interval);
    }
}
