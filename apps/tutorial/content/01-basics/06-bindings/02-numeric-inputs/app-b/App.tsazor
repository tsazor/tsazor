<label>
    <input type="number" @bind="a" min="0" max="10" />
    <input type="range" @bind="a" min="0" max="10" />
</label>

<label>
    <input type="number" @bind="b" min="0" max="10" />
    <input type="range" @bind="b" min="0" max="10" />
</label>

<p>@a + @b = @(a + b)</p>

@code {
    a = 1;
    b = 2;
}
