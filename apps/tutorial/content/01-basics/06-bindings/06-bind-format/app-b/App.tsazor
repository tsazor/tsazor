<label>
    Price per kilo (€)
    <input type="number" step="0.01" min="0" @bind="price" @bind:format="F2" />
</label>

<label>
    Delivery date
    <input type="date" @bind="delivery" />
</label>

<p>2.5 kg cost @((price * 2.5).toFixed(2)) €, delivered on @delivery.toDateString().</p>

@code {
    price = 4.5;
    delivery = new Date(2026, 9, 2);
}
