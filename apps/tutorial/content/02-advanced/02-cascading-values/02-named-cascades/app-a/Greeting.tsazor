<p class="greeting @theme">@greetings[language] <small>(theme: @theme, language: @language)</small></p>

@code {
    @CascadingParameter({ type: String }) theme = "light";
    @CascadingParameter({ type: String }) language = "en";

    greetings: Record<string, string> = { en: "Hello!", de: "Hallo!", fr: "Bonjour !" };
}
