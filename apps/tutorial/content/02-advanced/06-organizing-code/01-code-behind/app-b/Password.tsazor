<label>
    Choose a password
    <input type="password" @bind="password" @bind:event="oninput" />
</label>

<div class="meter meter--@level">
    <div class="fill" style="width: @(score * 25)%"></div>
</div>
<p class="verdict">@verdict</p>

<ul class="hints">
    @foreach (const hint of hints) {
        <li>@hint</li>
    }
</ul>
