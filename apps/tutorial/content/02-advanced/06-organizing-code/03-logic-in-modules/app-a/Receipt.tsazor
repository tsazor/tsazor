@import { formatMoney, type Line } from "./pricing"

@{
    let subtotal = 0;
    for (const line of lines) {
        subtotal += line.price * line.quantity;
    }
    const discount = subtotal >= 40 ? Math.round(subtotal * 10) / 100 : 0;
    const shipping = subtotal - discount >= 30 ? 0 : 4.9;
    const total = subtotal - discount + shipping;
}

<table class="receipt">
    @foreach (const line of lines) {
        <tr>
            <td>@line.quantity × @line.name</td>
            <td>@formatMoney(line.price * line.quantity)</td>
        </tr>
    }
    <tr class="sum"><td>Subtotal</td><td>@formatMoney(subtotal)</td></tr>
    <tr><td>Discount (10% from €40)</td><td>−@formatMoney(discount)</td></tr>
    <tr><td>Shipping</td><td>@(shipping === 0 ? "free" : formatMoney(shipping))</td></tr>
    <tr class="sum"><td>Total</td><td>@formatMoney(total)</td></tr>
</table>

@code {
    @Parameter() lines: Line[] = [];
}
