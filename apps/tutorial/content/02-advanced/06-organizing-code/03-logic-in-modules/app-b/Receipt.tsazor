@import { formatMoney, totals, type Line } from "./pricing"

<table class="receipt">
    @foreach (const line of lines) {
        <tr>
            <td>@line.quantity × @line.name</td>
            <td>@formatMoney(line.price * line.quantity)</td>
        </tr>
    }
    <tr class="sum"><td>Subtotal</td><td>@formatMoney(sum.subtotal)</td></tr>
    <tr><td>Discount (10% from €40)</td><td>−@formatMoney(sum.discount)</td></tr>
    <tr><td>Shipping</td><td>@(sum.shipping === 0 ? "free" : formatMoney(sum.shipping))</td></tr>
    <tr class="sum"><td>Total</td><td>@formatMoney(sum.total)</td></tr>
</table>

@code {
    @Parameter() lines: Line[] = [];

    get sum() {
        return totals(this.lines);
    }
}
