@import type { Todo } from "./Todo"
@import { send, receive } from "./motion"
@import { flip } from "@tsazor/runtime/animate"

<ul class="todos">
    @foreach (const todo of Todos) {
        <li @key="todo.id" @in="receive({ key: todo.id })" @out="send({ key: todo.id })" @animate="flip">
            <label>
                <input type="checkbox" checked="@todo.done" @onchange="() => onToggle?.invokeAsync(todo)" />
                @todo.description
            </label>
        </li>
    }
</ul>

@code {
    @Parameter() Todos: Todo[] = [];
    @Parameter() onToggle?: EventCallback<Todo>;
}
