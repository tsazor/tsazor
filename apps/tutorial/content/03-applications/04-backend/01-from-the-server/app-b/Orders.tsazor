@page "/orders"
@authorize({ roles: ["baker"] })
@import { SupplyParameterFromQuery, TsazorHttp } from "@tsazor/runtime"
@import { Order } from "./Order.ts"
@inject TsazorHttp http
<h2>Orders</h2>
<nav class="filters">
    <a href="/orders">All</a>
    <a href="/orders?state=open">Open</a>
    <a href="/orders?state=picked-up">Picked up</a>
</nav>
@if (orders === null) {
    <p class="loading">Loading…</p>
} else {
    <ul class="orders">
        @foreach (const order of shown) {
            <li>#@order.id @order.customer (@order.state)</li>
        }
    </ul>
}

@code {
    @Parameter() @SupplyParameterFromQuery() state: string | null = null;
    orders: Order[] | null = null;

    override async onInitialized() {
        this.orders = await this.http.getJson<Order[]>("/api/orders");
    }

    get shown() {
        const orders = this.orders ?? [];
        return this.state === null ? orders : orders.filter((order) => order.state === this.state);
    }
}
