@import { CultureService, StringLocalizer } from "@tsazor/runtime"
@inject StringLocalizer L
@inject CultureService culture
<nav class="languages">
    <button @onclick="@(() => switchTo("en-US"))">English</button>
    <button @onclick="@(() => switchTo("de-DE"))">Deutsch</button>
</nav>
<h1>@L.get("Title")</h1>
<p class="greeting">@L.get("Greeting", { name: "Marta" })</p>
<p class="loaf">@L.get("Sourdough"): <span class="price">€@price.toFixed(2)</span></p>
<p class="baked">@L.get("Baked", { date: bakedOn.toISOString().slice(0, 10) })</p>

@code {
    price = 3.4;
    bakedOn = new Date(2026, 9, 5, 12); // noon: the same date in nearly every time zone

    switchTo(name: string) {
        this.culture.setExplicit(name);
    }
}
