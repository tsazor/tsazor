{
  "name": "tutorial",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Interactive Tsazor tutorial (two tracks: Blazor and TypeScript), built in Tsazor.",
  "scripts": {
    "build": "tsazor check src && vite build",
    "dev": "vite",
    "preview": "vite preview",
    "test": "vitest run",
    "check": "tsazor check src",
    "verify": "node scripts/verify.mjs",
    "build:pages": "vite build && node -e \"require('fs').copyFileSync('dist/index.html', 'dist/404.html')\"",
    "verify:pages": "node scripts/verify-pages.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@jridgewell/gen-mapping": "^0.3.13",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@lezer/highlight": "^1.2.5",
    "@tsazor/compiler": "workspace:*",
    "@tsazor/bootstrap": "workspace:*",
    "@tsazor/dotnet": "workspace:*",
    "@tsazor/lsp": "workspace:*",
    "@tsazor/runtime": "workspace:*",
    "@tsazor/vite-plugin": "workspace:*",
    "@tsazor/workspace": "workspace:*"
  },
  "devDependencies": {
    "@tsazor/cli": "workspace:*",
    "@tsazor/testing": "workspace:*",
    "esbuild": "^0.28.2",
    "happy-dom": "^18.0.1",
    "marked": "^18.0.14",
    "playwright-core": "^1.63.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.7"
  }
}
