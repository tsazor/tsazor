@page "/reference/components/{packageSlug}/{name}"
@import reference from "virtual:tutorial-reference"
@import type { ReferenceComponent, ReferencePackage } from "../../reference-types"

<PageTitle>@(component?.name ?? "Not found") · Tsazor reference</PageTitle>
<ReferenceShell Section="components" PackageSlug="@packageSlug" ComponentName="@name">
    @if (pkg && component) {
        <p class="crumbs"><a href="reference">Reference</a> / <a href="@("reference/components/" + pkg.slug)">@pkg.name</a></p>
        <h1>
            <code>@component.name</code>
            @if (component.baseClass) {
                <span class="tag">base class</span>
            }
        </h1>
        <Prose Html="@component.doc" />
        <LearnIn Lessons="@(component.learnIn ?? [])" />

        @if (component.typeParameters.length > 0 || component.extends) {
            <dl class="facts">
                @if (component.typeParameters.length > 0) {
                    <dt>Type parameters</dt>
                    <dd><code>@component.typeParameters.join(", ")</code></dd>
                }
                @if (component.extends) {
                    <dt>Extends</dt>
                    <dd>
                        @if (baseHref) {
                            <a href="@baseHref"><code>@component.extends</code></a>
                        } else {
                            <code>@component.extends</code>
                        }
                    </dd>
                }
            </dl>
        }

        <h2>Parameters</h2>
        @if (component.parameters.length === 0) {
            <p class="none">No parameters.</p>
        } else {
            <div class="table-scroll">
                <table class="parameters">
                    <thead>
                        <tr><th scope="col">Parameter</th><th scope="col">Type</th><th scope="col">Default</th><th scope="col">Description</th></tr>
                    </thead>
                    <tbody>
                        @foreach (const parameter of component.parameters) {
                            <tr @key="parameter.name">
                                <td>
                                    <code>@parameter.name</code>
                                    @if (parameter.required) {
                                        <span class="tag tag--required">required</span>
                                    }
                                </td>
                                <td data-label="Type"><code class="type">@parameter.type</code></td>
                                <td data-label="Default" class="@(parameter.default === undefined ? "empty" : null)">
                                    @if (parameter.default !== undefined) {
                                        <code>@parameter.default</code>
                                    }
                                </td>
                                <td class="description">
                                    @(new MarkupString(parameter.doc))
                                    @if (parameter.cascading) {
                                        <p class="note">Cascading: receives <code>@parameter.cascading</code>.</p>
                                    }
                                    @if (parameter.inheritedFrom) {
                                        <p class="note">From <code>@parameter.inheritedFrom</code>.</p>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    } else {
        <h1>Not in the reference</h1>
        <p>There is no component “@name” in “@packageSlug”. The <a href="reference">overview</a> lists the packages.</p>
    }
</ReferenceShell>

@code {
    /** Route parameter: runtime | components | fluent. */
    @Parameter() packageSlug = "";
    /** Route parameter: the component name (`NavLink`). */
    @Parameter() name = "";

    private get pkg(): ReferencePackage | undefined {
        return reference.packages.find((candidate) => candidate.slug === this.packageSlug);
    }

    private get component(): ReferenceComponent | undefined {
        return this.pkg?.components.find((candidate) => candidate.name === this.name);
    }

    /** The base class's page, when the reference has it (same package first). */
    private get baseHref(): string | undefined {
        const base = this.component?.extends;
        if (!base || !this.pkg) return undefined;
        const owner = [this.pkg, ...reference.packages].find((pkg) => pkg.components.some((candidate) => candidate.name === base));
        return owner ? `reference/components/${owner.slug}/${base}` : undefined;
    }
}
