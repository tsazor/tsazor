@inject TutorialState State

<header class="site-bar">
    <a class="brand" href="" aria-current="@(current === "home" ? "page" : null)">
        <span class="logo" aria-hidden="true">T</span>
        <span>Tsazor <span class="brand-sub">tutorial</span></span>
    </a>
    <nav class="site-links" aria-label="Tutorial">
        <a href="" aria-current="@(current === "home" ? "page" : null)">Home</a>
        <a href="@lessonsHref">@lessonsLabel</a>
        <a href="index" aria-current="@(current === "index" ? "page" : null)">Index</a>
        <a href="reference" aria-current="@(current === "reference" ? "page" : null)">Reference</a>
    </nav>
</header>

@code {
    /** The page showing the bar (marked with aria-current). */
    @Parameter() current: "home" | "index" | "reference" = "home";

    /** Back into the lessons: the last one visited in the reader's track, else the track's first. */
    private get lessonsHref(): string {
        const track = this.State.preferredTrack;
        const lesson = this.State.lastLesson(track) ?? this.State.lessons(track)[0];
        return lesson ? `${track}/${lesson.lesson.slug}` : "";
    }

    private get lessonsLabel(): string {
        return this.State.lastLesson(this.State.preferredTrack) ? "Continue lessons" : "Lessons";
    }
}
