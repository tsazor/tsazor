    "gates": "node scripts/gates.mjs",
    "probe": "node scripts/probe-razor-corpus.mjs",
    "tutorial:dev": "pnpm --filter tutorial dev",
    "api:check": "node scripts/api-snapshot.mjs --check",
    "api:update": "node scripts/api-snapshot.mjs"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "@typescript-eslint/parser": "^8.44.0",
    "@vitest/coverage-v8": "^3.2.4",
    "axe-core": "^4.13.0",
    "eslint": "^9.37.0",
    "happy-dom": "^18.0.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
