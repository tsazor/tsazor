{
  "name": "tsazor-monorepo",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "demo:dev": "pnpm --filter demo dev",
    "demo:build": "pnpm --filter demo build",
    "smoke": "node scripts/tarball-smoke.mjs",
