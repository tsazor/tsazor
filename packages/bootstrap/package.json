{
  "name": "@tsazor/bootstrap",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "Bootstrap 5 UI component library for Tsazor — written in .tsazor (dogfooding the compiler and runtime).",
  "keywords": [
    "tsazor",
    "tsazor-components",
    "components",
    "ui"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tsazor-components.json": "./dist/tsazor-components.json"
  },
  "sideEffects": false,
  "tsazor": {
    "components": "./dist/tsazor-components.json",
    "setup": {
      "styles": [
        "bootstrap/dist/css/bootstrap.min.css"
      ],
      "services": "addBootstrap",
      "layout": [
        "ToastRegion"
      ]
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@tsazor/ui": "workspace:*"
  },
  "peerDependencies": {
    "@tsazor/runtime": "workspace:*",
    "bootstrap": "^5.3.0"
  },
  "devDependencies": {
    "@tsazor/compiler": "workspace:*",
    "@tsazor/runtime": "workspace:*",
    "@tsazor/testing": "workspace:*",
    "@tsazor/workspace": "workspace:*",
    "esbuild": "^0.28.2",
    "happy-dom": "^18.0.1",
    "vitest": "^3.2.7"
  }
}
