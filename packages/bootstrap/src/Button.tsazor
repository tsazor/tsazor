@** Renders a native `<button>` styled with Bootstrap's `.btn` classes: an intent (its color role),
    an appearance (solid, outline, subtle or transparent) and a size. It raises onClick on click,
    Enter or Space. With `href` it is a link that looks like a button (Bootstrap's `<a class="btn">`).
    `iconStart`/`iconEnd` put an icon before or after the label; without a label, give it an ariaLabel. *@
@import type { Appearance, IconValue, Intent, Size } from "@tsazor/ui"
@import { buttonClasses } from "./vocabulary"
@import { withClass } from "./attributes"
@if (href !== undefined) {
    <a href="@(disabled ? null : href)" aria-disabled="@(disabled ? "true" : null)" aria-label="@ariaLabel" @attributes="@withClass(disabled ? `${buttonClass} disabled` : buttonClass, additionalAttributes)" @onclick="handleClick">@if (iconStart) {<Icon value="@iconStart" class="@this.startIconClass" />}@childContent@if (iconEnd) {<Icon value="@iconEnd" class="@this.endIconClass" />}</a>
} else {
    <button type="@type" disabled="@disabled" aria-label="@ariaLabel" @attributes="@withClass(buttonClass, additionalAttributes)" @onclick="handleClick">@if (iconStart) {<Icon value="@iconStart" class="@this.startIconClass" />}@childContent@if (iconEnd) {<Icon value="@iconEnd" class="@this.endIconClass" />}</button>
}

@code {
    /** The accessible name when there is no visible label. */
    @Parameter() ariaLabel?: string;
    /** The color role: primary, secondary, success, danger, warning, info or neutral. */
    @Parameter() intent: Intent = "primary";
    /** Visual weight: solid (default), outline, subtle or transparent (a link-styled button). */
    @Parameter() appearance: Appearance = "solid";
    /** small, medium (default) or large. */
    @Parameter() size: Size = "medium";
    /** Disables the native button; it then raises no clicks. */
    @Parameter() disabled: boolean = false;
    /** The button's `type` attribute. */
    @Parameter() type: "button" | "submit" | "reset" = "button";
    /** Renders a link styled as the button (`<a href class="btn">`); a disabled one has no href. */
    @Parameter() href?: string;
    /** Fired when the button is clicked, with the click event. */
    @Parameter() onClick?: EventCallback<MouseEvent>;
    /** The button's label. */
    @Parameter() childContent?: RenderFragment;
    /** An icon before the label (Fluent UI Blazor's `IconStart`). */
    @Parameter() iconStart?: IconValue;
    /** An icon after the label (`IconEnd`). */
    @Parameter() iconEnd?: IconValue;
    /** Further attributes for the `<button>` (`aria-label`, `title`, …). */
    @Parameter({ captureUnmatchedValues: true }) additionalAttributes?: Record<string, unknown>;

    private get buttonClass(): string {
        return buttonClasses(this.intent, this.appearance, this.size);
    }

    /** A label gets the icon's spacing; an icon-only button needs none. */
    private get startIconClass(): string | null {
        return this.childContent === undefined ? null : "me-2";
    }

    private get endIconClass(): string | null {
        return this.childContent === undefined ? null : "ms-2";
    }

    private handleClick(e: MouseEvent): Promise<void> | undefined {
        // A native button ignores clicks while disabled; a link doesn't.
        if (this.disabled) return undefined;
        return this.onClick?.invokeAsync(e);
    }
}
