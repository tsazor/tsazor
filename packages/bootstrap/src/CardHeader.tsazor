@** Renders Bootstrap's `.card-header`, the top bar of a Card. Place it inside a Card, before the
    CardBody. *@
@import { withClass } from "./attributes"
<div @attributes="@withClass("card-header", additionalAttributes)">@childContent</div>

@code {
    /** The header content. */
    @Parameter() childContent?: RenderFragment;
    /** `@attributes` pass-through (class appends). */
    @Parameter({ captureUnmatchedValues: true }) additionalAttributes?: Record<string, unknown>;
}