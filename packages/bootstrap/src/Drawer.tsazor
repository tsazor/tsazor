@** A panel that slides in from an edge of the page (Bootstrap's `.offcanvas`) while `isOpen` is true —
    a navigation menu, filters, details. It is a modal dialog: focus moves into it and stays there,
    the page behind doesn't scroll, and focus returns when it closes. It does not close itself:
    Escape, a click on the backdrop or the close button raise onClosed, and the parent sets `isOpen`
    to false. *@
@import { createLayer, dismissible, focusTrap, scrollLock, uniqueId, type DismissReason } from "@tsazor/ui"
@import { topLayer } from "@tsazor/ui"
@import { withClass } from "./attributes"
@import { libraryTexts } from "@tsazor/ui"

@if (isOpen) {
    <div class="offcanvas-backdrop fade show" @attach="topLayer"></div>
    <div tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="@labelledBy" aria-label="@ariaLabel" @attributes="@withClass(panelClass, additionalAttributes)" @attach:top="topLayer" @attach="trap" @attach:lock="lock" @attach:dismiss="dismiss">
        <div class="offcanvas-header">
            @if (title) {
                <h5 class="offcanvas-title" id="@titleId">@title</h5>
            }
            <button type="button" class="btn-close" aria-label="@t("close")" @onclick="requestClose"></button>
        </div>
        <div class="offcanvas-body">@childContent</div>
    </div>
}

@code {
    private readonly t = libraryTexts();

    /** Whether the panel is open; the parent flips this in response to onClosed. */
    @Parameter() isOpen: boolean = false;
    /** The edge it slides in from. */
    @Parameter() placement: "start" | "end" | "top" | "bottom" = "start";
    /** Heading; it also names the panel for screen readers. */
    @Parameter() title?: string;
    /** The panel's accessible name when it has no title. */
    @Parameter() ariaLabel?: string;
    /** Closes when the backdrop is clicked. */
    @Parameter() closeOnBackdrop: boolean = true;
    /** Closes when the user presses Escape. */
    @Parameter() closeOnEscape: boolean = true;
    /** Fired when the user asks to close (Escape, the backdrop or the close button). It carries no event: Escape and the backdrop have none to give. */
    @Parameter() onClosed?: EventCallback;
    /** The panel's content. */
    @Parameter() childContent?: RenderFragment;
    /** Further attributes for the panel element. */
    @Parameter({ captureUnmatchedValues: true }) additionalAttributes?: Record<string, unknown>;

    private readonly titleId = uniqueId("tz-drawer-title");
    /** The trap and the dismiss handling are one overlay layer. */
    private readonly layer = createLayer();
    private readonly trap = focusTrap({ layer: this.layer });
    private readonly lock = scrollLock;
    private readonly dismiss = dismissible({ layer: this.layer, onDismiss: (reason) => this.dismissed(reason) });

    private get panelClass(): string {
        return `offcanvas offcanvas-${this.placement} show`;
    }

    private get labelledBy(): string | null {
        return this.title ? this.titleId : null;
    }

    private dismissed(reason: DismissReason): void {
        // The behavior's callback is outside the renderer: its errors go to the ErrorBoundary by hand.
        if (reason === "escape" ? this.closeOnEscape : this.closeOnBackdrop) this.requestClose()?.catch((error) => this.dispatchExceptionAsync(error));
    }

    private requestClose(): Promise<void> | undefined {
        return this.onClosed?.invokeAsync();
    }
}
