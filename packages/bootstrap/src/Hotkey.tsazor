@** A keyboard shortcut for the whole page (MudBlazor's MudHotkey): `keys` — "Ctrl+K", "Mod+S" (Cmd on Apple devices,
    Ctrl elsewhere), "Shift+?", "Escape" — raises onHotkeyPressed with the keydown. A plain key ("?", "g") doesn't act
    while someone types into a field (`inTextFields` lets it). The content shows after the first press; with
    `hideChildContentOnRepress` the next press hides it again. The key's default action and propagation stop
    (`preventEventPropagation`). Tell screen-reader users where the shortcut leads: `aria-keyshortcuts` on that control
    (`ariaKeyShortcuts(parseHotkey(keys))` in @tsazor/ui writes it). *@
@import { hotkeyApplies, matchesHotkey, parseHotkey } from "@tsazor/ui"

@if (this.contentShown) {
    @childContent
}

@code {
    /** The combination ("Ctrl+K", "Mod+S", "?"; MudBlazor's `Key` with its `KeyModifiers`). */
    @Parameter() keys: string = "";
    /** Raised with the keydown when the combination is pressed. */
    @Parameter() onHotkeyPressed?: EventCallback<KeyboardEvent>;
    /** Shown once the combination was pressed. */
    @Parameter() childContent?: RenderFragment;
    /** A second press hides the content again. */
    @Parameter() hideChildContentOnRepress: boolean = false;
    /** Stops the key's default action and its propagation (default). */
    @Parameter() preventEventPropagation: boolean = true;
    /** A plain key acts while someone types into a field too. */
    @Parameter() inTextFields: boolean = false;
    /** Ignores the combination. */
    @Parameter() disabled: boolean = false;

    private contentShown = false;
    private readonly listener = (e: KeyboardEvent): void => this.keydown(e);

    protected override onInitialized(): void {
        document.addEventListener("keydown", this.listener);
    }

    dispose(): void {
        document.removeEventListener("keydown", this.listener);
    }

    private keydown(e: KeyboardEvent): void {
        if (this.disabled || e.repeat) return;
        const hotkey = parseHotkey(this.keys);
        if (hotkey === undefined || !matchesHotkey(e, hotkey) || !hotkeyApplies(e.target, hotkey, this.inTextFields)) return;
        if (this.preventEventPropagation) {
            e.preventDefault();
            e.stopPropagation();
        }
        this.contentShown = this.hideChildContentOnRepress ? !this.contentShown : true;
        this.stateHasChanged();
        // The listener is outside the renderer: its errors go to the ErrorBoundary by hand.
        this.onHotkeyPressed?.invokeAsync(e).catch((error) => this.dispatchExceptionAsync(error));
    }
}
