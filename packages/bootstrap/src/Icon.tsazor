@** An inline SVG icon (`.bi`, as Bootstrap Icons draws them), in currentColor: a `value` (an `IconValue`: a generated
    set's, or an app's own made with `icon()` from @tsazor/ui) — the same parameters as the Fluent skin's Icon.
    Decorative (aria-hidden) by default; with a title (or ariaLabel) it gets role="img". Without a value it renders
    nothing. *@
@import { MarkupString } from "@tsazor/runtime"
@import { type IconValue } from "@tsazor/ui"
@import { iconSize } from "@tsazor/ui/kit"
@import { withClass } from "./attributes"

@if (this.value !== undefined) {
    <svg @attributes="@this.iconAttributes(this.value)">@(new MarkupString(this.value.content))</svg>
}

@code {
    /** The icon: a generated set's value, or an app's own from `icon()`. */
    @Parameter() value?: IconValue;
    /** Pixel size (width/height). By default the icon's own size (16 for Bootstrap Icons). */
    @Parameter() size?: number;
    /** The icon's color (any CSS color); by default the text color around it. */
    @Parameter() color?: string;
    /** The accessible name; without it (or ariaLabel) the icon is decorative. */
    @Parameter() title?: string;
    /** Accessible label — hides the icon from AT unless a label is given. */
    @Parameter() ariaLabel?: string;
    /** Further attributes for the svg element (class appends). */
    @Parameter({ captureUnmatchedValues: true }) additionalAttributes?: Record<string, unknown>;

    private get pixels(): number {
        return this.size ?? (this.value === undefined ? 16 : iconSize(this.value));
    }

    private iconAttributes(icon: IconValue): Record<string, unknown> {
        const label = this.ariaLabel ?? this.title;
        return withClass("bi", {
            width: this.pixels,
            height: this.pixels,
            viewBox: icon.viewBox,
            fill: "currentColor",
            // On the text's baseline, as bootstrap-icons.css sets `.bi`.
            style: this.color === undefined ? "vertical-align: -0.125em" : `vertical-align: -0.125em; color: ${this.color}`,
            "aria-hidden": label === undefined ? "true" : "false",
            "aria-label": label,
            role: label === undefined ? null : "img",
            focusable: "false",
            ...this.additionalAttributes,
        });
    }
}
