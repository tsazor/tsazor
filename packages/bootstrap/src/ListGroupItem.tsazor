@** One entry of a ListGroup (Bootstrap's `.list-group-item`): plain content, a link when `href` is
    set, or a button that raises onClick when a handler is given. Place it inside a ListGroup. *@
@* Always an <li> (valid in the <ul> of ListGroup — WCAG 1.3.1). A link or a
   clickable item holds a real <a>/<button> (keyboard reachable — WCAG 2.1.1);
   `stretched-link` makes the whole row its target, `text-reset` keeps the
   item's color (an active item's text stays white). *@
@if (href) {
    <li class="@itemClass list-group-item-action">
        <a class="stretched-link text-reset text-decoration-none" href="@href" aria-current="@ariaCurrent">@childContent</a>
    </li>
} else if (onClick) {
    <li class="@itemClass list-group-item-action">
        <button type="button" class="stretched-link bg-transparent border-0 p-0 text-reset text-start" disabled="@disabled" @onclick="handleClick">@childContent</button>
    </li>
} else {
    <li class="@itemClass">@childContent</li>
}

@code {
    /** Marks the item active. */
    @Parameter() active: boolean = false;
    /** Renders the disabled look; on a button item it also disables the button and suppresses onClick. */
    @Parameter() disabled: boolean = false;
    /** Makes the item a link (an anchor inside the list item). */
    @Parameter() href?: string;
    /** Makes the item a button (inside the list item) and fires on click, Enter or Space. */
    @Parameter() onClick?: EventCallback<MouseEvent>;
    /** The item's content. */
    @Parameter() childContent?: RenderFragment;

    private get itemClass(): string {
        const parts = ["list-group-item"];
        if (this.active) parts.push("active");
        if (this.disabled) parts.push("disabled");
        return parts.join(" ");
    }

    private get ariaCurrent(): string | null {
        return this.active ? "true" : null;
    }

    private handleClick(e: MouseEvent): Promise<void> | undefined {
        return this.disabled ? undefined : this.onClick?.invokeAsync(e);
    }
}
