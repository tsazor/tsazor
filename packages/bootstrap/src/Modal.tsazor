@** Renders Bootstrap's `.modal` dialog with a backdrop while `isOpen` is true, with an optional
    header (title and close button) and footer. It does not close itself: the close button or a
    backdrop click raises onClosed, and the parent sets `isOpen` to false. *@
@if (isOpen) {
    <div class="modal-backdrop show"></div>
    <div class="modal d-block" tabindex="-1" @onclick="backdropClick">
        <div class="@dialogClass" role="document">
            <div class="modal-content">
                @if (title) {
                    <div class="modal-header">
                        <h5 class="modal-title">@title</h5>
                        <button type="button" class="btn-close" aria-label="Close" @onclick="close"></button>
                    </div>
                }
                <div class="modal-body">@childContent</div>
                @if (footer) {
                    <div class="modal-footer">@footer</div>
                }
            </div>
        </div>
    </div>
}

@code {
    /** Whether the modal is visible; the parent flips this in response to OnClosed. */
    @Parameter() isOpen: boolean = false;
    /** Optional heading; omitting it hides the header row. */
    @Parameter() title?: string;
    /** Modal size: "" | sm | lg | xl. */
    @Parameter() size: string = "";
    /** Vertically centers the dialog. */
    @Parameter() centered: boolean = true;
    /** Closes when the backdrop itself is clicked (not the dialog). */
    @Parameter() closeOnBackdrop: boolean = true;
    /** Optional footer content (e.g. action buttons). */
    @Parameter() footer?: RenderFragment;
    /** Fired when the user requests a close (X button or backdrop). */
    @Parameter() onClosed?: EventCallback<MouseEvent>;
    /** The modal's body. */
    @Parameter() childContent?: RenderFragment;

    private get dialogClass(): string {
        const parts = ["modal-dialog"];
        if (this.size) parts.push(`modal-${this.size}`);
        if (this.centered) parts.push("modal-dialog-centered");
        return parts.join(" ");
    }

    private backdropClick(e: MouseEvent): void {
        if (this.closeOnBackdrop && e.target === e.currentTarget) this.requestClose();
    }

    private close(e: MouseEvent): void {
        this.requestClose();
    }

    private requestClose(): void {
        this.onClosed?.invokeAsync();
    }
}