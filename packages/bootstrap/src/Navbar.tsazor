@** Renders Bootstrap's `.navbar` with an optional brand text and a `.navbar-nav` area for the
    navigation links. It does not collapse into a toggler on small screens. *@
<nav class="@navClass">
    <div class="container-fluid">
        @if (brand) {
            <span class="navbar-brand">@brand</span>
        }
        <div class="navbar-nav">@childContent</div>
    </div>
</nav>

@code {
    /** Brand text at the left edge; omit to hide. */
    @Parameter() brand?: string;
    /** Background color: light | dark | primary | … */
    @Parameter() variant: string = "light";
    /** The navigation links, placed inside `.navbar-nav`. */
    @Parameter() childContent?: RenderFragment;

    private get navClass(): string {
        const theme = this.variant === "dark" ? "navbar-dark" : "navbar-light";
        return `navbar navbar-expand-lg ${theme} bg-${this.variant}`;
    }
}