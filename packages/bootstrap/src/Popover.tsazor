@** A Bootstrap popover: a button that opens a small non-modal dialog next to it (`.popover`, `role="dialog"`
    labelled by its title) for details, a short form or help. Focus moves into the popover when it
    opens; Escape, the close button or a click outside closes it, and Escape returns focus to the
    button. It is positioned next to the button and flips when there is no room. *@
@import { anchoredPosition, dismissable, uniqueId, type Appearance, type DismissReason, type Intent, type Size } from "@tsazor/ui"
@import { topLayer } from "@tsazor/ui"
@import { buttonClasses } from "./vocabulary"
@import { libraryTexts } from "@tsazor/ui"

<span class="d-inline-block">
    <button class="@toggleClass" type="button" aria-expanded="@expandedText" aria-controls="@panelControls" @ref="toggleButton" @onclick="toggle">@label</button>
    @if (open) {
        <div class="popover bs-popover-auto show" role="dialog" id="@panelId" aria-labelledby="@titleId" aria-label="@panelLabel" tabindex="-1" @attach:top="topLayer" @attach="dismiss" @attach:position="position" @attach:focus="focusPanel">
            @if (title) {
                <div class="popover-header d-flex align-items-center">
                    <span class="flex-grow-1" id="@titleId">@title</span>
                    <button type="button" class="btn-close ms-2" aria-label="@t("close")" @onclick="() => close(true)"></button>
                </div>
            }
            <div class="popover-body">@childContent</div>
        </div>
    }
</span>

@code {
    private readonly t = libraryTexts();

    /** The button's label. */
    @Parameter() label: string = "";
    /** The popover's heading; it also names the dialog. */
    @Parameter() title?: string;
    /** The dialog's accessible name when it has no title. */
    @Parameter() ariaLabel?: string;
    /** The button's color role. */
    @Parameter() intent: Intent = "secondary";
    /** The button's visual weight. */
    @Parameter() appearance: Appearance = "outline";
    /** The button's size. */
    @Parameter() size: Size = "medium";
    /** Where the popover opens relative to the button. */
    @Parameter() placement: "bottom-start" | "bottom-end" | "top-start" | "top-end" = "bottom-start";
    /** The popover's content. */
    @Parameter() childContent?: RenderFragment;

    private open = false;
    private toggleButton?: HTMLButtonElement;
    private readonly panelId = uniqueId("tz-popover");
    private readonly titleId = `${this.panelId}-title`;

    private readonly dismiss = dismissable({ onDismiss: (reason) => this.dismissed(reason), ignore: () => [this.toggleButton] });
    private readonly position = anchoredPosition({ anchor: () => this.toggleButton, placement: () => this.placement });
    private readonly focusPanel = (panel: HTMLElement): void => {
        panel.focus({ preventScroll: true });
    };

    private get toggleClass(): string {
        return buttonClasses(this.intent, this.appearance, this.size);
    }

    private get expandedText(): string {
        return this.open ? "true" : "false";
    }

    private get panelControls(): string | null {
        return this.open ? this.panelId : null;
    }

    private get panelLabel(): string | null {
        return this.title ? null : (this.ariaLabel ?? this.label);
    }

    private toggle(): void {
        if (this.open) this.close(true);
        else this.open = true;
    }

    private dismissed(reason: DismissReason): void {
        this.close(reason === "escape");
    }

    /** Closes the popover; `returnFocus` puts focus back on the button. */
    close(returnFocus = true): void {
        if (!this.open) return;
        this.open = false;
        if (returnFocus) this.toggleButton?.focus({ preventScroll: true });
        this.stateHasChangedInternal();
    }
}
