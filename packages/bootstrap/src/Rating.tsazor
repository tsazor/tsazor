@** A rating (MudBlazor's MudRating; Bootstrap has none; InputBase — bind it with @bind-value): a row of `max` stars
    someone picks a value from, 0 for none. The stars are radio buttons in a named group, so a screen reader says
    "3 stars, 3 of 5"; the arrows (and Shift to the ends, Home, End) move the value without wrapping around, and a click
    on the star of the value — or Space on it — clears it, as MudBlazor's does. The pointer previews a value
    (`hoveredValueChanged`). `fullIcon` and `emptyIcon` draw the stars, `size` and `color` (neutral, brand: primary,
    marigold: warning) style them. `readOnly` shows the value only (or take a RatingDisplay) — the same parameters as
    the Fluent skin's Rating. *@
@import type { IconValue } from "@tsazor/ui"
@import { uniqueId, type RatingLabels } from "@tsazor/ui"
@import { ratingClickValue, ratingKeyTarget } from "@tsazor/ui/kit"
@import { withClass } from "./attributes"
@import { Star, StarFill } from "./core-icons"
@import { libraryTexts } from "@tsazor/ui"
@import { ratingLabelsFrom } from "@tsazor/ui/kit"

@inherits InputBase<number>

<div role="radiogroup" aria-label="@(this.ariaLabel ?? t("rating.label"))" aria-readonly="@(this.readOnly ? "true" : null)" aria-disabled="@(this.disabled ? "true" : null)" @attributes="@withClass(this.groupClass, this.additionalAttributes)" @ref="group" @onpointerleave="this.leave">
    @for (let i = 1; i <= this.max; i++) {
        <label class="@this.itemClass(i)" @onpointerenter="() => this.hover(i)">
            <input type="radio" class="tz-rating__input" name="@this.name" value="@i" checked="@(this.currentValue === i)" aria-label="@this.itemLabel(i)"
                   disabled="@this.disabled" @onclick="(e) => this.clicked(e, i)" @onkeydown="this.keydown" />
            <Icon value="@(this.shown(i) ? this.fullIcon : this.emptyIcon)" />
        </label>
    }
</div>

@code {
    private readonly t = libraryTexts();

    /** The number of stars (MudBlazor's `MaxValue`). */
    @Parameter() max: number = 5;
    /** The icon of a star up to the value (MudBlazor's `FullIcon`). */
    @Parameter() fullIcon: IconValue = StarFill;
    /** The icon of a star past it (MudBlazor's `EmptyIcon`). */
    @Parameter() emptyIcon: IconValue = Star;
    /** small | medium (default) | large. */
    @Parameter() size: "small" | "medium" | "large" = "medium";
    /** The stars' color: neutral (default, the body's), brand (primary) or marigold (warning). */
    @Parameter() color: "neutral" | "brand" | "marigold" = "neutral";
    /** Disables the stars. */
    @Parameter() disabled: boolean = false;
    /** Shows the value without letting it change. */
    @Parameter() readOnly: boolean = false;
    /** The group's name for screen readers. */
    @Parameter() ariaLabel?: string;
    /** The stars' names ("3 stars"; English by default). */
    @Parameter() labels?: Partial<RatingLabels>;
    /** Raised with the star the pointer is over, and undefined when it leaves (MudBlazor's `HoveredValueChanged`). */
    @Parameter() hoveredValueChanged?: EventCallback<number | undefined>;

    private readonly name = uniqueId("tz-rating");
    private hovered?: number;
    private focusPending = false;
    private group?: HTMLDivElement;

    private get value(): number {
        return this.currentValue ?? 0;
    }

    private itemLabel(item: number): string {
        return (this.labels?.item ?? ratingLabelsFrom(this.t).item)(item, this.max);
    }

    /** A star drawn full: up to the previewed value while the pointer is over the stars, else up to the value. */
    private shown(item: number): boolean {
        return item <= (this.hovered ?? this.value);
    }

    private itemClass(item: number): string {
        let cls = "tz-rating__item";
        if (this.shown(item)) cls += " tz-rating__item--full";
        if (this.hovered !== undefined) cls += " tz-rating__item--preview";
        return cls;
    }

    private get groupClass(): string {
        let cls = `tz-rating tz-rating--${this.color}`;
        if (this.size !== "medium") cls += ` tz-rating--${this.size}`;
        if (this.disabled) cls += " tz-rating--disabled";
        return cls;
    }

    protected override onAfterRender(): void {
        if (!this.focusPending || this.group === undefined) return;
        this.focusPending = false;
        // The radio of the value; with none, the first (the group's tab stop then).
        const radios = this.group.querySelectorAll<HTMLInputElement>("input");
        radios[Math.max(0, this.value - 1)]?.focus();
    }

    private clicked(e: MouseEvent, item: number): void {
        if (this.readOnly) {
            // Puts the check back where the value is.
            e.preventDefault();
            return;
        }
        this.currentValue = ratingClickValue(item, this.value);
    }

    private keydown(e: KeyboardEvent): void {
        if (!e.key.startsWith("Arrow") && e.key !== "Home" && e.key !== "End") return;
        // The radios' own keys would wrap from the last star to the first.
        e.preventDefault();
        if (this.readOnly || this.disabled) return;
        const rtl = getComputedStyle(e.target as Element).direction === "rtl";
        const next = ratingKeyTarget(e, this.value, this.max, rtl);
        if (next === undefined) return;
        this.currentValue = next;
        this.focusPending = true;
    }

    private hover(item: number): Promise<void> | undefined {
        if (this.readOnly || this.disabled || this.hovered === item) return undefined;
        this.hovered = item;
        return this.hoveredValueChanged?.invokeAsync(item);
    }

    private leave(): Promise<void> | undefined {
        if (this.hovered === undefined) return undefined;
        this.hovered = undefined;
        return this.hoveredValueChanged?.invokeAsync(undefined);
    }
}
