@** A scheduler over days, on the calendar doctrine (ISO dates without a zone): month, week and
    day views, all-day appointments in a row of their own, timed appointments side by side in
    lanes where they overlap. The model lives in @tsazor/ui (ScheduleModel); your appointments
    extend ScheduleAppointment. Clicking an appointment selects it and reports it; a month cell
    with more appointments than it shows opens its day (the `more` button). *@
@typeparam TAppointment extends ScheduleAppointment
@import { EventCallback } from "@tsazor/runtime"
@import {
ScheduleModel, libraryTexts, isoDayTime, parseIsoDateTime, startScheduleTimeDrag,
formatIsoDate, pageLocale, weekdayNames,
type IsoDate, type IsoDateTime, type ScheduleAppointment, type ScheduleBlock, type ScheduleDay, type ScheduleView, type WeekStartsOn,
} from "@tsazor/ui"
@import { ChevronLeft, ChevronRight } from "./core-icons"

<section class="tz-schedule" aria-label="@(ariaLabel ?? t("schedule.label"))" @attributes="otherAttributes">
    <div class="tz-schedule-toolbar">
        <Button Size="small" Appearance="outline" OnClick="@(() => this.model.navigate("previous"))" AriaLabel="@t("schedule.previous")"><Icon value="@ChevronLeft" size="14" class="tz-schedule-step" /></Button>
        <Button Size="small" Appearance="outline" OnClick="@(() => this.model.navigate("today"))">@t("schedule.today")</Button>
        <Button Size="small" Appearance="outline" OnClick="@(() => this.model.navigate("next"))" AriaLabel="@t("schedule.next")"><Icon value="@ChevronRight" size="14" class="tz-schedule-step" /></Button>
        <span class="tz-schedule-period">@this.period</span>
        <div class="tz-schedule-views" role="group" aria-label="@t("schedule.label")">
            @foreach (const candidate of ["month", "week", "day"] as const) {
                <Button Size="small" Appearance="@(this.currentView === candidate ? "solid" : "outline")" OnClick="@(() => this.model.setView(candidate, this.model.anchor))">@t(`schedule.${candidate}`)</Button>
            }
        </div>
    </div>
    <div class="tz-schedule-head" aria-hidden="true">
        @foreach (const name of this.headNames) {
            <span class="tz-schedule-head-day">@name</span>
        }
    </div>
    @if (this.currentView === "month") {
        <div class="tz-schedule-month">
            @foreach (const day of this.model.days) {
                <div class="@this.dayClass(day)" @onclick="@(() => this.model.setView("day", day.date))">
                    <div class="tz-schedule-day-number">@this.dayLabel(day.date)</div>
                    @foreach (const appointment of this.monthChipsOf(day)) {
                        <button type="button" class="@this.appointmentClass(appointment)" aria-pressed="@this.selectedText(appointment)" @onclick="@((event: MouseEvent) => this.selectChip(appointment, event))">@appointment.title</button>
                    }
                    @if (day.allDay.length + day.timed.length > this.monthChips) {
                        <button type="button" class="tz-schedule-more p-0 border-0 bg-transparent" @onclick="@(() => this.model.setView("day", day.date))">@t("schedule.more", { count: day.allDay.length + day.timed.length - this.monthChips })</button>
                    }
                </div>
            }
        </div>
    } else {
        <div class="tz-schedule-all-day">
            <span class="tz-schedule-all-day-label">@t("schedule.allDay")</span>
            <div class="tz-schedule-all-day-days">
                @foreach (const day of this.model.days) {
                    <div class="@this.dayClass(day)">
                        @foreach (const appointment of day.allDay) {
                            <button type="button" class="@this.appointmentClass(appointment)" aria-pressed="@this.selectedText(appointment)" @onclick="@(() => this.select(appointment))">@appointment.title</button>
                        }
                    </div>
                }
            </div>
        </div>
        <div class="tz-schedule-timegrid" @ref="timegrid">
            <div class="tz-schedule-hours" aria-hidden="true">
                @foreach (const hour of this.hourLabels) {
                    <span class="tz-schedule-hour">@hour</span>
                }
            </div>
            <div class="tz-schedule-columns">
                @foreach (const day of this.model.days) {
                    <div class="@this.dayClass(day) tz-schedule-day-col" data-tz-schedule-column="@day.date" @onpointerdown="@((event: PointerEvent) => this.startCreate(day.date, event))">
                        @foreach (const block of day.timed) {
                            <div class="tz-schedule-block" style="@this.blockStyle(block)">
                                <button type="button" class="@this.appointmentClass(block.appointment)" aria-pressed="@this.selectedText(block.appointment)" aria-label="@this.appointmentLabel(block.appointment)" @onpointerdown="@((event: PointerEvent) => this.startMove(block.appointment, event))" @onkeydown="@((event: KeyboardEvent) => this.moveByKey(block.appointment, event))" @onclick="@(() => this.select(block.appointment))">@block.appointment.title</button>
                                <div class="tz-schedule-resize" role="separator" aria-label="@t("schedule.resize")" @onpointerdown="@((event: PointerEvent) => this.startResizeEnd(block.appointment, event))"></div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }
</section>

@code {
    /** The class month view's blocks carry; the union needs the appointment's own shape. */
    private readonly t = libraryTexts();

    /** The app's appointments (they extend ScheduleAppointment). */
    @Parameter() appointments?: readonly TAppointment[];
    /** The view the scheduler starts with (month is the default); the model navigates it from there on. */
    @Parameter() view?: ScheduleView;
    /** The day the window starts on (default: today), a day inside it; the navigation moves the anchor itself. */
    @Parameter() anchor?: IsoDate;
    /** Where a week starts, as the weekday index counts: Sunday 0, Monday 1 (the default). */
    @Parameter() weekStartsOn?: WeekStartsOn;
    /** A month cell shows up to this many appointment chips before the `more` button (default 3). */
    @Parameter() monthChips: number = 3;
    /** Names the section for screen readers. */
    @Parameter() ariaLabel?: string;
    /** Fired with the appointment the user selected (the details are yours: a Dialog, a Drawer). */
    @Parameter() onAppointmentSelected?: EventCallback<TAppointment>;
    /** Fired with a drag's new range (a pointer down on a day's empty column); the app adds the appointment. */
    @Parameter() onAppointmentCreated?: EventCallback<{ date: IsoDate; start: IsoDateTime; end: IsoDateTime }>;
    /** Fired with a moved or resized appointment's new span (same day in v1); the app owns the change. */
    @Parameter() onAppointmentMoved?: EventCallback<{ appointment: TAppointment; start: IsoDateTime; end: IsoDateTime }>;
    /** Further attributes for the section (class adds to its classes). */
    @Parameter({ captureUnmatchedValues: true }) additionalAttributes?: Record<string, unknown>;

    private readonly model = new ScheduleModel(() => this.stateHasChanged());
    private timegrid?: HTMLElement;

    private settingsApplied = false;

    protected override onAfterRender(firstRender: boolean): void {
        if (firstRender && this.timegrid !== undefined) {
            // The working hours are where the day starts; the scroll is 8/24 of the grid, scale-free.
            this.timegrid.scrollTop = this.timegrid.scrollHeight / 3;
        }
    }

    protected override onParametersSet(): void {
        if (this.weekStartsOn !== undefined) this.model.weekStartsOn = this.weekStartsOn;
        const changed = this.model.setAppointments(this.appointments);
        // The view and anchor parameters are the start's settings: the model navigates from there on.
        if (!this.settingsApplied) {
            if (this.view !== undefined) this.model.setView(this.view, this.anchor);
            this.settingsApplied = true;
        }
        if (changed) this.stateHasChanged();
    }

    /** The model's current view (the switcher and the views follow it, not the parameter). */
    private get currentView(): ScheduleView {
        return this.model.currentView;
    }

    /** The view's period, from the anchor: the month, the week's from–to or the day. */
    private get period(): string {
        const locale = pageLocale();
        const anchor = this.model.anchor;
        const at = (date: string, options: Intl.DateTimeFormatOptions): string => new Intl.DateTimeFormat(locale, { ...options, timeZone: "UTC" }).format(new Date(`${date}T00:00:00Z`));
        if (this.currentView === "month") return at(anchor, { month: "long", year: "numeric" });
        if (this.currentView === "week") {
            const days = this.model.days;
            const first = days[0]!.date;
            const last = days[days.length - 1]!.date;
            return `${at(first, { day: "numeric", month: "short" })} – ${at(last, { day: "numeric", month: "short", year: "numeric" })}`;
        }
        return at(anchor, { weekday: "long", day: "numeric", month: "long", year: "numeric" });
    }

    /** The weekday names of the view's columns; week and day name the actual days. */
    private get headNames(): readonly string[] {
        const locale = pageLocale();
        const names = weekdayNames(locale, this.model.weekStartsOn, "short");
        if (this.currentView === "month") return names;
        return this.model.days.map((day) => `${names[day.weekday]!} ${formatIsoDate(day.date, locale, { day: "numeric", month: "short" })}`);
    }

    /** The day's own number for a cell. */
    private dayLabel(date: IsoDate): string {
        return formatIsoDate(date, pageLocale(), { day: "numeric" });
    }

    /** The hours' labels, 00:00 to 23:00 of the locale's clock. */
    private readonly hourLabels: readonly string[] = Array.from({ length: 24 }, (_, hour) => {
        const at = new Date(0);
        at.setUTCHours(hour);
        return new Intl.DateTimeFormat("en-GB", { hour: "2-digit", minute: "2-digit", timeZone: "UTC" }).format(at);
    });

    /** Where a timed block sits in its day's column (top and height as percentages of 24 h; the lane beside its neighbors). */
    private blockStyle(block: ScheduleBlock): string {
        const laneShare = 100 / block.lanes;
        return `top: ${(block.fromMinutes / 1440 * 100).toFixed(3)}%; height: ${((block.toMinutes - block.fromMinutes) / 1440 * 100).toFixed(3)}%; left: ${(block.lane * laneShare).toFixed(3)}%; width: ${laneShare.toFixed(3)}%;`;
    }

    /** A day's chips: the all-day's first, then the timed's, up to the cell's limit. */
    private monthChipsOf(day: ScheduleDay): readonly ScheduleAppointment[] {
        return [...day.allDay, ...day.timed.map((block) => block.appointment)].slice(0, this.monthChips);
    }

    /** A cell's classes: today and a month cell's out-of-month say so. */
    private dayClass(day: ScheduleDay): string | null {
        const parts: string[] = ["tz-schedule-day"];
        if (day.isToday) parts.push("tz-schedule-day--today");
        if (day.isOutOfMonth) parts.push("tz-schedule-day--out");
        return parts.join(" ");
    }

    /** An appointment chip's classes: the intent, the selection, and for timed ones their shape. */
    private appointmentClass(appointment: ScheduleAppointment): string {
        const parts: string[] = ["tz-schedule-appointment", `tz-schedule-appointment--${appointment.intent ?? "primary"}`];
        if (this.model.isSelected(appointment)) parts.push("tz-schedule-appointment--selected");
        return parts.join(" ");
    }

    /** The chip's selected state as text (an attribute keeps booleans out). */
    private selectedText(appointment: ScheduleAppointment): string {
        return this.model.isSelected(appointment) ? "true" : "false";
    }

    /** The chip's label for screen readers: the title and its time. */
    private appointmentLabel(appointment: ScheduleAppointment): string {
        const locale = pageLocale();
        const clock = (text: string): string => new Intl.DateTimeFormat(locale, { hour: "numeric", minute: "2-digit" }).format(new Date(text));
        return this.t("schedule.appointment", { appointment: appointment.title, time: `${clock(appointment.start)}–${clock(appointment.end ?? appointment.start)}` });
    }

    /** Selects an appointment and reports it (the selected one deselects; a day-cell click must not fire). */
    private async selectChip(appointment: ScheduleAppointment, event: MouseEvent): Promise<void> {
        event.stopPropagation();
        await this.select(appointment);
    }

    /** Selects an appointment and reports it (the selected one deselects on a second click). */
    /** Selects an appointment and reports it (the selected one deselects on a second click). */
    private async select(appointment: ScheduleAppointment): Promise<void> {
        this.model.select(appointment);
        // The chip is a member of the app's appointments: the model's base is enough for it.
        await this.onAppointmentSelected?.invokeAsync(appointment as TAppointment);
    }

    /* The appointments' drag (create, move, resize) ---------------------------- */

    /** A running drag's cleanup: the document listeners go when the component does. */
    private scheduleCleanup: (() => void) | undefined;

    /** A pointer down on a day column (on nothing) creates: the drag grows the new range beneath the pointer. */
    private startCreate(date: IsoDate, pointer: PointerEvent): void {
        const column = pointer.currentTarget as HTMLElement;
        pointer.preventDefault();
        this.scheduleCleanup?.();
        this.scheduleCleanup = startScheduleTimeDrag({
            pointer,
            column,
            mode: "create",
            fromMinutes: 0,
            toMinutes: 15,
            onDone: (draft) => void this.created(date, draft),
        });
    }

    /** A pointer down on a chip moves it (the grab point stays under the pointer; a plain click still selects). */
    private startMove(appointment: ScheduleAppointment, pointer: PointerEvent): void {
        const column = (pointer.currentTarget as HTMLElement).closest("[data-tz-schedule-column]") as HTMLElement;
        const date = column.getAttribute("data-tz-schedule-column") as IsoDate;
        const rect = column.getBoundingClientRect();
        const minutesAt = (atY: number): number => ((atY - rect.top) / rect.height) * 1440;
        const parts = this.dayMinutesOf(appointment, date);
        const grabOffset = Math.max(0, minutesAt(pointer.clientY) - parts.from);
        const block = (pointer.currentTarget as HTMLElement).closest(".tz-schedule-block") as HTMLElement;
        this.scheduleCleanup?.();
        this.scheduleCleanup = startScheduleTimeDrag({
            pointer,
            column,
            mode: "move",
            fromMinutes: parts.from,
            toMinutes: parts.to,
            grabOffset,
            preview: block,
            onDone: (draft) => void this.commit(appointment, date, draft),
        });
        pointer.stopPropagation(); // the column's create must not start
    }

    /** The handle at a block's end resizes (its start stays). */
    private startResizeEnd(appointment: ScheduleAppointment, pointer: PointerEvent): void {
        const column = (pointer.currentTarget as HTMLElement).closest("[data-tz-schedule-column]") as HTMLElement;
        const date = column.getAttribute("data-tz-schedule-column") as IsoDate;
        const block = (pointer.currentTarget as HTMLElement).closest(".tz-schedule-block") as HTMLElement;
        const parts = this.dayMinutesOf(appointment, date);
        this.scheduleCleanup?.();
        this.scheduleCleanup = startScheduleTimeDrag({
            pointer,
            column,
            mode: "resize",
            fromMinutes: parts.from,
            toMinutes: parts.to,
            preview: block,
            onDone: (draft) => void this.commit(appointment, date, draft),
        });
        pointer.stopPropagation();
    }

    /** A chip's arrow keys move it: 15 minutes at a time, 60 with Shift; the commit is the event's. */
    private async moveByKey(appointment: ScheduleAppointment, event: KeyboardEvent): Promise<void> {
        if (event.key !== "ArrowUp" && event.key !== "ArrowDown") return;
        event.preventDefault();
        const column = (event.target as HTMLElement).closest("[data-tz-schedule-column]") as HTMLElement | null;
        if (column === null) return;
        const date = column.getAttribute("data-tz-schedule-column") as IsoDate;
        const step = (event.shiftKey ? 60 : 15) * (event.key === "ArrowDown" ? 1 : -1);
        const parts = this.dayMinutesOf(appointment, date);
        const from = Math.max(0, Math.min(1440 - (parts.to - parts.from), parts.from + step));
        await this.commit(appointment, date, { fromMinutes: from, toMinutes: from + (parts.to - parts.from) });
    }

    /** An appointment's span on `date`'s clock (a multi-day one starts at 0 and ends at 1440). */
    private dayMinutesOf(appointment: ScheduleAppointment, date: IsoDate): { from: number; to: number } {
        const start = parseIsoDateTime(appointment.start);
        const end = parseIsoDateTime(appointment.end ?? appointment.start);
        return {
            from: start?.date === date ? (start?.minutes ?? 0) : 0,
            to: end?.date === date ? (end?.minutes ?? 1440) : 1440,
        };
    }

    /** The drag's draft became a new appointment: the app owns the change. */
    private async created(date: IsoDate, draft: { fromMinutes: number; toMinutes: number }): Promise<void> {
        if (draft.fromMinutes === draft.toMinutes) return; // a click: nothing created
        await this.onAppointmentCreated?.invokeAsync({ date, start: isoDayTime(date, draft.fromMinutes), end: isoDayTime(date, draft.toMinutes) });
        this.stateHasChanged();
    }

    /** The move's or resize's draft: the app owns the change; the pointer's no-move is no draft. */
    private async commit(appointment: ScheduleAppointment, date: IsoDate, draft: { fromMinutes: number; toMinutes: number }): Promise<void> {
        const parts = this.dayMinutesOf(appointment, date);
        if (parts.from === draft.fromMinutes && parts.to === draft.toMinutes) {
            this.scheduleCleanup?.();
            this.scheduleCleanup = undefined;
            return; // the pointer stayed: a plain select
        }
        await this.onAppointmentMoved?.invokeAsync({ appointment: appointment as TAppointment, start: isoDayTime(date, draft.fromMinutes), end: isoDayTime(date, draft.toMinutes) });
        this.stateHasChanged();
    }

    private get otherAttributes(): Record<string, unknown> | undefined {
        if (this.additionalAttributes === undefined) return undefined;
        const { class: _class, ...rest } = this.additionalAttributes;
        return rest;
    }
}