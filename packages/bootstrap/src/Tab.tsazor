@** One panel of a Tabs component (Bootstrap's `.tab-pane`, `role="tabpanel"`). Place it inside
    Tabs: its title appears in the parent's nav, and its content is rendered only while it is the
    active tab. *@
@import type { IconValue } from "@tsazor/ui"
@import type Tabs from "./Tabs.tsazor"
@import { withClass } from "./attributes"
@if (isActive) {
    <div role="tabpanel" id="@panelId" aria-labelledby="@tabId" tabindex="0" @attributes="@withClass("tab-pane fade show active", additionalAttributes)">@childContent</div>
}

@code {
    /** Label shown in the parent Tabs' nav. */
    @Parameter() title: string = "";
    /** An icon before the title in the parent's nav (Fluent UI Blazor's `IconStart`). */
    @Parameter() iconStart?: IconValue;
    /** The panel content, shown while the tab is active. */
    @Parameter() childContent?: RenderFragment;
    /** `@attributes` pass-through (class appends). */
    @Parameter({ captureUnmatchedValues: true }) additionalAttributes?: Record<string, unknown>;

    /** Resolved from the nearest Tabs ancestor (by cascade name). */
    @CascadingParameter({ name: "Tabs" }) tabs?: Tabs;

    /** Assigned by the parent Tabs at registration time. */
    private index = -1;

    /** @internal Called once by the parent Tabs at registration. */
    setIndex(index: number): void {
        this.index = index;
    }

    private get isActive(): boolean {
        return this.tabs?.activeIndex === this.index;
    }

    private get panelId(): string | null {
        return this.tabs?.panelId(this.index) ?? null;
    }

    private get tabId(): string | null {
        return this.tabs?.tabId(this.index) ?? null;
    }

    protected override onInitialized(): void {
        this.tabs?.registerTab(this);
    }
}
