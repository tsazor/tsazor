@** Renders Bootstrap's `.nav-tabs`: a `role="tablist"` nav with one button per Tab child, and a
    `.tab-content` area that shows the active Tab. It cascades itself to the Tab children; the first
    tab is active initially. Clicking a tab or moving with the arrow keys (Home and End jump to the
    ends) activates it; only the active tab is in the Tab order (roving tabindex), and each tab is
    linked to its panel through ids. *@
@import type Tab from "./Tab.tsazor"
@import { rovingFocus, uniqueId } from "@tsazor/ui"

<ul class="nav nav-tabs" role="tablist" aria-label="@ariaLabel" @attach="keys">
    @for (let i = 0; i < this.tabs.length; i++) {
        <li class="nav-item" role="presentation">
            <button class="@this.tabClassFor(i)" type="button" role="tab" id="@this.tabId(i)" aria-controls="@this.panelId(i)" aria-selected="@this.selectedText(i)" tabindex="@this.tabIndexOf(i)" @onclick="() => this.select(i)">@this.tabs[i]!.title</button>
        </li>
    }
</ul>
<div class="tab-content">@childContent</div>

@code {
    /** The Tab children. */
    @Parameter() childContent?: RenderFragment;
    /** Names the tab list for screen readers. */
    @Parameter() ariaLabel?: string;
    /** Fired with the index of the newly active tab. */
    @Parameter() onSelected?: EventCallback<number>;

    readonly isCascadingValueSupplier = true;
    /** The active index changes — the Tab children must re-render. */
    readonly isFixed = false;
    /** Tabs cascade themselves by name so Tab finds its parent without an import cycle. */
    readonly cascadeName = "Tabs";
    get cascadeValue(): unknown {
        return this;
    }

    private readonly idBase = uniqueId("tz-tabs");
    private readonly keys = rovingFocus({ items: "[role=tab]", onMove: (index) => void this.select(index)?.catch((error) => this.dispatchExceptionAsync(error)) });
    private tabs: Tab[] = [];
    private activeIndexInternal = 0;

    get activeIndex(): number {
        return this.activeIndexInternal;
    }

    /** @internal The id of tab `index`'s button. */
    tabId(index: number): string {
        return `${this.idBase}-tab-${index}`;
    }

    /** @internal The id of tab `index`'s panel. */
    panelId(index: number): string {
        return `${this.idBase}-panel-${index}`;
    }

    /** @internal Called by Tab during its initialization. */
    registerTab(tab: Tab): void {
        if (this.tabs.includes(tab)) return;
        tab.setIndex(this.tabs.length);
        this.tabs.push(tab);
        // The tab list only exists after the children have registered, so the
        // nav needs one more render pass than the initial one.
        this.stateHasChangedInternal();
    }

    /** @internal Switches the active tab (no-op for out-of-range or same index). */
    select(index: number): Promise<void> | undefined {
        if (index < 0 || index >= this.tabs.length || index === this.activeIndexInternal) return undefined;
        this.activeIndexInternal = index;
        this.stateHasChangedInternal();
        return this.onSelected?.invokeAsync(index);
    }

    private selectedText(index: number): string {
        return this.activeIndexInternal === index ? "true" : "false";
    }

    /** Roving tabindex: only the active tab is in the Tab order. */
    private tabIndexOf(index: number): string {
        return this.activeIndexInternal === index ? "0" : "-1";
    }

    private tabClassFor(index: number): string {
        return this.activeIndexInternal === index ? "nav-link active" : "nav-link";
    }
}
