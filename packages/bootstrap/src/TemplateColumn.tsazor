@** A DataGrid column with your own cell content; the row is the template's context:
    `<TemplateColumn Title="Actions" Context="order"><button @onclick="() => open(order)">Open</button></TemplateColumn>`.
    It sorts when it has a `sortBy` (`GridSort.byAscending((o) => o.total)`), or, with an ItemsProvider, a
    `sortKey` the server orders by (`sortKey="Brand"`). Place it inside a
    DataGrid: it takes the grid's row type. *@
@typeparam TGridItem
@import { DataGridModel, type ColumnAlign, type GridAggregate, type GridSort } from "@tsazor/ui"
@{ this.register(); }

@code {
    /** The grid this column belongs to. */
    @CascadingParameter({ type: DataGridModel }) grid?: DataGridModel<TGridItem>;
    /** The cell content for a row (the context). */
    @Parameter() childContent?: (item: TGridItem) => RenderFragment;
    /** The header text. */
    @Parameter() title: string = "";
    /** How the column sorts in the browser; it is sortable when set. */
    @Parameter() sortBy?: GridSort<TGridItem>;
    /** Turns sorting off although sortBy or sortKey is set. */
    @Parameter() sortable?: boolean;
    /**
     * The property name an itemsProvider gets in getSortByProperties(); it makes the column sortable on its own, the
     * server ordering by it (QuickGrid reads that name from SortBy's expression).
     */
    @Parameter() sortKey?: string;
    /** The direction of the first click (and of the default sort). */
    @Parameter() initialSortDirection?: "ascending" | "descending";
    /** Sorts the grid by this column from the start. */
    @Parameter() isDefaultSortColumn: boolean = false;
    /** Cell and header alignment: start, center or end. */
    @Parameter() align?: ColumnAlign;
    /** Extra class for the cells. */
    @Parameter() class?: string;
    /** Header content instead of the title text. */
    @Parameter() headerContent?: RenderFragment;
    /** Options shown below the header when its options button is clicked (QuickGrid's ColumnOptions). */
    @Parameter() columnOptions?: RenderFragment;
    /** Offers the grid's built-in filter over the values `filterBy` reads (a template column has none on its own). */
    @Parameter() filterable: boolean = false;
    /** The value the built-in filter tests: `(o) => o.customer`. */
    @Parameter() filterBy?: (item: TGridItem) => unknown;
    /** The property name an itemsProvider gets in getFilterByProperties(). */
    @Parameter() filterKey?: string;
    /**
     * The column's footer summary: a kind over the values `aggregateBy` reads, or your own over the
     * rows; the footer shows the text of String, or your own format.
     */
    @Parameter() aggregate?: GridAggregate<TGridItem>;
    /** The values the built-in aggregates read: `(o) => o.total`. */
    @Parameter() aggregateBy?: (item: TGridItem) => unknown;
    /** Formats the aggregate's value for the footer. */
    @Parameter() aggregateFormat?: (value: unknown) => string;
    /** The column's stable key (a snapshot's name for it). */
    @Parameter() columnKey?: string;
    /** The row's text for an export (default: none — a template column exports nothing). */
    @Parameter() csv?: (item: TGridItem) => string;
    /** The cell a row in the grid's edit shows (the row's context), instead of the normal cell. */
    @Parameter() editContent?: (item: TGridItem) => RenderFragment;

    private register(): void {
        const grid = this.grid;
        if (grid === undefined) throw new Error("TemplateColumn must be placed inside a DataGrid.");
        const content = this.childContent;
        const canSort = this.sortBy !== undefined || this.sortKey !== undefined;
        const sortable = (this.sortable ?? canSort) && canSort;
        grid.addColumn({
            owner: this,
            title: this.title,
            headerContent: this.headerContent,
            columnOptions: this.columnOptions,
            cell: (item) => (content ? content(item) : () => undefined),
            sortable,
            sortBy: this.sortBy,
            sortKey: this.sortKey,
            initialSortDirection: this.initialSortDirection,
            isDefaultSortColumn: this.isDefaultSortColumn,
            align: this.align,
            className: this.class,
            filterable: this.filterable,
            filterBy: this.filterBy,
            filterKey: this.filterKey,
            aggregate: this.aggregate,
            aggregateBy: this.aggregateBy,
            aggregateFormat: this.aggregateFormat,
            editContent: this.editContent,
            columnKey: this.columnKey,
            csv: this.csv,
        });
    }
}
