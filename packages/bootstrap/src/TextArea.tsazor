@** A Bootstrap multi-line text field (`textarea.form-control`; InputBase — bind it with @bind) with an
    optional label and help text; validation state and message as with TextInput. *@
@import { FieldState, ImmediateInput } from "@tsazor/ui/kit"
@import { withClass } from "./attributes"

@inherits InputBase<string>

<div class="mb-3">
    @if (label) {
        <label class="form-label" for="@field.id(id)">@label</label>
    }
    <textarea @ref="element" id="@field.id(id)" rows="@rows" placeholder="@placeholder" disabled="@disabled" readonly="@readOnly" required="@required" value="@(currentValue ?? "")" aria-label="@ariaLabel" @attributes="@withClass(inputClass, inputAttributes)" @onchange="handleChange" @oninput="handleInput"></textarea>
    @if (help) {
        <div class="form-text" id="@field.helpId(id)">@help</div>
    }
    @if (message) {
        <div class="invalid-feedback d-block" role="alert" id="@field.messageId(id)">@message</div>
    }
</div>

@code {
    /** The accessible name when there is no visible label. */
    @Parameter() ariaLabel?: string;
    /** The field's label. */
    @Parameter() label?: string;
    /** A hint below the field, linked to it for screen readers. */
    @Parameter() help?: string;
    /** Placeholder text. */
    @Parameter() placeholder?: string;
    /** Visible lines. */
    @Parameter() rows: number = 3;
    /** Disables the field. */
    @Parameter() disabled: boolean = false;
    /** true shows the value without letting it change: the native readonly — focusable, selectable, submitted (MudBlazor's and Fluent UI Blazor's `ReadOnly`). */
    @Parameter() readOnly: boolean = false;
    /** Marks the field as required. */
    @Parameter() required: boolean = false;
    /** The field's id; generated when omitted. */
    @Parameter() id?: string;
    /** The value follows the typing once it pauses for immediateDelay ms (Fluent UI Blazor's `Immediate`); otherwise it updates on change. */
    @Parameter() immediate: boolean = false;
    /** The pause in ms before an immediate update (`ImmediateDelay`). */
    @Parameter() immediateDelay: number = 200;

    private readonly field = new FieldState("tz-textarea");

    private get message(): string {
        return this.field.message(this.editContext, this.valueExpression);
    }

    private get inputClass(): string {
        const validity = this.field.validity(this.fieldClass);
        return validity === "invalid" ? "form-control is-invalid" : validity === "valid" ? "form-control is-valid" : "form-control";
    }

    private get inputAttributes(): Record<string, unknown> {
        return { ...this.field.aria(this.message, !!this.help, this.id, this.field.validity(this.fieldClass) === "invalid"), ...this.additionalAttributes };
    }

    private immediateInput?: ImmediateInput;

    private handleInput(e: Event): void {
        if (!this.immediate) return;
        this.immediateInput ??= new ImmediateInput(this.disposeSignal);
        this.immediateInput.input(e, this.immediateDelay, (value) => {
            this.currentValue = value;
        });
    }

    private handleChange(e: Event): void {
        this.immediateInput?.cancel();
        this.currentValue = (e.target as HTMLTextAreaElement).value;
    }
}
