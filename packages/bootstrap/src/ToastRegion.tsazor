@** Shows the app's toasts (the `Toaster` service from @tsazor/ui) as Bootstrap toasts in a corner of
    the page. Place it once, in the layout; any component then injects `Toaster` and calls
    `show({ title, message, intent, action })`. Toasts close themselves after their timeout, pause while the
    pointer is over them or focus is in them, and can be closed with their button. The region is a
    polite live region; `danger` toasts are announced as alerts. *@
@import { Toaster, hideFromTopLayer, moveFocusBeforeRemoval, raiseInTopLayer, type ToastEntry } from "@tsazor/ui"
@import { backgroundColor } from "./vocabulary"
@inject Toaster toaster
@import { withClass } from "./attributes"
@import { libraryTexts } from "@tsazor/ui"

<div aria-live="polite" @attributes="@withClass(regionClass, additionalAttributes)" @attach="this.topLayer" @onfocusin="this.entered">
    @foreach (const toast of toaster.toasts) {
        <div @key="toast.id" class="@toastClass(toast)" role="@roleOf(toast)" aria-atomic="true" data-bs-theme="@themeOf(toast)"
             @onmouseenter="() => toaster.pause(toast.id)" @onmouseleave="() => toaster.resume(toast.id)"
             @onfocusin="() => toaster.pause(toast.id)" @onfocusout="() => toaster.resume(toast.id)">
            <div class="d-flex">
                <div class="toast-body">
                    @if (toast.title) {
                        <strong class="d-block">@toast.title</strong>
                    }
                    @toast.message
                </div>
                @if (toast.action) {
                    @* In the toast's own text color, so it keeps its contrast on every background. *@
                    <button type="button" class="btn btn-sm btn-link text-reset fw-semibold m-auto" @onclick="(e: MouseEvent) => this.act(e, toast.id)">@toast.action.label</button>
                }
                <button type="button" class="btn-close me-2 m-auto" aria-label="@t("close")" @onclick="(e: MouseEvent) => this.close(e, toast.id)"></button>
            </div>
        </div>
    }
</div>

@code {
    private readonly t = libraryTexts();

    /** The corner the toasts appear in. */
    @Parameter() position: "top-start" | "top-end" | "bottom-start" | "bottom-end" = "bottom-end";
    /** `@attributes` pass-through (class appends). */
    @Parameter({ captureUnmatchedValues: true }) additionalAttributes?: Record<string, unknown>;

    protected override onInitialized(): void {
        this.observe(this.toaster);
    }

    private region?: HTMLElement;
    private newestToast?: number;

    /** Where the focus came from into the region: it goes back there when the last toast holding it closes. */
    private returnFocus?: HTMLElement;

    private entered(e: FocusEvent): void {
        const from = e.relatedTarget;
        if (from instanceof HTMLElement && !this.region?.contains(from)) this.returnFocus = from;
    }

    private close(e: MouseEvent, id: number): void {
        this.leave(e);
        this.toaster.dismiss(id);
    }

    private act(e: MouseEvent, id: number): Promise<void> {
        this.leave(e);
        return this.toaster.actAsync(id);
    }

    /** A toast that holds the focus is about to close: the focus moves on first, not to the body (WCAG 2.4.3). */
    private leave(e: MouseEvent): void {
        const toast = (e.target as Element | null)?.closest(".toast");
        if (toast && this.region) moveFocusBeforeRemoval(toast, this.region, this.returnFocus);
    }

    /** The container lies in the browser's top layer, so a toast shows above an open modal, as Bootstrap's z-index does. */
    private readonly topLayer = (element: HTMLElement): (() => void) => {
        this.region = element;
        raiseInTopLayer(element);
        return () => {
            hideFromTopLayer(element);
            this.region = undefined;
        };
    };

    /** A new toast after an overlay opened: the container shows itself on top of the top layer again. */
    protected override onAfterRender(): void {
        const newest = this.toaster.toasts.at(-1)?.id;
        if (this.region && newest !== undefined && newest !== this.newestToast) raiseInTopLayer(this.region);
        this.newestToast = newest;
    }

    private get regionClass(): string {
        const [vertical, horizontal] = this.position.split("-");
        return `toast-container position-fixed p-3 ${vertical}-0 ${horizontal}-0`;
    }

    private toastClass(toast: ToastEntry): string {
        return `toast show align-items-center border-0 text-bg-${backgroundColor(toast.intent)}`;
    }

    private roleOf(toast: ToastEntry): string | null {
        return toast.intent === "danger" ? "alert" : null;
    }

    /** Light text and a white close button on the strong colors. */
    private themeOf(toast: ToastEntry): string | null {
        return toast.intent === "primary" || toast.intent === "secondary" || toast.intent === "success" || toast.intent === "danger" ? "dark" : null;
    }
}
