@** A tree view in Bootstrap's variables (Fluent UI Blazor's FluentTreeView): `items` in nested levels, one of
    them selected (`@bind-selectedItem`). The ARIA tree pattern: one node takes Tab; the arrow keys
    move between the visible nodes and open or close them, Home and End jump, Enter and Space
    select. A click selects a node; its chevron opens and closes it. The selected node's ancestors
    start open, so the selection is in view — the same parameters as the Fluent skin's TreeView. *@
@import { initiallyExpanded, treeKeyAction, treePath, visibleTreeItems, type TreeViewItem } from "@tsazor/ui"
@import { withClass } from "./attributes"

<ul role="tree" aria-label="@this.ariaLabel" @attributes="@withClass("tz-tree", this.additionalAttributes)" @ref="root" @onkeydown="handleKeydown">
    @foreach (const item of items) {
        <TreeViewNode @key="item.id" item="@item" level="1" tree="@this" />
    }
</ul>

@code {
    /** The top-level nodes; each may have `items` of its own. */
    @Parameter() items: TreeViewItem[] = [];
    /** The selected node (two-way with @bind-selectedItem). */
    @Parameter() selectedItem?: TreeViewItem | null;
    /** Raised when the user selects a node. */
    @Parameter() selectedItemChanged?: EventCallback<TreeViewItem | null>;
    /** The tree's accessible name. */
    @Parameter() ariaLabel?: string;
    /** Further attributes for the tree element. */
    @Parameter({ captureUnmatchedValues: true }) additionalAttributes?: Record<string, unknown>;

    private root?: HTMLUListElement;
    private expanded?: Set<string>;
    private focusedId?: string;
    /** Move the DOM focus to the focused node after the next render (keyboard moves). */
    private pendingFocus = false;

    protected override onParametersSet(): void {
        // The first items decide what starts open: their `expanded` ones and the selection's ancestors.
        if (this.expanded === undefined && this.items.length > 0) {
            this.expanded = initiallyExpanded(this.items);
            for (const id of this.selectedItem ? treePath(this.items, this.selectedItem.id) ?? [] : []) this.expanded.add(id);
        }
    }

    protected override onAfterRender(): void {
        if (!this.pendingFocus || this.focusedId === undefined) return;
        this.pendingFocus = false;
        this.root?.querySelector<HTMLElement>(`[data-tree-id="${CSS.escape(this.focusedId)}"]`)?.focus();
    }

    isExpanded(item: TreeViewItem): boolean {
        return this.expanded?.has(item.id) ?? false;
    }

    isSelected(item: TreeViewItem): boolean {
        return this.selectedItem?.id === item.id;
    }

    isFocusable(item: TreeViewItem): boolean {
        const focused = this.focusedId ?? this.selectedItem?.id ?? this.items[0]?.id;
        return focused === item.id;
    }

    toggle(item: TreeViewItem): void {
        const expanded = (this.expanded ??= new Set());
        if (expanded.has(item.id)) expanded.delete(item.id);
        else expanded.add(item.id);
        this.focusedId = item.id;
        this.stateHasChanged();
    }

    select(item: TreeViewItem): Promise<void> | undefined {
        if (item.disabled) return undefined;
        this.focusedId = item.id;
        this.selectedItem = item;
        this.stateHasChanged();
        return this.selectedItemChanged?.invokeAsync(item);
    }

    private handleKeydown(e: KeyboardEvent): Promise<void> | undefined {
        const focused = this.focusedId ?? this.selectedItem?.id ?? this.items[0]?.id;
        if (focused === undefined) return undefined;
        const action = treeKeyAction(this.items, this.expanded ?? new Set(), focused, e.key);
        if (action === null) return undefined;
        e.preventDefault();
        const item = visibleTreeItems(this.items, this.expanded ?? new Set()).find((node) => node.item.id === action.id)?.item;
        switch (action.kind) {
            case "focus":
                this.focusedId = action.id;
                this.pendingFocus = true;
                this.stateHasChanged();
                return undefined;
            case "expand":
            case "collapse":
                if (item !== undefined) this.toggle(item);
                return undefined;
            case "select":
                return item === undefined ? undefined : this.select(item);
        }
    }
}
