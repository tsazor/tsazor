@** One node of a TreeView, and — rendering itself — its open subtree. The item's iconStart and iconEnd frame its
    text; iconCollapsed and iconExpanded replace the chevron in their state. *@
@import { hasChildren, type IconValue, type TreeViewItem } from "@tsazor/ui"
@import { ChevronRight } from "./core-icons"
@import type { TreeHost } from "./tree-host"

<li role="treeitem" class="@this.nodeClass" data-tree-id="@item.id" aria-level="@level" aria-expanded="@this.expandedText" aria-selected="@(tree.isSelected(item) ? "true" : "false")" aria-disabled="@(item.disabled ? "true" : null)" tabindex="@(tree.isFocusable(item) ? 0 : -1)" @onclick="select" @onclick:stopPropagation="true">
    <div class="tz-tree__row" style="@this.indent">
        @if (this.branch) {
            <span class="tz-tree__chevron" aria-hidden="true" @onclick="toggle" @onclick:stopPropagation="true"><Icon value="@this.chevron" class="@(this.chevron === ChevronRight ? "tz-tree__chevron-icon" : null)" /></span>
        } else {
            <span class="tz-tree__chevron tz-tree__chevron--leaf" aria-hidden="true"></span>
        }
        @if (item.iconStart) {
            <Icon value="@item.iconStart" class="tz-tree__icon" />
        }
        <span class="tz-tree__text">@item.text</span>
        @if (item.iconEnd) {
            <Icon value="@item.iconEnd" class="tz-tree__icon" />
        }
    </div>
    @if (this.branch && tree.isExpanded(item)) {
        <ul role="group" class="tz-tree__group">
            @foreach (const child of item.items ?? []) {
                <TreeViewNode @key="child.id" item="@child" level="@(level + 1)" tree="@tree" />
            }
        </ul>
    }
</li>

@code {
    @Parameter() item!: TreeViewItem;
    /** The depth, 1 at the top (aria-level). */
    @Parameter() level = 1;
    @Parameter() tree!: TreeHost;

    private get branch(): boolean {
        return hasChildren(this.item);
    }

    /** The item's icon for its state, else a chevron (turned down by CSS while open). */
    private get chevron(): IconValue {
        const open = this.tree.isExpanded(this.item);
        return (open ? this.item.iconExpanded : this.item.iconCollapsed) ?? ChevronRight;
    }

    private get expandedText(): string | null {
        return this.branch ? (this.tree.isExpanded(this.item) ? "true" : "false") : null;
    }

    private get nodeClass(): string {
        let cls = "tz-tree__node";
        if (this.tree.isSelected(this.item)) cls += " tz-tree__node--selected";
        if (this.item.disabled) cls += " tz-tree__node--disabled";
        if (this.branch && this.tree.isExpanded(this.item)) cls += " tz-tree__node--open";
        return cls;
    }

    private get indent(): string {
        return `padding-inline-start: calc(${this.level - 1} * 1.5rem)`;
    }

    private select(): Promise<void> | undefined {
        return this.tree.select(this.item);
    }

    private toggle(): void {
        this.tree.toggle(this.item);
    }
}
