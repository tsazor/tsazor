@** Text on Bootstrap's type scale — the same parameters as the Fluent skin's Typography: `variant` picks
    the element (h1 to h5, p for body, small for caption) and its style; `weight` sets semibold or
    bold. *@
@import { withClass } from "./attributes"
@if (variant === "h1") { <h1 @attributes="@withClass(textClass, additionalAttributes)">@childContent</h1> }
else if (variant === "h2") { <h2 @attributes="@withClass(textClass, additionalAttributes)">@childContent</h2> }
else if (variant === "h3") { <h3 @attributes="@withClass(textClass, additionalAttributes)">@childContent</h3> }
else if (variant === "h4") { <h4 @attributes="@withClass(textClass, additionalAttributes)">@childContent</h4> }
else if (variant === "h5") { <h5 @attributes="@withClass(textClass, additionalAttributes)">@childContent</h5> }
else if (variant === "caption") { <small @attributes="@withClass(textClass, additionalAttributes)">@childContent</small> }
else { <p @attributes="@withClass(textClass, additionalAttributes)">@childContent</p> }

@code {
    /** h1 | h2 | h3 | h4 | h5 | body (default) | caption — also picks the element. */
    @Parameter() variant: "h1" | "h2" | "h3" | "h4" | "h5" | "body" | "caption" = "body";
    /** Optional weight: semibold | bold. */
    @Parameter() weight?: "semibold" | "bold";
    /** The text. */
    @Parameter() childContent?: RenderFragment;
    /** Further attributes for the element. */
    @Parameter({ captureUnmatchedValues: true }) additionalAttributes?: Record<string, unknown>;

    private get textClass(): string | null {
        const parts: string[] = [];
        if (this.variant === "caption") parts.push("d-block", "text-body-secondary");
        if (this.weight) parts.push(this.weight === "bold" ? "fw-bold" : "fw-semibold");
        return parts.length > 0 ? parts.join(" ") : null;
    }
}
