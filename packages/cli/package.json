{
  "name": "@tsazor/cli",
  "version": "0.2.0",
  "license": "MIT",
  "type": "module",
  "description": "Tsazor CLI: `tsazor check` (2.4, typed component-usage gate) and `tsazor codemod` (2.5, .razor → .tsazor).",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "tsazor": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@tsazor/compiler": "workspace:*",
    "@tsazor/lsp": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.17.0"
  }
}
