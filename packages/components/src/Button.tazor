<button type="@type" class="@buttonClass" disabled="@disabled" @onclick="handleClick">@childContent</button>

@code {
    /** Bootstrap color variant: primary | secondary | success | danger | warning | info | link. */
    @Parameter() variant: string = "primary";
    /** Renders the outline variant of the color. */
    @Parameter() outline: boolean = false;
    /** Optional size: sm | lg. */
    @Parameter() size: string = "";
    @Parameter() disabled: boolean = false;
    @Parameter() type: string = "button";
    @Parameter() onClick?: EventCallback<MouseEvent>;
    @Parameter() childContent?: RenderFragment;

    private get buttonClass(): string {
        const base = this.outline ? `btn-outline-${this.variant}` : `btn-${this.variant}`;
        return this.size ? `btn ${base} btn-${this.size}` : `btn ${base}`;
    }

    private handleClick(e: MouseEvent): void {
        this.onClick?.invokeAsync(e);
    }
}