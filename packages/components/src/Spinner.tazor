<span class="@spinnerClass" role="status" aria-hidden="true"></span>
@if (text) {
    <span class="ms-1">@text</span>
}

@code {
    /** Bootstrap color variant (as text color): primary | secondary | success | danger | warning | info | light | dark. */
    @Parameter() variant: string = "primary";
    /** border (default) or grow. */
    @Parameter() kind: string = "border";
    /** Optional size: sm. */
    @Parameter() size: string = "";
    /** Optional visible label rendered next to the spinner. */
    @Parameter() text?: string;

    private get spinnerClass(): string {
        const base = this.kind === "grow" ? "spinner-grow" : "spinner-border";
        const size = this.size === "sm" ? ` ${base}-sm` : "";
        return `${base} text-${this.variant}${size}`;
    }
}