{
  "openapi": "3.0.1",
  "info": { "title": "Swashbuckle Defaults", "version": "1.0" },
  "paths": {
    "/api/User/GetAll": {
      "get": {
        "tags": ["User"],
        "responses": {
          "200": {
            "description": "OK",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UserDtoIApiPagingResult" } } }
          }
        }
      }
    },
    "/api/User/Create": {
      "post": {
        "tags": ["User"],
        "requestBody": {
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UserCreateRequest" } } }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UserDtoIApiResult" } } }
          }
        }
      }
    },
    "/api/User/Delete/{id}": {
      "delete": {
        "tags": ["User"],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": {
          "200": {
            "description": "OK",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BooleanIApiResult" } } }
          }
        }
      }
    },
    "/api/File/Download/{id}": {
      "get": {
        "tags": ["File"],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/File/Download": {
      "get": {
        "tags": ["File"],
        "parameters": [{ "name": "path", "in": "query", "schema": { "type": "string" } }],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/Content/{contentTypeSlug}/GetAll": {
      "get": {
        "tags": ["Content"],
        "parameters": [
          { "name": "contentTypeSlug", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "siteId", "in": "query", "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UserDtoIApiPagingResult" } } }
          }
        }
      }
    },
    "/api/v1/orders": {
      "get": {
        "tags": ["Orders"],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/OrderDto" } } }
            }
          }
        }
      },
      "post": {
        "tags": ["Orders"],
        "requestBody": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OrderDto" } } } },
        "responses": { "201": { "description": "Created" } }
      }
    },
    "/api/v1/orders/{id}": {
      "get": {
        "tags": ["Orders"],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "format": "int32" } }],
        "responses": {
          "200": {
            "description": "OK",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OrderDto" } } }
          }
        }
      },
      "delete": {
        "tags": ["Orders"],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "format": "int32" } }],
        "responses": { "204": { "description": "No Content" } }
      }
    },
    "/robots.txt": {
      "get": {
        "responses": {
          "200": { "description": "OK", "content": { "text/plain": { "schema": { "type": "string" } } } }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AppError": {
        "type": "object",
        "properties": {
          "code": { "type": "string", "nullable": true },
          "description": { "type": "string", "nullable": true }
        },
        "additionalProperties": false
      },
      "UserDto": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "userName": { "type": "string", "nullable": true },
          "data": { "type": "object", "additionalProperties": { "nullable": true } }
        },
        "additionalProperties": false
      },
      "UserCreateRequest": {
        "required": ["userName"],
        "type": "object",
        "properties": { "userName": { "minLength": 1, "type": "string" } },
        "additionalProperties": false
      },
      "OrderDto": {
        "type": "object",
        "properties": { "id": { "type": "integer", "format": "int32" } },
        "additionalProperties": false
      },
      "UserDtoIApiResult": {
        "type": "object",
        "properties": {
          "errors": { "type": "array", "items": { "$ref": "#/components/schemas/AppError" }, "nullable": true, "readOnly": true },
          "isSuccess": { "type": "boolean" },
          "data": { "$ref": "#/components/schemas/UserDto" }
        },
        "additionalProperties": false
      },
      "UserDtoIApiPagingResult": {
        "type": "object",
        "properties": {
          "errors": { "type": "array", "items": { "$ref": "#/components/schemas/AppError" }, "nullable": true, "readOnly": true },
          "isSuccess": { "type": "boolean" },
          "data": { "type": "array", "items": { "$ref": "#/components/schemas/UserDto" }, "nullable": true, "readOnly": true },
          "totalCount": { "type": "integer", "format": "int32" }
        },
        "additionalProperties": false
      },
      "BooleanIApiResult": {
        "type": "object",
        "properties": {
          "errors": { "type": "array", "items": { "$ref": "#/components/schemas/AppError" }, "nullable": true, "readOnly": true },
          "isSuccess": { "type": "boolean" },
          "data": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    }
  }
}
