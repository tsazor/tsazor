{
  "name": "@tsazor/fluent-icons",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "The Fluent System Icons as typed icon values for Tsazor, tree-shaken: Icons.Regular.Size20.Save, as Fluent UI Blazor writes them. Generated from @fluentui/svg-icons (MIT, Microsoft).",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/generate.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@tsazor/ui": "workspace:*"
  },
  "devDependencies": {
    "@fluentui/svg-icons": "1.1.344",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.7"
  },
  "tsazor": {
    "apiSnapshot": false
  }
}
