{
  "name": "@tsazor/fluent",
  "version": "1.0.0-next.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tsazor/tsazor.git",
    "directory": "packages/fluent"
  },
  "homepage": "https://github.com/tsazor/tsazor/tree/main/packages/fluent#readme",
  "bugs": {
    "url": "https://github.com/tsazor/tsazor/issues"
  },
  "type": "module",
  "description": "Fluent 2 design system for Tsazor — token-driven, accessible components written in .tsazor. Install via npm or copy the sources: the components belong to you.",
  "keywords": [
    "tsazor",
    "tsazor-components",
    "components",
    "ui"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "tsazor-fluent": "./bin/fluent.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fluent.css": "./dist/fluent.css",
    "./tsazor-components.json": "./dist/tsazor-components.json"
  },
  "sideEffects": [
    "*.css"
  ],
  "tsazor": {
    "components": "./dist/tsazor-components.json",
    "setup": {
      "styles": [
        "@tsazor/fluent/fluent.css"
      ],
      "services": "addFluent",
      "layout": [
        "ToastRegion"
      ]
    }
  },
  "files": [
    "dist",
    "src",
    "bin"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "vitest run",
    "core-icons": "node scripts/core-icons.mjs"
  },
  "dependencies": {
    "@tsazor/ui": "workspace:*"
  },
  "peerDependencies": {
    "@tsazor/runtime": "workspace:*"
  },
  "devDependencies": {
    "@tsazor/compiler": "workspace:*",
    "@tsazor/fluent-icons": "workspace:*",
    "@tsazor/runtime": "workspace:*",
    "@tsazor/testing": "workspace:*",
    "@tsazor/workspace": "workspace:*",
    "esbuild": "^0.28.2",
    "happy-dom": "^18.0.1",
    "vitest": "^3.2.7"
  }
}
