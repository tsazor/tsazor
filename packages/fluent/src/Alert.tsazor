@if (this.visible) {
<div class="@this.alertClass" role="alert">
    <span class="fui-alert__icon" aria-hidden="true">
        <Icon name="@this.iconName" size="16" />
    </span>
    <div class="fui-alert__body">@childContent</div>
    @if (this.dismissible) {
    <button type="button" class="fui-alert__dismiss" aria-label="Close" @onclick="this.dismiss">
        <Icon name="close" size="12" />
    </button>
    }
</div>
}

@code {
    /** Severity: success | danger | warning | info (default) | neutral. Legacy Bootstrap names are mapped. */
    @Parameter() variant: string = "info";
    /** Shows a dismiss button. */
    @Parameter() dismissible: boolean = false;
    @Parameter() onDismissed?: EventCallback<MouseEvent>;
    @Parameter() childContent?: RenderFragment;

    private visible = true;

    /* Ported API (packages/components/src/Alert.tsazor): primary/secondary/…
     * map onto the Fluent severities; no Bootstrap classes carry through. */
    private get severity(): string {
        const map: Record<string, string> = {
            "primary": "info", "info": "info",
            "success": "success",
            "danger": "danger", "error": "danger",
            "warning": "warning", "caution": "warning",
            "neutral": "neutral", "secondary": "neutral",
        };
        return map[this.variant] ?? "info";
    }

    private get alertClass(): string {
        return `fui-alert fui-alert--${this.severity}`;
    }

    private get iconName(): string {
        const icons: Record<string, string> = {
            "success": "check", "danger": "close",
            "warning": "remove", "info": "remove", "neutral": "remove",
        };
        return icons[this.severity] ?? "remove";
    }

    private async dismiss(e: MouseEvent): Promise<void> {
        this.visible = false;
        this.stateHasChangedInternal();
        await this.onDismissed?.invokeAsync(e);
    }
}