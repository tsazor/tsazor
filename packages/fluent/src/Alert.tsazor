@** A Fluent UI 2 message bar (role="alert") with a status icon; `intent` info (default) | success |
    danger | warning | neutral (primary reads as info, secondary as neutral). With dismissible it shows a Close button that hides the alert and then
    raises onDismissed. *@
@import type { Intent } from "@tsazor/ui"
@import { withAttributes } from "./attributes"
@import { statusColor } from "./vocabulary"

@if (this.visible) {
<div role="alert" @attributes="@this.alertAttributes">
    <span class="fui-alert__icon" aria-hidden="true">
        <Icon name="@this.iconName" size="16" />
    </span>
    <div class="fui-alert__body">@childContent</div>
    @if (this.dismissible) {
    <button type="button" class="fui-alert__dismiss" aria-label="Close" @onclick="this.dismiss">
        <Icon name="close" size="12" />
    </button>
    }
</div>
}

@code {
    /** The status: info (default), success, danger, warning or neutral. */
    @Parameter() intent: Intent = "info";
    /** Shows a dismiss button. */
    @Parameter() dismissible: boolean = false;
    /** `@attributes` pass-through onto the alert div (class appends; see src/attributes.ts). */
    @Parameter({ captureUnmatchedValues: true }) additionalAttributes?: Record<string, unknown>;
    /** Fired after the Close button has hidden the alert; receives the click MouseEvent. */
    @Parameter() onDismissed?: EventCallback<MouseEvent>;
    /** The alert message. */
    @Parameter() childContent?: RenderFragment;

    private visible = true;

    private get alertClass(): string {
        return `fui-alert fui-alert--${statusColor(this.intent)}`;
    }

    /** Fluent classes + role + `@attributes` pass-through. */
    private get alertAttributes(): Record<string, unknown> {
        return withAttributes({ class: this.alertClass }, this.additionalAttributes);
    }

    private get iconName(): string {
        const icons: Record<string, string> = {
            "success": "check", "danger": "close",
            "warning": "remove", "info": "remove", "neutral": "remove",
        };
        return icons[statusColor(this.intent)] ?? "remove";
    }

    private async dismiss(e: MouseEvent): Promise<void> {
        this.visible = false;
        this.stateHasChangedInternal();
        await this.onDismissed?.invokeAsync(e);
    }
}