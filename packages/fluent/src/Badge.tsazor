@** A small Fluent UI 2 pill (span) for a count or short status label: `intent` picks the color
    (primary = brand, secondary/neutral = gray, success, warning, danger, info), `appearance` the
    weight (solid, outline, subtle, transparent), size small | medium. *@
@import type { Appearance, Intent } from "@tsazor/ui"
@import { withAttributes } from "./attributes"
@import { fluentAppearance, fluentColor } from "./vocabulary"

<span @attributes="@this.badgeAttributes">@childContent</span>

@code {
    /** The color: primary (default, the brand color), secondary, success, danger, warning, info or neutral. */
    @Parameter() intent: Intent = "primary";
    /** The visual weight: solid (default), outline, subtle (tinted) or transparent. */
    @Parameter() appearance: Appearance = "solid";
    /** small | medium (default). */
    @Parameter() size: "small" | "medium" = "medium";
    /** `@attributes` pass-through (class appends; see src/attributes.ts). */
    @Parameter({ captureUnmatchedValues: true }) additionalAttributes?: Record<string, unknown>;
    /** The badge text. */
    @Parameter() childContent?: RenderFragment;

    private get badgeClass(): string {
        return `fui-badge fui-badge--${fluentAppearance(this.appearance)} fui-badge--${fluentColor(this.intent)}` +
            (this.size === "small" ? " fui-badge--small" : "");
    }

    private get badgeAttributes(): Record<string, unknown> {
        return withAttributes({ class: this.badgeClass }, this.additionalAttributes);
    }
}
