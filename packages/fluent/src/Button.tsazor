@** A Fluent UI 2 native button. `intent` picks the color (secondary, the default, is Fluent's
    neutral button; primary is the brand button; success, danger, warning, info), `appearance` the
    weight (solid, outline, subtle, transparent); shape rounded | circular, size small | medium |
    large. Raises onClick unless disabled; use type="submit" inside a FluentForm. *@
@import type { Appearance, Intent, Size } from "@tsazor/ui"
@import { withAttributes } from "./attributes"
@import { buttonClasses } from "./vocabulary"

<button type="@type" disabled="@disabled" @attributes="@this.buttonAttributes" @onclick="handleClick">@childContent</button>

@code {
    /** The color: secondary (default, Fluent's neutral button), primary (brand), success, danger, warning, info or neutral. */
    @Parameter() intent: Intent = "secondary";
    /** The visual weight: solid (default), outline, subtle or transparent. */
    @Parameter() appearance: Appearance = "solid";
    /** rounded (default) | circular. */
    @Parameter() shape: "rounded" | "circular" = "rounded";
    /** small | medium (default) | large. */
    @Parameter() size: Size = "medium";
    /** true disables the native button and suppresses onClick. */
    @Parameter() disabled: boolean = false;
    /** Native button role in a form: button (default) | submit | reset. */
    @Parameter() type: "button" | "submit" | "reset" = "button";
    /** Accessible label for icon-only buttons (rendered as aria-label). */
    @Parameter() ariaLabel?: string;
    /** Associates the button with an id-list for screen readers (rendered as aria-describedby). */
    @Parameter() ariaDescribedBy?: string;
    /** `@attributes` pass-through (class appends; see src/attributes.ts). */
    @Parameter({ captureUnmatchedValues: true }) additionalAttributes?: Record<string, unknown>;
    /** Fired on click (not while disabled); receives the MouseEvent. */
    @Parameter() onClick?: EventCallback<MouseEvent>;
    /** The button label (text and/or an Icon). */
    @Parameter() childContent?: RenderFragment;

    private get buttonClass(): string {
        let cls = buttonClasses(this.intent, this.appearance, this.size);
        if (this.shape === "circular") cls += " fui-button--circular";
        if (this.disabled) cls += " fui-button--disabled";
        return cls;
    }

    /** Fluent classes + ARIA + `@attributes` pass-through. */
    private get buttonAttributes(): Record<string, unknown> {
        return withAttributes({
            class: this.buttonClass,
            "aria-label": this.ariaLabel,
            "aria-describedby": this.ariaDescribedBy,
        }, this.additionalAttributes);
    }

    private handleClick(e: MouseEvent): void {
        if (this.disabled) return;
        this.onClick?.invokeAsync(e);
    }
}