@import { withAttributes } from "./attributes"
@import { nextFieldId } from "./ids"
@import { hasSubmitAttempt } from "./form-state"

@inherits InputBase<boolean>

<div class="@this.wrapperClass">
    <input id="@this.elementId" type="checkbox" checked="@this.isChecked" @attributes="@this.inputAttributes" @onchange="this.handleChange" />
    @if (this.label) {
        <label class="fui-checkbox__label" for="@this.elementId">@this.label</label>
    }
    @if (this.message) {
        <span class="fui-input__message" role="alert" id="@this.messageId">@this.message</span>
    }
</div>

@code {
    /** Label rendered to the right of the box. */
    @Parameter() label?: string;
    @Parameter() disabled: boolean = false;
    @Parameter() required: boolean = false;
    /** Element id; generated automatically when omitted (label `for` / `aria-describedby`). */
    @Parameter() id?: string;
    /** Overrides the accessible name (when unlabelled). */
    @Parameter() ariaLabel?: string;

    private generatedId?: string;

    private get elementId(): string {
        return this.id ?? (this.generatedId ??= nextFieldId("fui-checkbox"));
    }

    private get isChecked(): boolean {
        return this.currentValue === true;
    }

    private get wrapperClass(): string {
        const base = "fui-checkbox";
        if (this.fieldClass.includes("invalid")) return `${base} fui-checkbox--invalid`;
        if (this.fieldClass) return `${base} fui-checkbox--valid`;
        return base;
    }

    private get inputAttributes(): Record<string, unknown> {
        return withAttributes({
            class: "fui-checkbox__native",
            disabled: this.disabled ? true : undefined,
            required: this.required ? true : undefined,
            "aria-label": this.ariaLabel,
            "aria-invalid": this.message ? "true" : undefined,
            "aria-describedby": this.message ? this.messageId : undefined,
        }, this.additionalAttributes);
    }

    private get messageId(): string {
        return `${this.elementId}-message`;
    }

    /** The message row only shows once a submit was attempted (role="alert" stays submit-bound). */
    private get message(): string {
        if (!hasSubmitAttempt(this.editContext)) return "";
        if (!this.editContext || !this.ValueExpression) return "";
        const messages = this.editContext.getValidationMessages(this.ValueExpression);
        return messages[0] ?? "";
    }

    private handleChange(e: Event): void {
        this.currentValue = (e.target as HTMLInputElement).checked as never;
    }
}