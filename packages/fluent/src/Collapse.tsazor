@** Shows or hides content, controlled by the parent through `isOpen`. The content is rendered only
    while open. *@
@if (isOpen) {
    <div class="fui-collapse">@childContent</div>
}

@code {
    /** Whether the collapsible content is visible. */
    @Parameter() isOpen: boolean = false;
    /** The content shown while open. */
    @Parameter() childContent?: RenderFragment;
}
