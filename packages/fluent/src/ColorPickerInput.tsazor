@** A Fluent UI 2 color field (Fluent UI Blazor's FluentColorPickerInput, MudBlazor's MudColorPicker in a popover;
    InputBase — bind it with @bind-value): a text field for the color's hex code ("#0f6cbd"; "#fc0" works too) and a
    button that shows the color and opens a ColorPicker in a dialog — `view`, `palette` and `findClosestColor` as the
    picker's. A click on a swatch, Enter or Space, or the end of a drag in the square picks the color and closes the
    dialog; Escape closes it too, the focus back on the button. Alt+ArrowDown in the field opens it. `hideTextInput`
    leaves the button alone: the label names it then, and it carries the field's help, message and invalid state.
    Text that is no color goes to validation as it was typed. *@
@import {
    anchoredPosition, createLayer, dismissible, focusTrap, type ColorPickerLabels, type IconValue,
} from "@tsazor/ui"
@import { FieldState, normalizeHexColor } from "@tsazor/ui/kit"
@import { withAttributes } from "./attributes"
@import { Color20Regular } from "./core-icons"
@import { libraryTexts } from "@tsazor/ui"
@import { topLayer } from "@tsazor/ui"

@inherits InputBase<string>

<div class="@this.wrapperClass">
    @if (this.label) {
        <label class="fui-input__label" id="@(`${this.buttonId}-label`)" for="@this.inputId">@this.label</label>
    }
    <div class="fui-color-picker-input__field" @ref="fieldBox">
        @if (!this.hideTextInput) {
            <input @ref="element" id="@this.field.id(this.id)" type="text" autocomplete="off" spellcheck="false" maxlength="7" @attributes="@this.inputAttributes" value="@(this.currentValue ?? "")" @onchange="this.handleChange" @onkeydown="this.fieldKeydown" />
        }
        <button type="button" id="@this.buttonId" class="fui-color-picker-input__button" aria-label="@this.buttonName" title="@this.buttonText" aria-haspopup="dialog"
                aria-expanded="@(this.open ? "true" : "false")" disabled="@(this.disabled || this.readOnly)" @attributes="@this.buttonAttributes" @ref="button" @onclick="this.toggle">
            <span class="fui-color-picker-input__swatch" style="@(`background: ${this.color ?? "transparent"}`)" aria-hidden="true"></span>
            <Icon value="@this.iconPalette" />
        </button>
    </div>
    @if (this.open) {
        <div class="fui-color-picker-input__popup" role="dialog" aria-modal="true" aria-label="@(this.buttonLabel ?? t("colorPicker.button"))" @attach:top="topLayer()" @attach="this.dismiss" @attach:position="this.position" @attach:trap="this.trap">
            <ColorPicker selectedColor="@this.color" selectedColorChanged="@this.changed" onPick="@this.picked" view="@this.view" palette="@this.palette" findClosestColor="@this.findClosestColor" labels="@this.labels" />
        </div>
    }
    @if (this.help) {
        <span class="fui-input__help" id="@this.field.helpId(this.id)">@this.help</span>
    }
    @if (this.message) {
        <span class="fui-input__message" role="alert" id="@this.field.messageId(this.id)">@this.message</span>
    }
</div>

@code {
    private readonly t = libraryTexts();

    /** The field's label. */
    @Parameter() label?: string;
    /** A hint below the field, linked to it for screen readers. */
    @Parameter() help?: string;
    /** The text field's placeholder. */
    @Parameter() placeholder: string = "#rrggbb";
    /** The dialog's picker: swatch (default), wheel or hsv (`View`). */
    @Parameter() view: "swatch" | "wheel" | "hsv" = "swatch";
    /** The picker's colors (`Palette`). */
    @Parameter() palette?: string[];
    /** Marks the palette's nearest color when the color isn't in it (`FindClosestColor`). */
    @Parameter() findClosestColor: boolean = true;
    /** Only the button, no text field (`HideTextInput`). */
    @Parameter() hideTextInput: boolean = false;
    /** The button's icon next to the color (`IconPalette`). */
    @Parameter() iconPalette: IconValue = Color20Regular;
    /** The button's and the dialog's name. */
    @Parameter() buttonLabel?: string;
    /** The picker's texts (English by default). */
    @Parameter() labels?: Partial<ColorPickerLabels>;
    /** Disables the field and the button. */
    @Parameter() disabled: boolean = false;
    /** Shows the value without letting it change. */
    @Parameter() readOnly: boolean = false;
    /** Marks the field as required (the native attribute). */
    @Parameter() required: boolean = false;
    /** The text field's id; generated when omitted. */
    @Parameter() id?: string;
    /** The text field's accessible name when there is no label. */
    @Parameter() ariaLabel?: string;

    private readonly field = new FieldState("fui-color-picker-input");
    private open = false;
    private fieldBox?: HTMLDivElement;
    private button?: HTMLButtonElement;

    /** The trap and the dismiss handling are one overlay layer (inside a Dialog, Escape closes the picker first). */
    private readonly layer = createLayer();
    private readonly dismiss = dismissible({ layer: this.layer, onDismiss: () => this.setOpen(false), ignore: () => [this.button] });
    private readonly position = anchoredPosition({ anchor: () => this.fieldBox, placement: "bottom-start" });
    private readonly trap = focusTrap({ layer: this.layer, initialFocus: (popup) => popup.querySelector<HTMLElement>("[tabindex='0']") });

    /** The value as a color, when it is one. */
    private get color(): string | undefined {
        return normalizeHexColor(this.currentValue ?? "");
    }

    /** The label points at the text field, or at the button without one. */
    private get inputId(): string {
        return this.hideTextInput ? this.buttonId : this.field.id(this.id);
    }

    private get buttonId(): string {
        return `${this.field.id(this.id)}-button`;
    }

    /** The button says what it does and the color it shows. */
    private get buttonText(): string {
        const label = this.buttonLabel ?? this.t("colorPicker.button");
        return this.color === undefined ? label : `${label} (${this.color})`;
    }

    /** The button's name: its text, after `ariaLabel` when there is no text field to carry that. */
    private get buttonName(): string {
        return this.hideTextInput && this.ariaLabel ? `${this.ariaLabel}, ${this.buttonText}` : this.buttonText;
    }

    /**
     * Without the text field the button is the field: the label names it (aria-labelledby — the label, then the
     * button's own text), and it carries the field's help, message and invalid state.
     */
    private get buttonAttributes(): Record<string, unknown> | undefined {
        if (!this.hideTextInput) return undefined;
        return {
            "aria-labelledby": this.label ? `${this.buttonId}-label ${this.buttonId}` : undefined,
            ...this.field.aria(this.message, !!this.help, this.id, this.validity === "invalid"),
        };
    }

    private get message(): string {
        return this.field.message(this.editContext, this.valueExpression);
    }

    private get validity(): string {
        return this.field.validity(this.fieldClass);
    }

    private get wrapperClass(): string {
        const cls = "fui-input-wrapper fui-color-picker-input";
        return this.validity === "invalid" ? `${cls} fui-input-wrapper--invalid` : cls;
    }

    private get inputAttributes(): Record<string, unknown> {
        const cls = this.validity === "invalid" ? "fui-input fui-input--invalid" : this.validity === "valid" ? "fui-input fui-input--valid" : "fui-input";
        return withAttributes({
            class: cls,
            placeholder: this.placeholder,
            disabled: this.disabled ? true : undefined,
            readonly: this.readOnly ? true : undefined,
            required: this.required ? true : undefined,
            "aria-label": this.ariaLabel,
            ...this.field.aria(this.message, !!this.help, this.id, this.validity === "invalid"),
        }, this.additionalAttributes);
    }

    private handleChange(e: Event): void {
        const text = (e.target as HTMLInputElement).value;
        // Empty clears; a color becomes #rrggbb; anything else goes to validation as typed.
        this.currentValue = text.trim() === "" ? "" : normalizeHexColor(text) ?? text;
    }

    private fieldKeydown(e: KeyboardEvent): void {
        if (e.key !== "ArrowDown" || !e.altKey || this.open || this.disabled || this.readOnly) return;
        e.preventDefault();
        this.setOpen(true);
    }

    private toggle(): void {
        this.setOpen(!this.open);
    }

    private setOpen(open: boolean): void {
        if (this.open === open) return;
        this.open = open;
        this.stateHasChanged();
    }

    private readonly changed = (color: string): void => {
        this.currentValue = color;
    };

    private readonly picked = (color: string): void => {
        this.currentValue = color;
        this.setOpen(false);
    };
}
