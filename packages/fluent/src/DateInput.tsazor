@** A Fluent UI 2 date field (the browser's date picker; InputBase — bind it with @bind) with an optional
    label and help text. The value is the ISO text the input edits (empty when cleared): `"2026-10-07"`,
    or with `type` (Blazor's InputDateType) `"2026-10-07T09:30"`, `"2026-10"` or `"09:30"`; a plain
    string has no time zone to shift the day. Inside a FluentForm it shows the field's first
    validation message once a submit was attempted. *@
@import { FieldState } from "@tsazor/ui"
@import { withAttributes } from "./attributes"

@inherits InputBase<string>

<div class="@wrapperClass">
    @if (label) {
        <label class="fui-input__label" for="@field.id(id)">@label</label>
    }
    <input @ref="element" id="@field.id(id)" type="@type" value="@(currentValue ?? "")" @attributes="@this.inputAttributes" @onchange="handleChange" />
    @if (help) {
        <span class="fui-input__help" id="@field.helpId(id)">@help</span>
    }
    @if (message) {
        <span class="fui-input__message" role="alert" id="@field.messageId(id)">@message</span>
    }
</div>

@code {
    /** The field's label (clicking it focuses the input). */
    @Parameter() label?: string;
    /** A hint below the input, linked to it for screen readers. */
    @Parameter() help?: string;
    /** What the input edits (Blazor's InputDateType): date, datetime-local, month or time. */
    @Parameter() type: "date" | "datetime-local" | "month" | "time" = "date";
    /** The earliest date, as ISO text ("2026-01-01"). */
    @Parameter() min?: string;
    /** The latest date, as ISO text. */
    @Parameter() max?: string;
    /** Disables the input. */
    @Parameter() disabled: boolean = false;
    /** Marks the input as required (the native attribute). */
    @Parameter() required: boolean = false;
    /** The input's id; generated when omitted. */
    @Parameter() id?: string;

    private readonly field = new FieldState("fui-date");

    private get message(): string {
        return this.field.message(this.editContext, this.valueExpression);
    }

    private get validity(): string {
        return this.field.validity(this.fieldClass);
    }

    private get wrapperClass(): string {
        return this.validity === "invalid" ? "fui-input-wrapper fui-input-wrapper--invalid" : "fui-input-wrapper";
    }

    private get inputAttributes(): Record<string, unknown> {
        const cls = this.validity === "invalid" ? "fui-input fui-input--invalid" : this.validity === "valid" ? "fui-input fui-input--valid" : "fui-input";
        return withAttributes({
            class: cls,
            min: this.min,
            max: this.max,
            disabled: this.disabled ? true : undefined,
            required: this.required ? true : undefined,
            ...this.field.aria(this.message, !!this.help, this.id),
        }, this.additionalAttributes);
    }

    private handleChange(e: Event): void {
        this.currentValue = (e.target as HTMLInputElement).value;
    }
}
