@** A Fluent UI 2 modal dialog (role="dialog", aria-modal) over a backdrop, rendered while isOpen.
    On open it locks body scroll and moves focus into the overlay; Tab wraps within the dialog and
    focus returns to the previous element on close. Escape, a backdrop click or the header's Close
    button raise onClosed; the parent then sets isOpen to false. In a component the DialogService shows
    (MudBlazor's MudDialog), leave isOpen unset: the dialog is open until it closes, takes its title, size and
    closing rules from `show`, and Escape, the backdrop and Close cancel it. *@
@import { withAttributes } from "./attributes"
@import { Dismiss20Regular } from "./core-icons"
@import { createLayer, DialogReference, dismissable, focusTrap, scrollLock, uniqueId, type DismissReason } from "@tsazor/ui"

@if (this.shown) {
    <div class="fui-dialog-overlay" @attach="trap" @attach:lock="lock">
        <div role="dialog" aria-modal="true" @attributes="@this.dialogAttributes" @attach="dismiss">
            @if (this.shownTitle) {
                <div class="fui-dialog__header">
                    <h2 class="fui-dialog__title" id="@this.labelledBy">@this.shownTitle</h2>
                    <button type="button" class="fui-dialog__close" aria-label="Close" @onclick="this.requestClose"><Icon value="@Dismiss20Regular" /></button>
                </div>
            }
            <div class="fui-dialog__body">@childContent</div>
            @if (this.footer) {
                <div class="fui-dialog__footer">@this.footer</div>
            }
        </div>
    </div>
}

@code {
    /** Whether the dialog is visible; the parent flips this in response to onClosed. Unset in a component the DialogService shows. */
    @Parameter() isOpen?: boolean;
    /** The DialogService's dialog this one is the frame of (when isOpen is unset). */
    @CascadingParameter({ type: DialogReference }) hosted?: DialogReference;
    /** Optional heading; omitting it hides the header row. */
    @Parameter() title?: string;
    /** The width: small 400px, medium 560px, large 800px, xlarge 1140px (at most the viewport's); Bootstrap's sizes. */
    @Parameter() size: "small" | "medium" | "large" | "xlarge" = "medium";
    /** Overrides the dialog's accessible name (when unheaded). */
    @Parameter() ariaLabel?: string;
    /** Element id (the title's id for aria-labelledby); generated automatically when omitted. */
    @Parameter() id?: string;
    /** `@attributes` pass-through (class appends; see src/attributes.ts). */
    @Parameter({ captureUnmatchedValues: true }) additionalAttributes?: Record<string, unknown>;
    /** Closes when the backdrop itself is clicked (not the dialog). */
    @Parameter() closeOnBackdrop: boolean = true;
    /** Closes when the user presses Escape. */
    @Parameter() closeOnEscape: boolean = true;
    /** Fired when the user asks to close (Escape, the backdrop or the close button). It carries no event: Escape and the backdrop have none to give. */
    @Parameter() onClosed?: EventCallback;
    /** Dialog body. */
    @Parameter() childContent?: RenderFragment;
    /** Footer content (e.g. Cancel/Confirm buttons). */
    @Parameter() footer?: RenderFragment;

    /** The trap and the dismiss handling are one overlay layer (nested dialogs close one at a time). */
    private readonly layer = createLayer();
    private readonly trap = focusTrap({ layer: this.layer });
    private readonly lock = scrollLock;
    private readonly dismiss = dismissable({ layer: this.layer, onDismiss: (reason) => this.dismissed(reason) });

    private generatedId?: string;

    private get elementId(): string {
        return this.id ?? (this.generatedId ??= uniqueId("fui-dialog"));
    }

    /** The service's dialog, when this is its frame: isOpen unset (a dialog inside one sets it). */
    private get hostedBy(): DialogReference | undefined {
        return this.isOpen === undefined ? this.hosted : undefined;
    }

    private get shown(): boolean {
        return this.isOpen ?? this.hostedBy !== undefined;
    }

    private get shownTitle(): string | undefined {
        return this.title ?? this.hostedBy?.options.title;
    }

    private get shownSize(): "small" | "medium" | "large" | "xlarge" {
        return this.hostedBy?.options.size ?? this.size;
    }

    private get labelledBy(): string | null {
        return this.shownTitle ? `${this.elementId}-title` : null;
    }

    private get dialogAttributes(): Record<string, unknown> {
        return withAttributes({
            class: this.shownSize === "medium" ? "fui-dialog" : `fui-dialog fui-dialog--${this.shownSize}`,
            "aria-label": this.ariaLabel,
            "aria-labelledby": this.labelledBy,
        }, this.additionalAttributes);
    }

    private dismissed(reason: DismissReason): void {
        // The behavior's callback is outside the renderer: its errors go to the ErrorBoundary by hand.
        const options = this.hostedBy?.options;
        const closes = reason === "escape" ? (options?.closeOnEscape ?? this.closeOnEscape) : (options?.closeOnBackdrop ?? this.closeOnBackdrop);
        if (closes) this.requestClose()?.catch((error) => this.dispatchExceptionAsync(error));
    }

    private requestClose(): Promise<void> | undefined {
        this.hostedBy?.cancel();
        return this.onClosed?.invokeAsync();
    }
}
