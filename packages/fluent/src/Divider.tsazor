@import { withAttributes } from "./attributes"

<hr role="separator" @attributes="@this.dividerAttributes" />

@code {
    /** Axis: horizontal (default) | vertical. */
    @Parameter() orientation: "horizontal" | "vertical" = "horizontal";
    /** Stroke strength: default | subtle | stronger. */
    @Parameter() appearance: "default" | "subtle" | "stronger" = "default";
    /** `@attributes` pass-through (class appends; see src/attributes.ts). */
    @Parameter({ captureUnmatchedValues: true }) additionalAttributes?: Record<string, unknown>;

    private get dividerClass(): string {
        let cls = this.orientation === "vertical" ? "fui-divider fui-divider--vertical" : "fui-divider";
        if (this.appearance !== "default") cls += ` fui-divider--${this.appearance}`;
        return cls;
    }

    private get dividerAttributes(): Record<string, unknown> {
        return withAttributes({
            class: this.dividerClass,
            "aria-orientation": this.orientation,
        }, this.additionalAttributes);
    }
}