@** A form (class "fui-form") around the runtime EditForm: it cascades the EditContext to the
    Fluent inputs inside, validates on submit and raises onValidSubmit or onInvalidSubmit. It also
    records the submit attempt, which makes the inputs show their validation messages. Put a
    Button with type="submit" inside. *@
@using @tsazor/runtime
@import type { EditContext } from "@tsazor/runtime"
@import { withAttributes } from "./attributes"
@import { markSubmitAttempt } from "@tsazor/ui"

<EditForm @attributes="@this.formAttributes" Model="@model" Validators="@validators" OnValidSubmit="@this.handleSubmit" OnInvalidSubmit="@this.handleInvalidSubmit" Context="formContext">@childContent(formContext)</EditForm>

@code {
    /** Model to edit and validate (passed to the inner EditForm). */
    @Parameter() model!: object;
    /** Field validators (passed to the inner EditForm). */
    @Parameter() validators?: Record<string, unknown>;
    /** Invoked after a successful submit (receives the EditContext, like EditForm itself). */
    @Parameter() onValidSubmit?: EventCallback<EditContext>;
    /** Invoked after a failed validation (receives the EditContext). */
    @Parameter() onInvalidSubmit?: EventCallback<EditContext>;
    /** `@attributes` pass-through to the form element (class appends; see src/attributes.ts). */
    @Parameter({ captureUnmatchedValues: true }) additionalAttributes?: Record<string, unknown>;
    /** Form contents (the fluent inputs + submit Button); receives the EditContext. */
    @Parameter() childContent?: (context: EditContext) => RenderFragment;

    private get formAttributes(): Record<string, unknown> {
        return withAttributes({ class: "fui-form" }, this.additionalAttributes);
    }

    private handleSubmit = EventCallback.bind(this, (context: EditContext) => {
        // From here on the inputs show their error rows (role="alert", 4.2).
        markSubmitAttempt(context);
        this.onValidSubmit?.invokeAsync(context);
    });

    private handleInvalidSubmit = EventCallback.bind(this, (context: EditContext) => {
        markSubmitAttempt(context);
        this.onInvalidSubmit?.invokeAsync(context);
    });
}