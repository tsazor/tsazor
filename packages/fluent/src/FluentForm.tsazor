@using @tsazor/runtime
@import type { EditContext } from "@tsazor/runtime"
<EditForm class="fui-form" Model="@model" Validators="@validators" OnValidSubmit="@handleSubmit" Context="formContext">@childContent(formContext)</EditForm>

@code {
    /** Model to edit and validate (passed to the inner EditForm). */
    @Parameter() model!: object;
    /** Field validators (passed to the inner EditForm). */
    @Parameter() validators?: Record<string, unknown>;
    /** Invoked after a successful submit (receives the EditContext, like EditForm itself). */
    @Parameter() onValidSubmit?: EventCallback<EditContext>;
    /** Form contents (the fluent inputs + submit Button); receives the EditContext. */
    @Parameter() childContent?: (context: EditContext) => RenderFragment;

    private handleSubmit = EventCallback.bind(this, (context: EditContext) => {
        this.onValidSubmit?.invokeAsync(context);
    });
}