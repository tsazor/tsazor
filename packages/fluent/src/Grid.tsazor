@import { withAttributes } from "./attributes"

<div @attributes="@this.gridAttributes">@childContent</div>

@code {
    /** Column count when no minChildWidth is given. */
    @Parameter() columns: number = 3;
    /** Gap between tracks: xs | s | m (default) | l | xl. */
    @Parameter() gap?: "xs" | "s" | "m" | "l" | "xl";
    /** Responsive min column width (CSS length, e.g. "240px"); switches to auto-fill/minmax. */
    @Parameter() minChildWidth?: string;
    /** `@attributes` pass-through (class appends; see src/attributes.ts). */
    @Parameter({ captureUnmatchedValues: true }) additionalAttributes?: Record<string, unknown>;
    @Parameter() childContent?: RenderFragment;

    /** minChildWidth > columns: responsive via CSS grid tracks, no JS. */
    private get gridClass(): string {
        return this.minChildWidth ? "fui-grid fui-grid--minmax" : "fui-grid";
    }

    private get gridAttributes(): Record<string, unknown> {
        return withAttributes({ class: this.gridClass, style: this.gridStyle }, this.additionalAttributes);
    }

    private get gridStyle(): string | null {
        const parts: string[] = [];
        const track = this.minChildWidth
            ? `repeat(auto-fill, minmax(${this.minChildWidth}, 1fr))`
            : `repeat(${this.columns}, 1fr)`;
        parts.push(`grid-template-columns: ${track}`);
        if (this.gap) parts.push(`gap: var(--fui-spacing-${this.gap})`);
        return parts.join("; ");
    }
}