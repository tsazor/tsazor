@** An inline SVG icon, drawn in currentColor: a `value` (an `IconValue`: a generated set's, or an app's own made with
    `icon()` from @tsazor/ui), or a `name` from the small built-in set. Decorative (aria-hidden) by default; with a
    title (or ariaLabel) it gets role="img". An unknown name falls back to check. *@
@import { MarkupString } from "@tsazor/runtime"
@import { builtInIcons, type IconValue } from "@tsazor/ui"
@import { withAttributes } from "./attributes"

<svg @attributes="@this.iconAttributes">@(new MarkupString(this.icon.content))</svg>

@code {
    /** The icon (Fluent UI Blazor's `Value`): a generated set's value, or an app's own from `icon()`. Wins over name. */
    @Parameter() value?: IconValue;
    /** A name from the built-in set: chevron-left, chevron-right, close, check, arrow-left, arrow-right, arrow-up, arrow-down, search, add, remove, folder, folder-up, document, image, download. */
    @Parameter() name?: string;
    /** Pixel size (width/height); defaults to the 16px body icon size. */
    @Parameter() size: number = 16;
    /** The icon's color (any CSS color); by default the text color around it. */
    @Parameter() color?: string;
    /** The accessible name (Fluent UI Blazor's `Title`); without it (or ariaLabel) the icon is decorative. */
    @Parameter() title?: string;
    /** Accessible label — hides the icon from AT unless a label is given. */
    @Parameter() ariaLabel?: string;
    /** `@attributes` pass-through (class appends; see src/attributes.ts). */
    @Parameter({ captureUnmatchedValues: true }) additionalAttributes?: Record<string, unknown>;

    private get icon(): IconValue {
        return this.value ?? builtInIcons[this.name ?? ""] ?? (builtInIcons["check"] as IconValue);
    }

    private get label(): string | undefined {
        return this.ariaLabel ?? this.title;
    }

    private get iconAttributes(): Record<string, unknown> {
        const label = this.label;
        return withAttributes({
            class: "fui-icon",
            width: this.size,
            height: this.size,
            viewBox: this.icon.viewBox,
            fill: "currentColor",
            style: this.color === undefined ? null : `color: ${this.color}`,
            // aria-hidden takes string semantics (booleans render as empty attributes).
            "aria-hidden": label === undefined ? "true" : "false",
            "aria-label": label,
            role: label === undefined ? null : "img",
            focusable: "false",
        }, this.additionalAttributes);
    }
}
