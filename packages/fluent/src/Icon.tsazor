@** An inline SVG icon from a small built-in stroke set, drawn in currentColor. Decorative
    (aria-hidden) by default; with ariaLabel it gets role="img". Unknown names fall back to check. *@
@import { withAttributes } from "./attributes"

<svg @attributes="@this.iconAttributes">
    <path d="@this.path" />
</svg>

@code {
    /** Icon name from the built-in set: chevron-left, chevron-right, close, check, arrow-left, arrow-right, arrow-up, arrow-down, search, add, remove, folder, folder-up, document, image, download. */
    @Parameter() name?: string;
    /** Pixel size (width/height); defaults to the 16px body icon size. */
    @Parameter() size: number = 16;
    /** Accessible label — hides the icon from AT unless a label is given. */
    @Parameter() ariaLabel?: string;
    /** `@attributes` pass-through (class appends; see src/attributes.ts). */
    @Parameter({ captureUnmatchedValues: true }) additionalAttributes?: Record<string, unknown>;

    private get path(): string {
        return Icon.paths[this.name ?? ""] ?? Icon.paths["check"] as string;
    }

    /** aria-hidden takes string semantics (booleans render as empty attributes). */
    private get hiddenValue(): string {
        return this.ariaLabel === undefined ? "true" : "false";
    }

    private get role(): string | null {
        return this.ariaLabel === undefined ? null : "img";
    }

    private get iconAttributes(): Record<string, unknown> {
        return withAttributes({
            class: "fui-icon",
            width: this.size,
            height: this.size,
            viewBox: "0 0 20 20",
            fill: "none",
            stroke: "currentColor",
            "stroke-width": 1.5,
            "stroke-linecap": "round",
            "stroke-linejoin": "round",
            "aria-hidden": this.hiddenValue,
            "aria-label": this.ariaLabel,
            role: this.role,
            focusable: "false",
        }, this.additionalAttributes);
    }

    /** Inline-SVG technique (pre-clarified local decision): single-path strokes, no sprite, no icon package. */

    private static paths: Record<string, string> = {
        "chevron-left": "M12 3L5 10l7 7",
        "chevron-right": "M8 3l7 7-7 7",
        "close": "M3 3l14 14M17 3L3 17",
        "check": "M3 11l5 5L17 6",
        "arrow-left": "M17 10H3m0 0l6-6m-6 6l6 6",
        "arrow-right": "M3 10h14m0 0l-6-6m6 6l-6 6",
        "arrow-up": "M10 17V3m0 0L4 9m6-6l6 6",
        "arrow-down": "M10 3v14m0 0l6-6m-6 6l-6-6",
        "search": "M9 3a6 6 0 100 12A6 6 0 009 3zm9 15l-4.3-4.3",
        "add": "M10 3v14M3 10h14",
        "remove": "M3 10h14",
        "folder": "M2.5 5.5a1 1 0 011-1h4l2 2h7a1 1 0 011 1v8a1 1 0 01-1 1h-13a1 1 0 01-1-1z",
        "folder-up": "M2.5 5.5a1 1 0 011-1h4l2 2h7a1 1 0 011 1v8a1 1 0 01-1 1h-13a1 1 0 01-1-1zM10 14V9.5m0 0L7.5 12M10 9.5l2.5 2.5",
        "document": "M5.5 2.5h6l3.5 3.5v10.5a1 1 0 01-1 1h-8.5a1 1 0 01-1-1v-13a1 1 0 011-1zM11.5 2.5V6h3.5",
        "image": "M3.5 3.5h13v13h-13zM3.5 13.5l4-4 3.5 3.5 2-2 3.5 3.5M12.5 6.5a1 1 0 100 2 1 1 0 000-2z",
        "download": "M10 3v10m0 0l-4-4m4 4l4-4M3.5 16.5h13",
    };
