@** One entry of a Fluent UI 2 Menu (`role="menuitem"`); also available as `DropdownItem`. Place it
    inside a Menu; choosing it (click, Enter or Space) raises onSelect, then closes the menu and returns
    focus to the toggle. *@
@import type Menu from "./Menu.tsazor"
<li role="none">
    <button class="fui-menu__item" type="button" role="menuitem" tabindex="-1" disabled="@disabled" @onclick="handleClick">@childContent</button>
</li>

@code {
    /** Fired when the item is chosen. */
    @Parameter() onSelect?: EventCallback<MouseEvent>;
    /** Greys the item out; the arrow keys skip it. */
    @Parameter() disabled: boolean = false;
    /** The item's label. */
    @Parameter() childContent?: RenderFragment;

    /** Resolved from the nearest Menu ancestor; selection closes the menu. */
    @CascadingParameter({ name: "FluentMenu" }) menu?: Menu;

    private handleClick(e: MouseEvent): Promise<void> | undefined {
        const selected = this.onSelect?.invokeAsync(e);
        this.menu?.close(true);
        return selected;
    }
}
