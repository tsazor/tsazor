@** A Fluent UI 2 progress bar (`role="progressbar"` with `aria-valuenow`) for a value in percent,
    clamped to 0–100; `intent` colors the bar (brand by default), `label` shows below it. *@
@import type { Intent } from "@tsazor/ui"
@import { fluentColor } from "./vocabulary"

<div class="fui-progress-field">
    <div class="fui-progress" role="progressbar" aria-label="@accessibleName" aria-valuenow="@clamped" aria-valuemin="0" aria-valuemax="100">
        <div class="@barClass" style="width: @(clamped)%"></div>
    </div>
    @if (label) {
        <span class="fui-progress__label" aria-hidden="true">@label</span>
    }
</div>

@code {
    /** Progress value in percent (0–100). */
    @Parameter() value: number = 0;
    /** The bar's color role: primary (default, the brand color), success, warning, danger, info. */
    @Parameter() intent?: Intent;
    /** Text below the bar (also the accessible name when `ariaLabel` is unset). */
    @Parameter() label?: string;
    /** The progress bar's accessible name, e.g. "Upload" — a screen reader needs one (WCAG 4.1.2). */
    @Parameter() ariaLabel?: string;

    private get accessibleName(): string | undefined {
        return this.ariaLabel ?? this.label;
    }

    private get clamped(): number {
        return Math.max(0, Math.min(100, this.value));
    }

    private get barClass(): string {
        return `fui-progress__bar fui-progress__bar--${fluentColor(this.intent ?? "primary")}`;
    }
}
