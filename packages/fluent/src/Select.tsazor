@** A Fluent UI 2 dropdown (native select, InputBase) with an optional label, in two ways. For a string, bind it
    with @bind-Value and give the `<option>`s as child content. For typed options (Fluent UI Blazor's
    FluentSelect<TOption>, MudSelect<T>), give `items` and `optionText` and bind @bind-selectedOption: the choice is
    the option itself — an enum member, a number, an object — with nothing parsed; `placeholder` adds an empty choice,
    null (bind a `T | null` then). Inside a FluentForm it shows the field's first validation message (role="alert",
    aria-invalid, aria-describedby) once a submit was attempted. *@
@typeparam TOption = string
@import { withAttributes } from "./attributes"
@import { uniqueId } from "@tsazor/ui"
@import { hasSubmitAttempt, optionAtValue, selectedOptionIndex } from "@tsazor/ui/kit"

@inherits InputBase<string>

<div class="@this.wrapperClass">
    @if (this.label) {
        <label class="fui-input__label" for="@this.elementId">@this.label</label>
    }
    <select @ref="element" id="@this.elementId" value="@this.selectValue" @attributes="@this.inputAttributes" @onmousedown:preventDefault="@this.readOnly" @onkeydown="this.keepValue" @onchange="this.handleChange">
        @if (this.items !== undefined) {
            @if (this.placeholder !== undefined || this.selectedIndex < 0) {
                @* Without a placeholder the empty choice only shows that nothing is chosen yet: it can't be picked again. *@
                <option value="" disabled="@(this.placeholder === undefined)" hidden="@(this.placeholder === undefined)">@(this.placeholder ?? "")</option>
            }
            @for (let i = 0; i < this.items.length; i++) {
                <option value="@String(i)" disabled="@(this.optionDisabled?.(this.items[i]!) === true)">@this.optionText(this.items[i]!)</option>
            }
        } else {
            @childContent
        }
    </select>
    @if (this.help) {
        <span class="fui-input__help" id="@this.helpId">@this.help</span>
    }
    @if (this.message) {
        <span class="fui-input__message" role="alert" id="@this.messageId">@this.message</span>
    }
</div>

@code {
    /** The typed options (FluentSelect's `Items`); with them the select binds `selectedOption`, not `value`. */
    @Parameter() items?: TOption[];
    /** An option's text (FluentSelect's `OptionText`). */
    @Parameter() optionText: (option: TOption) => string = (option) => String(option);
    /** What makes two options the same, for an option that is an equal copy (by default its text). */
    @Parameter() optionKey?: (option: TOption) => unknown;
    /** Whether an option can't be chosen (FluentSelect's `OptionDisabled`). */
    @Parameter() optionDisabled?: (option: TOption) => boolean;
    /** The chosen option, with `items` (bind with `@bind-selectedOption`). */
    @Parameter() selectedOption?: TOption | null;
    /** Raised with the option the user chose (null for the placeholder's empty choice). */
    @Parameter() selectedOptionChanged?: EventCallback<TOption>;
    /** The bound field in a form (`@bind-selectedOption` passes it), as an input's ValueExpression. */
    @Parameter() selectedOptionExpression?: string;
    /** An empty first choice with this text, which chooses null: only for options whose type takes null (`T | null`). */
    @Parameter() placeholder?: null extends TOption ? string : "a placeholder chooses null: give options whose type takes it (TOption=\"T | null\")";
    /** Optional field label. */
    @Parameter() label?: string;
    /** A hint below the field, linked to it for screen readers. */
    @Parameter() help?: string;
    /** true disables the native select. */
    @Parameter() disabled: boolean = false;
    /** true shows the choice without letting it change: the list says aria-readonly and doesn't open, the keys pick nothing (MudBlazor's and Fluent UI Blazor's `ReadOnly`). */
    @Parameter() readOnly: boolean = false;
    /** true sets the native required attribute. */
    @Parameter() required: boolean = false;
    /** Element id; generated automatically when omitted (label `for` / `aria-describedby`). */
    @Parameter() id?: string;
    /** Overrides the select's accessible name. */
    @Parameter() ariaLabel?: string;
    /** Option elements rendered inside the select (the string way). */
    @Parameter() childContent?: RenderFragment;

    private generatedId?: string;

    private get elementId(): string {
        return this.id ?? (this.generatedId ??= uniqueId("fui-select"));
    }

    private get labelFor(): string {
        return this.elementId;
    }

    /** The chosen option's place in `items`, or -1. */
    private get selectedIndex(): number {
        return this.items === undefined ? -1 : selectedOptionIndex(this.items, this.selectedOption, this.optionKey ?? this.optionText);
    }

    /** The native select's value: the string, or the chosen option's index ("" for none). */
    private get selectValue(): string {
        if (this.items === undefined) return this.currentValue ?? "";
        const index = this.selectedIndex;
        return index < 0 ? "" : String(index);
    }

    /** The bound field: the value's, or with `items` the chosen option's. */
    private get fieldExpression(): string | undefined {
        return this.items === undefined ? this.valueExpression : this.selectedOptionExpression;
    }

    private get validityClass(): string {
        const field = this.fieldExpression;
        return field !== undefined && this.editContext ? this.editContext.fieldCssClass(field) : "";
    }

    private get wrapperClass(): string {
        const base = "fui-input-wrapper fui-select-wrapper";
        if (this.validityClass.includes("invalid")) return `${base} fui-input-wrapper--invalid`;
        if (this.validityClass) return `${base} fui-input-wrapper--valid`;
        return base;
    }

    private get inputAttributes(): Record<string, unknown> {
        return withAttributes({
            class: "fui-input fui-select",
            disabled: this.disabled ? true : undefined,
            "aria-readonly": this.readOnly ? "true" : undefined,
            required: this.required ? true : undefined,
            "aria-label": this.ariaLabel,
            "aria-invalid": this.message ? "true" : undefined,
            "aria-describedby": this.describedBy,
        }, this.additionalAttributes);
    }

    private get helpId(): string {
        return `${this.elementId}-help`;
    }

    /** The help text and (once shown) the message describe the field. */
    private get describedBy(): string | undefined {
        const ids = [this.help ? this.helpId : null, this.message ? this.messageId : null].filter((id): id is string => id !== null);
        return ids.length > 0 ? ids.join(" ") : undefined;
    }

    private get messageId(): string {
        return `${this.elementId}-message`;
    }

    /** The message row only shows once a submit was attempted (role="alert" stays submit-bound). */
    private get message(): string {
        const field = this.fieldExpression;
        if (!hasSubmitAttempt(this.editContext) || !this.editContext || field === undefined) return "";
        return this.editContext.getValidationMessages(field)[0] ?? "";
    }

    private handleChange(e: Event): void {
        const select = e.target as HTMLSelectElement;
        if (this.readOnly) {
            select.value = this.selectValue;
            return;
        }
        if (this.items === undefined) {
            this.currentValue = select.value as never;
            return;
        }
        // The option itself, typed; "" is the placeholder's null.
        const option = optionAtValue(this.items, select.value) as TOption;
        this.selectedOption = option;
        void this.selectedOptionChanged?.invokeAsync(option);
        if (this.selectedOptionExpression && this.editContext) this.editContext.notifyFieldChanged(this.selectedOptionExpression, option);
    }

    /** readOnly: a key that would change the value does nothing; Tab, Escape and the browser's shortcuts still work. */
    private keepValue(e: KeyboardEvent): void {
        if (!this.readOnly || e.key === "Tab" || e.key === "Escape" || ((e.ctrlKey || e.metaKey) && !e.key.startsWith("Arrow"))) return;
        e.preventDefault();
    }
}
