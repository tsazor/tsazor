@** A Fluent UI 2 dropdown (native select, InputBase; bind it with @bind) for a string value, with
    an optional label; the options come from child content. Inside a FluentForm it shows the field's
    first validation message (role="alert", aria-invalid, aria-describedby) once a submit was
    attempted. *@
@import { withAttributes } from "./attributes"
@import { uniqueId } from "@tsazor/ui"
@import { hasSubmitAttempt } from "@tsazor/ui/kit"

@inherits InputBase<string>

<div class="@this.wrapperClass">
    @if (this.label) {
        <label class="fui-input__label" for="@this.elementId">@this.label</label>
    }
    <select @ref="element" id="@this.elementId" value="@this.currentValue" @attributes="@this.inputAttributes" @onmousedown:preventDefault="@this.readOnly" @onkeydown="this.keepValue" @onchange="this.handleChange">@childContent</select>
    @if (this.help) {
        <span class="fui-input__help" id="@this.helpId">@this.help</span>
    }
    @if (this.message) {
        <span class="fui-input__message" role="alert" id="@this.messageId">@this.message</span>
    }
</div>

@code {
    /** Optional field label. */
    @Parameter() label?: string;
    /** A hint below the field, linked to it for screen readers. */
    @Parameter() help?: string;
    /** true disables the native select. */
    @Parameter() disabled: boolean = false;
    /** true shows the choice without letting it change: the list says aria-readonly and doesn't open, the keys pick nothing (MudBlazor's and Fluent UI Blazor's `ReadOnly`). */
    @Parameter() readOnly: boolean = false;
    /** true sets the native required attribute. */
    @Parameter() required: boolean = false;
    /** Element id; generated automatically when omitted (label `for` / `aria-describedby`). */
    @Parameter() id?: string;
    /** Overrides the select's accessible name. */
    @Parameter() ariaLabel?: string;
    /** Option elements rendered inside the select. */
    @Parameter() childContent?: RenderFragment;

    private generatedId?: string;

    private get elementId(): string {
        return this.id ?? (this.generatedId ??= uniqueId("fui-select"));
    }

    private get labelFor(): string {
        return this.elementId;
    }

    private get wrapperClass(): string {
        const base = "fui-input-wrapper fui-select-wrapper";
        if (this.fieldClass.includes("invalid")) return `${base} fui-input-wrapper--invalid`;
        if (this.fieldClass) return `${base} fui-input-wrapper--valid`;
        return base;
    }

    private get inputAttributes(): Record<string, unknown> {
        return withAttributes({
            class: "fui-input fui-select",
            disabled: this.disabled ? true : undefined,
            "aria-readonly": this.readOnly ? "true" : undefined,
            required: this.required ? true : undefined,
            "aria-label": this.ariaLabel,
            "aria-invalid": this.message ? "true" : undefined,
            "aria-describedby": this.describedBy,
        }, this.additionalAttributes);
    }

    private get helpId(): string {
        return `${this.elementId}-help`;
    }

    /** The help text and (once shown) the message describe the field. */
    private get describedBy(): string | undefined {
        const ids = [this.help ? this.helpId : null, this.message ? this.messageId : null].filter((id): id is string => id !== null);
        return ids.length > 0 ? ids.join(" ") : undefined;
    }

    private get messageId(): string {
        return `${this.elementId}-message`;
    }

    /** The message row only shows once a submit was attempted (role="alert" stays submit-bound). */
    private get message(): string {
        if (!hasSubmitAttempt(this.editContext)) return "";
        if (!this.editContext || !this.valueExpression) return "";
        const messages = this.editContext.getValidationMessages(this.valueExpression);
        return messages[0] ?? "";
    }

    private handleChange(e: Event): void {
        if (this.readOnly) {
            (e.target as HTMLSelectElement).value = this.currentValue ?? "";
            return;
        }
        this.currentValue = (e.target as HTMLSelectElement).value as never;
    }

    /** readOnly: a key that would change the value does nothing; Tab, Escape and the browser's shortcuts still work. */
    private keepValue(e: KeyboardEvent): void {
        if (!this.readOnly || e.key === "Tab" || e.key === "Escape" || ((e.ctrlKey || e.metaKey) && !e.key.startsWith("Arrow"))) return;
        e.preventDefault();
    }
}