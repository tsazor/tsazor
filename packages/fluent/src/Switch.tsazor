@** A Fluent UI 2 toggle switch for a boolean value: a native checkbox with role="switch"
    (InputBase; bind it with @bind) inside a clickable label, with an optional help text. Inside a FluentForm it shows
    the field's first validation message (role="alert", aria-describedby) once a submit was attempted, as a Checkbox
    does (and the Bootstrap skin's Switch); aria-invalid as soon as it shows invalid. *@
@import { withAttributes } from "./attributes"
@import { uniqueId } from "@tsazor/ui"
@import { hasSubmitAttempt } from "@tsazor/ui/kit"

@inherits InputBase<boolean>

<label class="@this.wrapperClass" for="@this.elementId">
    <input @ref="element" id="@this.elementId" type="checkbox" checked="@this.isChecked" role="switch" @attributes="@this.inputAttributes" @onclick:preventDefault="@this.readOnly" @onchange="this.handleChange" />
    <span class="fui-switch__track" aria-hidden="true"></span>
    @if (this.label) {
        <span class="fui-switch__label">@this.label</span>
    }
</label>
@if (this.help) {
    <span class="fui-input__help" id="@this.helpId">@this.help</span>
}
@if (this.message) {
    <span class="fui-input__message fui-switch__message" role="alert" id="@this.messageId">@this.message</span>
}

@code {
    /** Label rendered to the right of the switch. */
    @Parameter() label?: string;
    /** A hint below the switch, linked to it for screen readers. */
    @Parameter() help?: string;
    /** true disables the native checkbox and dims the switch. */
    @Parameter() disabled: boolean = false;
    /** true shows the state without letting it change: the switch stays focusable and says aria-readonly, a click or Space changes nothing (MudBlazor's and Fluent UI Blazor's `ReadOnly`). */
    @Parameter() readOnly: boolean = false;
    /** Element id; generated automatically when omitted (label `for` association). */
    @Parameter() id?: string;
    /** Overrides the accessible name (when unlabelled). */
    @Parameter() ariaLabel?: string;

    private generatedId?: string;

    private get elementId(): string {
        return this.id ?? (this.generatedId ??= uniqueId("fui-switch"));
    }

    private get isChecked(): boolean {
        return this.currentValue === true;
    }

    private get wrapperClass(): string {
        return this.disabled ? "fui-switch fui-switch--disabled" : "fui-switch";
    }

    private get inputAttributes(): Record<string, unknown> {
        return withAttributes({
            class: "fui-switch__native",
            disabled: this.disabled ? true : undefined,
            "aria-readonly": this.readOnly ? "true" : undefined,
            "aria-label": this.ariaLabel,
            "aria-invalid": this.fieldClass.includes("invalid") ? "true" : undefined,
            "aria-describedby": this.describedBy,
        }, this.additionalAttributes);
    }

    private get helpId(): string {
        return `${this.elementId}-help`;
    }

    /** The help text and (once shown) the message describe the switch. */
    private get describedBy(): string | undefined {
        const ids = [this.help ? this.helpId : null, this.message ? this.messageId : null].filter((id): id is string => id !== null);
        return ids.length > 0 ? ids.join(" ") : undefined;
    }

    private get messageId(): string {
        return `${this.elementId}-message`;
    }

    /** The message row only shows once a submit was attempted (role="alert" stays submit-bound). */
    private get message(): string {
        if (!hasSubmitAttempt(this.editContext)) return "";
        if (!this.editContext || !this.valueExpression) return "";
        return this.editContext.getValidationMessages(this.valueExpression)[0] ?? "";
    }

    private handleChange(e: Event): void {
        this.currentValue = (e.target as HTMLInputElement).checked as never;
    }
}