@inherits InputBase<string>
<div class="@this.wrapperClass">
    @if (this.label) {
        <label class="fui-input__label" for="@this.labelFor">@this.label</label>
    }
    <textarea id="@this.id" rows="@this.rows" value="@this.displayValue" @attributes="@this.inputAttributes" @onchange="this.handleChange"></textarea>
    @if (this.message) {
        <span class="fui-input__message" role="alert" id="@this.messageId">@this.message</span>
    }
</div>

@code {
    /** Optional field label. */
    @Parameter() label?: string;
    /** Placeholder text. */
    @Parameter() placeholder?: string;
    /** Visible line count (native rows attribute, defaults 3). */
    @Parameter() rows: number = 3;
    @Parameter() disabled: boolean = false;
    @Parameter() required: boolean = false;
    /** Element id; needed for a `<label for>` association. */
    @Parameter() id?: string;
    /** Overrides the textarea's accessible name. */
    @Parameter() ariaLabel?: string;

    private get labelFor(): string | null {
        return this.id ?? null;
    }

    private get displayValue(): string {
        return this.currentValue ?? "";
    }

    private get wrapperClass(): string {
        const base = "fui-input-wrapper fui-textarea-wrapper";
        if (this.fieldClass.includes("invalid")) return `${base} fui-input-wrapper--invalid`;
        if (this.fieldClass) return `${base} fui-input-wrapper--valid`;
        return base;
    }

    private get inputAttributes(): Record<string, unknown> {
        const attrs: Record<string, unknown> = { class: this.inputClass };
        if (this.placeholder) attrs.placeholder = this.placeholder;
        if (this.disabled) attrs.disabled = true;
        if (this.required) attrs.required = true;
        if (this.ariaLabel) attrs["aria-label"] = this.ariaLabel;
        if (this.message) attrs["aria-describedby"] = this.messageId;
        for (const [name, value] of Object.entries(this.additionalAttributes ?? {})) {
            if (name === "class") continue;
            attrs[name] = value;
        }
        return attrs;
    }

    private get inputClass(): string {
        const base = "fui-input fui-textarea";
        if (this.fieldClass.includes("invalid")) return `${base} fui-input--invalid`;
        if (this.fieldClass) return `${base} fui-input--valid`;
        return base;
    }

    private get messageId(): string | null {
        return this.id ? `${this.id}-message` : `fui-textarea-message`;
    }

    private get message(): string {
        if (!this.editContext || !this.ValueExpression) return "";
        const messages = this.editContext.getValidationMessages(this.ValueExpression);
        return messages[0] ?? "";
    }

    private handleChange(e: Event): void {
        this.currentValue = (e.target as HTMLTextAreaElement).value;
    }
}