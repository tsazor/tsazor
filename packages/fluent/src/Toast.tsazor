@** A single Fluent UI 2 toast: optional title, message and Close button, announced politely
    (role="alert" for intent danger, otherwise role="status"). App-wide toasts go through the
    `Toaster` service and a ToastRegion; this one is for placing a toast yourself. *@
@import type { Intent } from "@tsazor/ui"
@import { withAttributes } from "./attributes"
@import { statusColor } from "./vocabulary"

<div @attributes="@this.toastAttributes">
    <div class="fui-toast__content">
        @if (this.title) {
            <div class="fui-toast__title">@this.title</div>
        }
        @if (this.childContent) {
            <div class="fui-toast__message">@this.childContent</div>
        }
    </div>
    @if (this.dismissible) {
        <button type="button" class="fui-toast__close" aria-label="Close" @onclick="this.close">&times;</button>
    }
</div>

@code {
    /** The status: info (default), success, warning, danger or neutral. */
    @Parameter() intent: Intent = "info";
    /** Optional headline. */
    @Parameter() title?: string;
    /** Message body. */
    @Parameter() childContent?: RenderFragment;
    /** Shows the close button. */
    @Parameter() dismissible: boolean = true;
    /** `@attributes` pass-through (class appends; see src/attributes.ts). */
    @Parameter({ captureUnmatchedValues: true }) additionalAttributes?: Record<string, unknown>;
    /** Fired when the user closes the toast. */
    @Parameter() onDismissed?: EventCallback<MouseEvent>;

    /** role=alert for danger (assertive), otherwise status. */
    private get liveRole(): string {
        return this.intent === "danger" ? "alert" : "status";
    }

    private get toastClass(): string {
        return `fui-toast fui-toast--${statusColor(this.intent)}`;
    }

    private get toastAttributes(): Record<string, unknown> {
        return withAttributes({
            class: this.toastClass,
            role: this.liveRole,
            "aria-live": "polite",
            "aria-atomic": "true",
        }, this.additionalAttributes);
    }

    private close(e: MouseEvent): void {
        this.onDismissed?.invokeAsync(e);
    }
}