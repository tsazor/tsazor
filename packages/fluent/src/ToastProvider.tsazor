@import { withAttributes } from "./attributes"

<div @attributes="@this.regionAttributes">
    @for (let i = 0; i < this.items.length; i++) {
        <Toast severity="@this.items[i]!.severity" title="@this.items[i]!.title" childContent="@this.items[i]!.message" onDismissed="@(() => this.dismiss(this.items[i]!.id))" />
    }
    @this.childContent
</div>

@code {
    /** Toast consumers (resolve the FluentToasts cascade). */
    @Parameter() childContent?: RenderFragment;
    /** Region position: bottom-right (default) or top-right. */
    @Parameter() position: "bottom-right" | "top-right" = "bottom-right";
    /** `@attributes` pass-through (class appends; see src/attributes.ts). */
    @Parameter({ captureUnmatchedValues: true }) additionalAttributes?: Record<string, unknown>;

    readonly isCascadingValueSupplier = true;
    /** The toast list changes as toasts show and expire. */
    readonly isFixed = false;
    /** ToastProvider cascades itself so children can call show() without an import cycle. */
    readonly cascadeName = "FluentToasts";
    get cascadeValue(): unknown {
        return this;
    }

    private items: { id: number; title?: string; message?: string; severity: string; timer?: ReturnType<typeof setTimeout> }[] = [];

    /** The positioned stack keeps one class hook for the region. */
    private get regionClass(): string {
        return this.position === "top-right" ? "fui-toasts fui-toasts--top" : "fui-toasts";
    }

    private get regionAttributes(): Record<string, unknown> {
        return withAttributes({
            class: this.regionClass,
            "aria-live": "polite",
        }, this.additionalAttributes);
    }

    private nextId = 0;

    /** Shows a toast; auto-dismisses after `timeout` ms (0 = sticky). */
    show(options: { title?: string; message?: string; severity?: "info" | "success" | "warning" | "error"; timeout?: number }): number {
        const id = this.nextId;
        this.nextId = id + 1;
        const timeout = options.timeout ?? 4000;
        const timer = timeout > 0
            ? setTimeout(() => this.dismiss(id), timeout)
            : undefined;
        this.items.push({
            id,
            title: options.title,
            message: options.message,
            severity: options.severity ?? "info",
            timer,
        });
        this.stateHasChangedInternal();
        return id;
    }

    /** Removes one toast (button or expiry). */
    dismiss(id: number): void {
        const item = this.items.find((t) => t.id === id);
        if (item?.timer) clearTimeout(item.timer);
        if (!this.items.some((t) => t.id === id)) return;
        this.items = this.items.filter((t) => t.id !== id);
        this.stateHasChangedInternal();
    }
}