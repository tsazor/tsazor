@** Shows the app's toasts (the `Toaster` service from @tsazor/ui) as Fluent UI 2 toasts in a corner of
    the page. Place it once, in the layout; any component then injects `Toaster` and calls
    `show({ title, message, intent, action })`. Toasts close themselves after their timeout, pause while the
    pointer is over them or focus is in them (WCAG 2.2.1), and can be closed with their button. The
    region is a polite live region; `danger` toasts are announced as alerts. *@
@import { Toaster, hideFromTopLayer, raiseInTopLayer, type Toast } from "@tsazor/ui"
@import { withAttributes } from "./attributes"
@import { buttonClasses, statusColor } from "./vocabulary"
@import { Dismiss20Regular } from "./core-icons"
@import { libraryTexts } from "@tsazor/ui"
@inject Toaster toaster

<div @attributes="@this.regionAttributes" @attach="this.topLayer">
    @foreach (const toast of toaster.toasts) {
        <div @key="toast.id" class="@toastClass(toast)" role="@roleOf(toast)" aria-atomic="true"
             @onmouseenter="() => toaster.pause(toast.id)" @onmouseleave="() => toaster.resume(toast.id)"
             @onfocusin="() => toaster.pause(toast.id)" @onfocusout="() => toaster.resume(toast.id)">
            <div class="fui-toast__content">
                @if (toast.title) {
                    <div class="fui-toast__title">@toast.title</div>
                }
                @if (toast.message) {
                    <div class="fui-toast__message">@toast.message</div>
                }
            </div>
            @if (toast.action) {
                <button type="button" class="@actionClass" @onclick="() => toaster.actAsync(toast.id)">@toast.action.label</button>
            }
            <button type="button" class="fui-toast__close" aria-label="@t("close")" @onclick="() => toaster.dismiss(toast.id)"><Icon value="@Dismiss20Regular" size="16" /></button>
        </div>
    }
</div>

@code {
    private readonly t = libraryTexts();

    /** The corner the toasts appear in. */
    @Parameter() position: "top-start" | "top-end" | "bottom-start" | "bottom-end" = "bottom-end";
    /** `@attributes` pass-through (class appends; see src/attributes.ts). */
    @Parameter({ captureUnmatchedValues: true }) additionalAttributes?: Record<string, unknown>;

    protected override onInitialized(): void {
        this.observe(this.toaster);
    }

    private region?: HTMLElement;
    private raisedSince = 0;
    private newestToast?: number;

    /** The region lies in the browser's top layer, so a toast shows above an open dialog, as Fluent UI's. */
    private readonly topLayer = (element: HTMLElement): (() => void) => {
        this.region = element;
        this.raisedSince = raiseInTopLayer(element, 0);
        return () => {
            hideFromTopLayer(element);
            this.region = undefined;
        };
    };

    /** A new toast after an overlay opened: the region shows itself on top of the top layer again. */
    protected override onAfterRender(): void {
        const newest = this.toaster.toasts.at(-1)?.id;
        if (this.region && newest !== undefined && newest !== this.newestToast) this.raisedSince = raiseInTopLayer(this.region, this.raisedSince);
        this.newestToast = newest;
    }

    private get regionAttributes(): Record<string, unknown> {
        const [vertical, horizontal] = this.position.split("-");
        const classes = ["fui-toasts"];
        if (vertical === "top") classes.push("fui-toasts--top");
        if (horizontal === "start") classes.push("fui-toasts--start");
        return withAttributes({ class: classes.join(" "), "aria-live": "polite" }, this.additionalAttributes);
    }

    /** A toast's action: a transparent brand button, as Fluent's toast actions are links in the brand color. */
    private readonly actionClass = `${buttonClasses("primary", "transparent", "small")} fui-toast__action`;

    private toastClass(toast: Toast): string {
        return `fui-toast fui-toast--${statusColor(toast.intent)}`;
    }

    private roleOf(toast: Toast): string | null {
        return toast.intent === "danger" ? "alert" : null;
    }
}
