@import { withAttributes } from "./attributes"

@if (this.variant === "h1") { <h1 @attributes="@this.textAttributes">@childContent</h1> }
else if (this.variant === "h2") { <h2 @attributes="@this.textAttributes">@childContent</h2> }
else if (this.variant === "h3") { <h3 @attributes="@this.textAttributes">@childContent</h3> }
else if (this.variant === "h4") { <h4 @attributes="@this.textAttributes">@childContent</h4> }
else if (this.variant === "h5") { <h5 @attributes="@this.textAttributes">@childContent</h5> }
else if (this.variant === "caption") { <span @attributes="@this.textAttributes">@childContent</span> }
else { <p @attributes="@this.textAttributes">@childContent</p> }

@code {
    /** Semantic variant: h1 | h2 | h3 | h4 | h5 | body (default) | caption — also picks the element tag. */
    @Parameter() variant: "h1" | "h2" | "h3" | "h4" | "h5" | "body" | "caption" = "body";
    /** Optional weight alias: semibold | bold. */
    @Parameter() weight?: "semibold" | "bold";
    /** `@attributes` pass-through (class appends; see src/attributes.ts). */
    @Parameter({ captureUnmatchedValues: true }) additionalAttributes?: Record<string, unknown>;
    @Parameter() childContent?: RenderFragment;

    private get textClass(): string {
        return `fui-typography fui-typography--${this.variant}`;
    }

    private get textAttributes(): Record<string, unknown> {
        return withAttributes({
            class: this.textClass,
            style: this.textStyle,
        }, this.additionalAttributes);
    }

    /** Overridable weight through the token weights; size/ramp live in the sidecar. */
    private get textStyle(): string | null {
        return this.weight ? `font-weight: var(--fui-font-weight-${this.weight})` : null;
    }
}