@** A step's bullet, label and summary in a Wizard's step list. Internal to Wizard. *@
@import { libraryTexts, type IconValue } from "@tsazor/ui"

<span class="fui-wizard__bullet" aria-hidden="true">
    <Icon value="@icon" size="24" />
    @if (number !== null) {
        <span class="fui-wizard__number">@number</span>
    }
</span>
<span class="fui-wizard__labels">
    <span class="fui-wizard__label">@label</span>
    @if (completed) {
        <span class="fui-visually-hidden">, @t("wizard.completed")</span>
    }
    @if (summary) {
        <span class="fui-wizard__summary">@summary</span>
    }
</span>

@code {
    private readonly t = libraryTexts();

    @Parameter() icon!: IconValue;
    /** A done step (before the current one): its check mark says so to the eye, this text to a screen reader. */
    @Parameter() completed = false;
    @Parameter() number: number | null = null;
    @Parameter() label = "";
    @Parameter() summary = "";
}
