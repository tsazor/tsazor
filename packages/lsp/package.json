{
  "name": "@tsazor/lsp",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "Language server for Tsazor (.tsazor): live compiler diagnostics, hover and go-to-definition.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@tsazor/compiler": "workspace:*",
    "@tsazor/workspace": "workspace:*",
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "vscode-languageserver-textdocument": "^1.0.12",
    "vitest": "^3.2.4",
    "vscode-languageserver": "^9.0.1"
  }
}
