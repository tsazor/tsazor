{
  "name": "@tsazor/testing",
  "version": "1.0.0-next.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tsazor/tsazor.git",
    "directory": "packages/testing"
  },
  "homepage": "https://github.com/tsazor/tsazor/tree/main/packages/testing#readme",
  "bugs": {
    "url": "https://github.com/tsazor/tsazor/issues"
  },
  "type": "module",
  "description": "Test helpers for Tsazor components: render() over happy-dom.",
  "main": "./dist/index.js",
