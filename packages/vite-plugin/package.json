{
  "name": "@tsazor/vite-plugin",
  "version": "0.1.0",
  "type": "module",
  "description": "Vite plugin for Tsazor (.tsazor): compile, route manifest, HMR.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b && esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --external:vite --external:esbuild --external:postcss --external:typescript",
    "test": "vitest run"
  },
  "dependencies": {
    "@jridgewell/gen-mapping": "^0.3.8",
    "@jridgewell/trace-mapping": "^0.3.25",
    "@tsazor/compiler": "workspace:*",
    "@tsazor/workspace": "workspace:*",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.6",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "vite": "^5.0.0 || ^6.0.0 || ^7.0.0"
  },
  "devDependencies": {
    "vite": "^7.1.7",
    "vitest": "^3.2.7"
  }
}