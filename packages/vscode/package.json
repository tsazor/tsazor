{
  "name": "tsazor-vscode",
  "displayName": "Tsazor Language Support",
  "description": "Syntax highlighting and language services (diagnostics, hover, go-to-definition) for Tsazor (.tsazor) files — Razor markup with TypeScript.",
  "version": "0.4.0",
  "publisher": "tsazor",
  "main": "./dist/extension.js",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "tsazor",
        "aliases": [
          "Tsazor",
          "tsazor"
        ],
        "extensions": [
          ".tsazor"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "tsazor",
        "scopeName": "source.tsazor",
        "path": "./syntaxes/tsazor.tmLanguage.json",
        "embeddedLanguages": {
          "source.ts": "typescript",
          "meta.embedded.block.tsazor-code.ts": "typescript"
        }
      }
    ]
  },
  "scripts": {
    "build": "node build.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "vscode-languageclient": "^9.0.1"
  }
}