{
  "name": "@tasor/workspace",
  "version": "0.1.0",
  "type": "module",
  "description": "Shared .tazor workspace resolution: _Imports chains, component/type resolution, runtime built-ins. Used by the Vite plugin and the language server.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@tasor/compiler": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}