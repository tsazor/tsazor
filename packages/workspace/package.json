{
  "name": "@tsazor/workspace",
  "version": "1.0.0-next.4",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tsazor/tsazor.git",
    "directory": "packages/workspace"
  },
  "homepage": "https://github.com/tsazor/tsazor/tree/main/packages/workspace#readme",
  "bugs": {
    "url": "https://github.com/tsazor/tsazor/issues"
  },
  "type": "module",
  "description": "Shared .tsazor workspace resolution: _Imports chains, component/type resolution, runtime built-ins. Used by the Vite plugin and the language server.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./builtins": {
      "types": "./dist/builtins.d.ts",
      "default": "./dist/builtins.js"
    }
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@tsazor/compiler": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "tsazor": {
    "internal": true
  }
}
